---
import ContentPage from "../components/ContentPage.astro";
import type { Page } from "../lib/content";
import "../styles/global.css";

export function getStaticPaths() {
  return ["features", "how-to", "screenshots", "reviews", "faq", "privacy", "terms", "news", "updates"].map((page) => ({
    params: { page },
  }));
}

const { page } = Astro.params as { page: Page };
---

<ContentPage lang="en" page={page} />
