---
import AppScreen from "./AppScreen.astro";

const { lang } = Astro.props as { lang: "ja" | "en" };
const ja = lang === "ja";
const notes = ja
  ? [["01", "夜にも読みやすく", "深い緑とクリーム色のカードで、コントラストを保ちながら眩しさを抑えています。"], ["02", "迷わない操作", "画面下部の操作を4つに絞り、片手でも次の一手に戻りやすくしています。"], ["03", "自分のペース", "アンドゥ、統計、触覚やサウンドの設定で、急かされない遊び方を選べます。"]]
  : [["01", "Easy on evening eyes", "Deep green and cream cards keep contrast clear without feeling glaring."], ["02", "Controls that stay out of the way", "Four actions sit at the bottom so the next move remains easy to find in one hand."], ["03", "Your own pace", "Undo, stats, haptics and sound controls let the game remain unhurried."]];
---

<div class="quiet-notes-page">
  <header class="quiet-notes-hero">
    <div>
      <p class="content-eyebrow">BEFORE THE FIRST REVIEW</p>
      <h1>{ja ? "まだレビューはありません。だから、いま伝えられることを。" : "No reviews yet. Here is what we can honestly share."}</h1>
      <p>{ja ? "Quiet Solitaireは現在App Store公開準備中です。存在しない声を飾る代わりに、実際の画面と設計で目指している体験をご紹介します。" : "Quiet Solitaire is preparing for the App Store. Instead of dressing up voices that do not exist yet, this page shares the real screen and the experience it is designed to create."}</p>
    </div>
    <AppScreen lang={lang} size="lg" class="quiet-notes-phone" />
  </header>
  <section class="quiet-notes-grid">
    {notes.map(([n, title, body]) => <article data-reveal><b>{n}</b><h2>{title}</h2><p>{body}</p></article>)}
  </section>
  <aside class="quiet-notes-status" data-reveal>
    <span>STATUS / 2026</span>
    <h2>{ja ? "公開後、届いた声だけをここに載せます。" : "After launch, only genuine feedback will appear here."}</h2>
    <a href={ja ? "/ja/news" : "/news"}>{ja ? "公開状況を見る" : "Follow launch news"} →</a>
  </aside>
</div>
