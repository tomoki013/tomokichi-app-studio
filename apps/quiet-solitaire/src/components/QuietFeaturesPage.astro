---
import { features as featureList } from "../lib/content";
import AppScreen from "./AppScreen.astro";

const { lang } = Astro.props as { lang: "ja" | "en" };
const ja = lang === "ja";
const features = featureList(ja);
---

<div class="quiet-features-page">
  <header class="quiet-feature-hero">
    <div>
      <p class="content-eyebrow">FEATURES / THE REAL TABLE</p>
      <h1>{ja ? "静かに考えるための、必要十分な機能。" : "Everything needed for a quieter game."}</h1>
      <p>{ja ? "派手な演出を足すのではなく、クロンダイクに集中できること。操作、記録、利き手への配慮を一つの静かな卓にまとめました。" : "Not more spectacle—more room to focus on Klondike. Controls, records and left-handed play meet at one calm table."}</p>
    </div>
    <AppScreen lang={lang} size="xl" priority class="quiet-feature-phone" />
  </header>

  <section class="quiet-feature-list">
    {features.map(([icon, title, body], i) => (
      <article data-reveal>
        <span class="quiet-feature-number">{String(i + 1).padStart(2, "0")}</span>
        <i aria-hidden="true">{icon}</i>
        <div><h2>{title}</h2><p>{body}</p></div>
      </article>
    ))}
  </section>

  <section class="quiet-feature-principle" data-reveal>
    <p class="content-eyebrow">ON YOUR IPHONE</p>
    <h2>{ja ? "ゲームも設定も統計も、端末の中に。" : "Games, settings and stats stay on your device."}</h2>
    <p>{ja ? "アカウントは不要です。進行中のゲームを閉じても続きから再開でき、好みの静けさもそのまま保たれます。" : "No account is required. Resume an unfinished deal and keep the table tuned to your preferred level of quiet."}</p>
    <a href={ja ? "/ja/faq" : "/faq"}>{ja ? "保存と広告について確認する" : "Read about storage and ads"} →</a>
  </section>
</div>
