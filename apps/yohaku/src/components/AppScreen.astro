---
/**
 * A real Yohaku screen inside the shared device frame.
 *
 * The images are unretouched iPhone 17 Pro Max captures produced by
 * `AppStoreScreenshotTests` in the app repo and imported with
 * `scripts/import-app-screenshots.mjs`, so what the site shows is what the app
 * renders. Astro resizes them and emits WebP at build time.
 */
import { Image } from "astro:assets";
import PhoneFrame from "@tomokichi/app-site/PhoneFrame.astro";

type Screen = "today" | "today-dark" | "week" | "month" | "settings-iap" | "add" | "reflection";
type Size = "xs" | "sm" | "md" | "lg" | "xl";

const {
  screen,
  layers,
  lang,
  size = "md",
  label = "",
  priority = false,
  eager = false,
  class: className = "",
  alt: altOverride,
} = Astro.props as {
  screen?: Screen;
  /** When set, screens share one device frame and can crossfade. */
  layers?: Screen[];
  lang: "ja" | "en";
  size?: Size;
  label?: string;
  priority?: boolean;
  eager?: boolean;
  class?: string;
  alt?: string;
};

const layerList = layers?.length ? layers : screen ? [screen] : [];
if (!layerList.length) {
  throw new Error("AppScreen needs `screen` or `layers`");
}

const ja = lang === "ja";

const alts: Record<Screen, [string, string]> = {
  today: [
    "Yohakuの今日の画面。その日に置いた余白がカードで並んでいる",
    "Yohaku’s Today screen, with the day’s spaces listed as cards",
  ],
  "today-dark": [
    "Yohakuのダークモードの今日画面。その日に置いた余白がカードで並んでいる",
    "Yohaku’s Today screen in dark mode, with the day’s spaces listed as cards",
  ],
  week: [
    "Yohakuの週の画面。各日の余白が黒い四角で並んでいる",
    "Yohaku’s Week screen, with each day’s spaces shown as filled squares",
  ],
  month: [
    "Yohakuの月の画面。余白のある日がカレンダー上の黒いマスになっている",
    "Yohaku’s Month screen, with days that hold a space marked on the calendar",
  ],
  "settings-iap": [
    "Yohakuの設定画面。広告を永久に削除する買い切り購入と外観・通知の設定",
    "Yohaku’s Settings screen, showing the one-time ad-removal purchase alongside appearance and notification settings",
  ],
  add: [
    "Yohakuの余白作成画面。名前の候補と日付・開始・終了時刻を選べる",
    "Yohaku’s create screen, with suggested names and date, start and end times",
  ],
  reflection: [
    "Yohakuの振り返りカード。終わった余白について一度だけ小さく尋ねる",
    "Yohaku’s check-in card, asking once about a space that has ended",
  ],
};

const screens = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*.webp", {
  eager: true,
});
const images = layerList.map((name) => {
  const key = `../assets/screens/${lang}-${name}.webp`;
  const image = screens[key]?.default;
  if (!image) {
    throw new Error(`missing screenshot: ${key} (run scripts/import-app-screenshots.mjs)`);
  }
  return { name, image };
});
const primary = images[0];
if (!primary) {
  throw new Error("AppScreen needs `screen` or `layers`");
}

// The screen is 89.6% of the device width, so this is the widest the bitmap can
// ever be laid out at — the frame only ever shrinks below its nominal size.
const screenWidth: Record<Size, number> = { xs: 118, sm: 158, md: 208, lg: 262, xl: 323 };
const stackedAlt = ja
  ? "YohakuのToday・Week・Month画面。同じ端末の中で余白の見方が移り変わる"
  : "Yohaku’s Today, Week and Month screens, changing inside the same device";
---

<PhoneFrame size={size} label={label} class={className}>
  {images.length === 1 ? (
    <Image
      src={primary.image}
      format="webp"
      widths={[240, 360, 480, 640, 960]}
      sizes={`${screenWidth[size]}px`}
      alt={altOverride ?? alts[primary.name][ja ? 0 : 1]}
      loading={priority || eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={priority ? "high" : undefined}
    />
  ) : (
    <div class="yohaku-screen-stack">
      {images.map(({ image }, index) => (
        <Image
          src={image}
          format="webp"
          widths={[240, 360, 480, 640, 960]}
          sizes={`${screenWidth[size]}px`}
          alt={index === 0 ? (altOverride ?? stackedAlt) : ""}
          loading={priority || eager ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={priority && index === 0 ? "high" : undefined}
          class={index > 0 ? "is-overlay" : undefined}
        />
      ))}
    </div>
  )}
</PhoneFrame>
