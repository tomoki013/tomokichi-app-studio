---
import AppHeroChrome from "@tomokichi/app-site/AppHeroChrome.astro";
import AppShell from "./AppShell.astro";
import PhoneMock from "./PhoneMock.astro";

const { lang } = Astro.props as { lang: "ja" | "en" };
const ja = lang === "ja";
const base = ja ? "/ja" : "";

const features = ja
  ? [
      {
        mark: "□",
        title: "余白を記録する",
        body: "予定ではなく、余白を置いた時間をそっと記録します。",
      },
      {
        mark: "□□■□□",
        title: "静かに見渡す",
        body: "日・週・月のリズムで、静かに余白を見渡せます。",
      },
      {
        mark: "▦",
        title: "かたちになる",
        body: "積み重ねた余白が、美しいパターンになります。",
      },
      {
        mark: "◌",
        title: "言葉にならない心地よさ",
        body: "アイコン中心の、シンプルでやさしいデザインです。",
      },
    ]
  : [
      {
        mark: "□",
        title: "Record the space",
        body: "Not another plan—just a quiet mark where you left room.",
      },
      {
        mark: "□□■□□",
        title: "See it calmly",
        body: "Glance across day, week and month without noise.",
      },
      {
        mark: "▦",
        title: "It takes shape",
        body: "Stacked spaces become a quiet pattern of their own.",
      },
      {
        mark: "◌",
        title: "Comfort without words",
        body: "An icon-led interface designed to stay out of the way.",
      },
    ];
---

<AppShell
  lang={lang}
  title={ja ? "余白を置く、小さな習慣を。" : "Leave room. Keep it small."}
  description={ja ? "予定ではなく、余白だけを置くiPhoneアプリYohaku。" : "Yohaku is an iPhone app for leaving room in your day, without turning it into another plan."}
>
  <section class="yohaku-hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1>{ja ? <>余白を置く、<br />小さな習慣を。</> : <>Leave room.<br />Keep it small.</>}</h1>
        <p class="hero-lead">{ja ? "予定ではなく、余白だけを。" : "Not another plan. Just space."}</p>
        <span class="hero-rule" aria-hidden="true"></span>
        <p class="hero-body">
          {ja
            ? "Yohakuは、日々の中に何も入れない時間をそっと置くためのアプリです。"
            : "Yohaku is an app for gently placing time with nothing in it into your day."}
        </p>
        <div class="hero-actions">
          <a class="store-button" href="#download">
            <svg class="store-apple" viewBox="0 0 16 20" aria-hidden="true"><path fill="currentColor" d="M13.2 10.6c0-2 1.6-3 1.7-3.1-0.9-1.3-2.4-1.5-2.9-1.5-1.2-0.1-2.4 0.7-3 0.7-0.6 0-1.6-0.7-2.6-0.7-1.3 0-2.6 0.8-3.3 2-1.4 2.5-0.4 6.1 1 8.1 0.7 1 1.5 2 2.6 2 1 0 1.4-0.7 2.7-0.7s1.6 0.7 2.7 0.7c1.1 0 1.8-1 2.5-1.9 0.8-1.1 1.1-2.2 1.1-2.3-0.0-0.0-2.1-0.8-2.1-3.2zM11.1 4.4c0.6-0.7 1-1.7 0.9-2.7-0.9 0-1.9 0.6-2.5 1.3-0.5 0.6-1 1.6-0.9 2.6 1 0.1 1.9-0.5 2.5-1.2z"/></svg>
            App Store
          </a>
          <a class="secondary-button" href={`${base}/features`}>{ja ? "詳しく見る" : "Learn more"}</a>
        </div>
      </div>

      <section class="hero-devices" aria-label={ja ? "YohakuのToday、Week、Month画面" : "Yohaku Today, Week and Month screens"}>
        <figure class="hero-device">
          <figcaption>Today</figcaption>
          <PhoneMock kind="today" size="md" />
        </figure>
        <figure class="hero-device">
          <figcaption>Week</figcaption>
          <PhoneMock kind="week" size="md" />
        </figure>
        <figure class="hero-device">
          <figcaption>Month</figcaption>
          <PhoneMock kind="month" size="md" />
        </figure>
      </section>
    </div>

    <AppHeroChrome
      lang={lang}
      date="2026-07-29"
      news={ja ? "Yohakuブランドサイトを公開しました。" : "The Yohaku brand site is now available."}
      newsHref={`${base}/updates`}
    />
  </section>

  <section class="feature-section section-pad" id="features">
    <header class="section-heading" data-reveal>
      <h2>{ja ? "Yohakuでできること" : "What Yohaku does"}</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </header>
    <div class="feature-grid">
      {features.map(({ mark, title, body }) => (
        <article data-reveal>
          <span class="feature-mark" aria-hidden="true">{mark}</span>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="story-section story-quiet section-pad" id="concept">
    <div class="story-visual" data-reveal>
      <PhoneMock kind="today" size="lg" />
    </div>
    <div class="story-copy" data-reveal>
      <h2>{ja ? "静かに整える。" : "Settle, quietly."}</h2>
      <span class="story-rule" aria-hidden="true"></span>
      <p>
        {ja
          ? "気づいたときに、余白をそっと置く。それだけで、心は少しずつ整っていきます。"
          : "When you notice the need, leave a little space. That alone can gently settle the mind."}
      </p>
    </div>
  </section>

  <section class="story-section story-shape section-pad">
    <div class="story-copy" data-reveal>
      <h2>{ja ? <>余白が、<br />かたちになる。</> : <>Space takes<br />a shape.</>}</h2>
      <span class="story-rule" aria-hidden="true"></span>
      <p>
        {ja
          ? "積み重ねた余白は、やがて美しいパターンに。自分だけのリズムが、静かに見えてきます。"
          : "The spaces you stack become a quiet pattern—your own rhythm, made visible without noise."}
      </p>
    </div>
    <div class="story-visual story-visual-shape" data-reveal>
      <PhoneMock kind="month" size="lg" />
      <div class="shape-scatter" aria-hidden="true">
        <i class="s1"></i>
        <i class="s2"></i>
        <i class="s3"></i>
        <i class="s4"></i>
        <i class="s5"></i>
        <i class="s6"></i>
      </div>
    </div>
  </section>

  <section class="download-section" id="download" data-reveal>
    <h2>{ja ? "余白を置く、小さな習慣を。" : "Leave room. Keep it small."}</h2>
    <a class="store-button" href="#download">
      <svg class="store-apple" viewBox="0 0 16 20" aria-hidden="true"><path fill="currentColor" d="M13.2 10.6c0-2 1.6-3 1.7-3.1-0.9-1.3-2.4-1.5-2.9-1.5-1.2-0.1-2.4 0.7-3 0.7-0.6 0-1.6-0.7-2.6-0.7-1.3 0-2.6 0.8-3.3 2-1.4 2.5-0.4 6.1 1 8.1 0.7 1 1.5 2 2.6 2 1 0 1.4-0.7 2.7-0.7s1.6 0.7 2.7 0.7c1.1 0 1.8-1 2.5-1.9 0.8-1.1 1.1-2.2 1.1-2.3-0.0-0.0-2.1-0.8-2.1-3.2zM11.1 4.4c0.6-0.7 1-1.7 0.9-2.7-0.9 0-1.9 0.6-2.5 1.3-0.5 0.6-1 1.6-0.9 2.6 1 0.1 1.9-0.5 2.5-1.2z"/></svg>
      App Store
    </a>
  </section>
</AppShell>
