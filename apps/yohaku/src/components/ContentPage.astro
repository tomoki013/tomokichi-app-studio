---
import { supportUrl } from "@tomokichi/app-site/urls";
import {
  descriptions,
  type Locale,
  type Page,
  pick,
  privacySections,
  termsSections,
  titles,
} from "../lib/content";
import NewsFeed from "@tomokichi/app-site/NewsFeed.astro";
import AppShell from "./AppShell.astro";
import PhoneMock from "./PhoneMock.astro";

const { lang, page } = Astro.props as { lang: Locale; page: Page };
const ja = lang === "ja";
const supportHref = supportUrl("yohaku", lang);
const title = pick(ja, titles[page]);
const description = pick(ja, descriptions[page]);
const storeLabel = ja ? "App Storeで近日公開" : "Coming soon on the App Store";

const featureBlocks = ja
  ? [
      {
        heading: "今日の余白を、名前と時間で置く。",
        body: "何もしない時間、ぼーっとする時間、ゆっくりお茶を飲む時間。名前、日付、開始時刻、終了時刻を選び、今日の中に余白を置けます。1日に複数の余白を作成でき、後から編集や削除もできます。",
        kind: "today" as const,
      },
      {
        heading: "その日の余白を、カードで見る。",
        body: "Today画面では、選択した日の余白をカードで確認できます。左右の操作やスワイプで日付を移動できます。余白の最中にタイマーや専用モードへ切り替わることはありません。",
        kind: "today" as const,
      },
      {
        heading: "一週間の余白を、小さな印で見渡す。",
        body: "Week画面では、各日に置いた余白を黒い四角で表示します。余白がない日は輪郭だけの四角です。日をタップすると、その日のToday画面を開けます。",
        kind: "week" as const,
      },
      {
        heading: "ひと月の余白を、カレンダーで振り返る。",
        body: "Month画面では、余白のある日が黒いマスとして残ります。月に置いた余白の数も確認できます。画像やアートを自動生成する機能ではありません。",
        kind: "month" as const,
      },
      {
        heading: "余白の始まりを、そっと知らせる。",
        body: "通知を有効にすると、通常は登録した開始時刻の3〜7分前にお知らせします。余白を編集・削除すると、通知も自動的に更新されます。初期状態ではオフで、最初の余白作成時に許可を確認します。",
        kind: "today" as const,
      },
      {
        heading: "終わったあとに、ひとことだけ。",
        body: "次にアプリを開いたとき、直近の余白について小さな確認カードが一度だけ表示されます。回答は任意で、閉じるか横に払っても再表示されません。回答は端末内にだけ保存されます。",
        kind: "today" as const,
      },
      {
        heading: "白と黒を、自分の環境に合わせる。",
        body: "システム、ライト、ダークの3つから外観を選べます。",
        kind: "week" as const,
      },
      {
        heading: "アカウントなしで、端末の中に。",
        body: "余白の記録は端末内に保存されます。アカウント登録やYohaku独自のクラウド同期はありません。",
        kind: "month" as const,
      },
      {
        heading: "18の言語に対応。",
        body: "英語、日本語を含む18言語に対応しています。表示言語はiPhoneの設定に従います。",
        kind: "today" as const,
      },
    ]
  : [
      {
        heading: "Leave space in your day with a name and time.",
        body: "Time for nothing, a slow cup of tea, or simply looking out the window. Choose a name, date, start time, and end time. Add more than one space in a day, then edit or remove it later.",
        kind: "today" as const,
      },
      {
        heading: "See that day’s spaces as cards.",
        body: "On Today, review the spaces for the selected day and move between dates with the controls or a swipe. Yohaku does not switch to a timer or dedicated mode while a space is in progress.",
        kind: "today" as const,
      },
      {
        heading: "Glance across a week of quiet marks.",
        body: "Week shows each day’s spaces as filled squares—outline only when empty. Tap a day to open its Today view.",
        kind: "week" as const,
      },
      {
        heading: "Look back on a month through simple marks.",
        body: "Month marks days that have at least one space, and shows how many spaces you left that month. It does not generate art or patterns from your data.",
        kind: "month" as const,
      },
      {
        heading: "A gentle notice before a space begins.",
        body: "When enabled, Yohaku normally reminds you three to seven minutes before a space. Edit or delete a space and its notification updates. Off by default; permission is requested when you create your first space.",
        kind: "today" as const,
      },
      {
        heading: "One small question afterward.",
        body: "The next time you open the app, one small card may ask about your latest space. Answer, close, or swipe it away; it will not ask again. Responses stay on your device.",
        kind: "today" as const,
      },
      {
        heading: "Match light and dark to your environment.",
        body: "Choose system, light, or dark appearance.",
        kind: "week" as const,
      },
      {
        heading: "No account—on your device.",
        body: "Spaces stay on your iPhone. There is no Yohaku account or cloud sync.",
        kind: "month" as const,
      },
      {
        heading: "Eighteen languages.",
        body: "Including English and Japanese. The display language follows your iPhone settings.",
        kind: "today" as const,
      },
    ];

const howSteps = ja
  ? [
      { n: "1", title: "Today画面で＋をタップ", body: "Today画面右下の＋ボタンから、新しい余白を作成します。" },
      { n: "2", title: "名前と時間を決める", body: "余白の名前、日付、開始時刻、終了時刻を入力します。名前の候補から選ぶこともできます。1日に複数の余白を置けます。" },
      { n: "3", title: "今日・週・月で見渡す", body: "Todayでは詳しい時間、Weekでは一週間の数、Monthでは余白のある日と月間件数を確認できます。" },
      { n: "4", title: "必要に応じて編集する", body: "余白のカードをタップすると、名前や時間を変更できます。必要がなくなった余白は削除できます。" },
      { n: "5", title: "通知を使う", body: "通知を許可すると、余白が始まる少し前にお知らせします。通知は設定画面からいつでも変更できます。" },
      { n: "6", title: "必要なら振り返る", body: "余白が終わったあとに小さな確認が一度だけ表示されます。答えず閉じてもかまいません。" },
    ]
  : [
      { n: "1", title: "Tap + on Today", body: "Create a new space from the + button at the bottom-right of Today." },
      { n: "2", title: "Choose a name and times", body: "Enter a name, date, start time and end time—or pick a suggested name. You can add more than one space in a day." },
      { n: "3", title: "Review day, week and month", body: "Today shows times in detail; Week shows counts; Month shows marked days and a monthly total." },
      { n: "4", title: "Edit when needed", body: "Tap a card to change the name or times. Remove a space when you no longer need it." },
      { n: "5", title: "Use notifications", body: "With permission, you’ll be notified shortly before each space. Change this anytime in Settings." },
      { n: "6", title: "Reflect only if you want", body: "After a space, one small check-in may appear once. You can answer it or simply dismiss it." },
    ];

const conceptIdeas = ja
  ? [
      { title: "予定を増やさない", body: "Yohakuはイベント管理ではありません。すでにある予定のあいだに、何も入れない時間を残すための道具です。" },
      { title: "小さく始める", body: "完璧なルーティンは要りません。気づいたときに、ひとつ余白を置くだけで十分です。" },
      { title: "静かに振り返る", body: "日々の余白が並ぶことで、自分の時間のリズムが少しずつ見えてきます。" },
    ]
  : [
      { title: "Not another calendar", body: "Yohaku does not manage events. It leaves room with nothing planned between the things you already have." },
      { title: "Start small", body: "No perfect routine required. One space, when you notice the need, is enough." },
      { title: "Look back quietly", body: "As days with space accumulate, the rhythm of your time becomes a little clearer." },
    ];

const faqs = ja
  ? [
      ["base", "Yohakuは何をするアプリですか？", "Yohakuは、何もしない時間やゆっくり過ごしたい時間を、名前と時間で置いておくアプリです。作成した余白は、今日・週・月の画面で振り返れます。"],
      ["base", "カレンダーやタスク管理アプリですか？", "いいえ。予定やタスクを管理するためのアプリではありません。すでにある予定のあいだに、何も入れない時間を残すためのアプリです。"],
      ["base", "無料で使えますか？", "はい。すべての基本機能を無料で利用できます。無料版には控えめなバナー広告が表示される場合があります。"],
      ["base", "サブスクリプションですか？", "いいえ。サブスクリプションはありません。"],
      ["base", "広告を削除できますか？", "はい。一度きりの「広告を永久に削除」を購入すると、広告が表示されなくなります。基本機能が追加される課金ではありません。"],
      ["base", "購入を復元できますか？", "はい。同じApple Accountを利用している場合、設定画面から購入を復元できます。"],
      ["base", "アカウント登録は必要ですか？", "いいえ。アカウント登録は必要ありません。"],
      ["base", "対応環境は？", "iOS 17以降を搭載したiPhoneに対応しています。現在はiPhone向けに開発しています。"],
      ["base", "Android版はありますか？", "現在、Android版は提供していません。"],
      ["space", "余白には何を入力しますか？", "名前、日付、開始時刻、終了時刻を入力します。"],
      ["space", "1日に複数作れますか？", "はい。1日に複数の余白を作成できます。"],
      ["space", "未来の日付にも作れますか？", "はい。日付を選択して、未来の余白も作成できます。"],
      ["space", "後から編集できますか？", "はい。Today画面の余白カードをタップすると、名前、日付、開始時刻、終了時刻を変更できます。"],
      ["space", "削除できますか？", "はい。編集画面または長押しメニューから削除できます。"],
      ["space", "Weekの四角は何を表していますか？", "その日に作成した余白の数を表しています。余白がない日は輪郭だけの四角、余白がある日は黒い四角で表示されます。"],
      ["space", "Monthの黒いマスは何を表していますか？", "その日に1件以上の余白があることを表しています。余白の長さや正確な件数をマスの濃さで表しているものではありません。"],
      ["space", "Monthはパターンを生成しますか？", "Month画面は、余白のある日を月間カレンダー上の印として表示する画面です。画像やアートを自動生成する機能ではありません。"],
      ["space", "余白の最中にタイマーは表示されますか？", "いいえ。余白は現実の時間として過ごすもので、タイマー、カウントダウン、専用モード、終了通知はありません。"],
      ["space", "終了後の確認には答える必要がありますか？", "いいえ。回答は任意です。閉じるか横に払うと消え、同じ余白について再度尋ねません。"],
      ["notice", "通知はいつ届きますか？", "通知を有効にすると、通常は登録した余白の開始時刻の3〜7分前に届きます。直前に作成した場合は、残り時間に応じて少し前に届くか、間に合わない場合は送信されません。"],
      ["notice", "通知許可はいつ表示されますか？", "最初の余白を作成したときに確認します。"],
      ["notice", "通知をオフにできますか？", "はい。設定画面からいつでもオフにできます。"],
      ["notice", "余白を編集すると通知も変わりますか？", "はい。開始時刻を変更すると、通知も新しい時刻へ更新されます。"],
      ["data", "データはどこに保存されますか？", "余白の記録は端末内に保存されます。"],
      ["data", "運営者は余白の内容を見られますか？", "いいえ。余白の名前や日時は運営者のサーバーへ送信されません。"],
      ["data", "端末間で同期できますか？", "現在、Yohaku独自の端末間同期には対応していません。"],
      ["data", "データを書き出せますか？", "現在、データの書き出しや読み込みには対応していません。"],
      ["data", "機種変更時に移行できますか？", "Yohaku独自の移行機能はありません。端末の故障、紛失、アプリ削除などによって記録が失われた場合、運営者が復旧することはできません。"],
      ["data", "アプリを削除するとどうなりますか？", "端末内に保存されている余白の記録は削除されます。運営者のサーバーから復旧することはできません。"],
      ["net", "オフラインでも使えますか？", "余白の作成、編集、削除、Today・Week・Monthの表示など、主要な記録機能はオフラインでも利用できます。"],
      ["net", "どの機能に通信が必要ですか？", "広告の取得、アプリ内課金、購入復元、お問い合わせ、最新の法務文書の表示などには通信が必要です。"],
      ["net", "問い合わせ時に余白の内容も送られますか？", "いいえ。余白の記録は自動的に添付されません。"],
    ]
  : [
      ["base", "What does Yohaku do?", "Yohaku lets you leave time with nothing planned—named and timed—then look back on Today, Week and Month."],
      ["base", "Is it a calendar or task manager?", "No. It does not manage events or tasks. It leaves room with nothing planned between what you already have."],
      ["base", "Is it free?", "Yes. Every core feature is free. The free version may show unobtrusive banner ads."],
      ["base", "Is there a subscription?", "No. There is no subscription."],
      ["base", "Can I remove ads?", "Yes. A one-time “Remove ads permanently” purchase removes ads. It does not unlock extra core features."],
      ["base", "Can I restore a purchase?", "Yes. On the same Apple Account, restore from Settings."],
      ["base", "Do I need an account?", "No."],
      ["base", "What devices are supported?", "iPhone with iOS 17 or later. The app is designed for iPhone."],
      ["base", "Is there an Android version?", "Not currently."],
      ["space", "What do I enter for a space?", "A name, date, start time and end time."],
      ["space", "Can I create more than one per day?", "Yes."],
      ["space", "Can I create spaces on future dates?", "Yes."],
      ["space", "Can I edit later?", "Yes. Tap a card on Today to change the name, date or times."],
      ["space", "Can I delete a space?", "Yes, from the editor or the long-press menu."],
      ["space", "What do the Week squares mean?", "How many spaces that day has. Empty days show an outline; days with spaces show filled squares."],
      ["space", "What do Month’s dark cells mean?", "That day has at least one space. Shade does not encode length or exact count."],
      ["space", "Does Month generate patterns?", "No. Month only marks days with space on a calendar. It does not generate art."],
      ["space", "Is there a timer while a space is active?", "No. A space is real time away from the app, so there is no timer, countdown, dedicated mode or end notification."],
      ["space", "Do I have to answer the check-in?", "No. It is optional. Close or swipe it away and the same space will not be asked about again."],
      ["notice", "When do notifications arrive?", "Normally three to seven minutes before a space begins. For a space created at short notice, it may arrive closer to the start or be skipped if there is not enough time."],
      ["notice", "When is permission requested?", "When you create your first space."],
      ["notice", "Can I turn notifications off?", "Yes, anytime in Settings."],
      ["notice", "Do edits update notifications?", "Yes. Changing the start time reschedules the notification."],
      ["data", "Where is data stored?", "On your device."],
      ["data", "Can the operator see my spaces?", "No. Names and times are not sent to the operator’s servers."],
      ["data", "Can I sync between devices?", "Not with a Yohaku-specific sync today."],
      ["data", "Can I export data?", "Not currently—no export or import."],
      ["data", "Can I migrate when I change phones?", "There is no Yohaku migration feature. If data is lost to device failure, loss or uninstall, the operator cannot restore it."],
      ["data", "What if I delete the app?", "On-device spaces are removed and cannot be restored from an operator server."],
      ["net", "Does it work offline?", "Creating, editing, deleting and viewing Today/Week/Month work offline."],
      ["net", "What needs a network?", "Loading ads, in-app purchase, restore, support messages and the latest legal documents."],
      ["net", "Are spaces attached to support messages?", "No. Space records are never attached automatically."],
    ];

const faqCats = ja
  ? [["all", "すべて"], ["base", "基本"], ["space", "余白"], ["notice", "通知"], ["data", "データ"], ["net", "通信"]]
  : [["all", "All"], ["base", "Basics"], ["space", "Spaces"], ["notice", "Notifications"], ["data", "Data"], ["net", "Network"]];

const legal = page === "privacy" ? privacySections(ja) : page === "terms" ? termsSections(ja) : [];

const newsPosts = ja
  ? [
      {
        id: "site-launch",
        date: "2026.08.01",
        datetime: "2026-08-01",
        badge: "お知らせ",
        badgeTone: "default" as const,
        title: "Yohaku公式ブランドサイトを公開しました",
        summary: "コンセプト、機能、使い方、料金、FAQ、プライバシーポリシー、利用規約を一か所にまとめました。",
        body: [
          "Yohakuの公式ブランドサイトを公開しました。アプリの考え方や、Today / Week / Monthでできること、無料で使える範囲と広告削除の位置づけを、公開準備中の段階からそのままお伝えしています。",
          "いまのサイトは、App Storeでの配信に先立つブランド案内です。ダウンロード用のリンクはまだ用意していません。公開の準備が整い次第、サイトからもご案内します。",
          "余白の記録は端末内に置かれ、アカウント登録やYohaku独自のクラウド同期はありません。詳しくはプライバシーポリシーと利用規約をご確認ください。",
        ],
      },
      {
        id: "column-space",
        date: "2026.08.01",
        datetime: "2026-08-01",
        badge: "コラム",
        badgeTone: "column" as const,
        title: "予定ではなく、余白だけを置くということ",
        summary: "Yohakuはタスク管理でも、習慣トラッカーでもありません。名前と時間で「何もしない時間」を置くための小さな道具です。",
        body: [
          "カレンダーは予定で埋まりやすく、空いている時間もすぐに何かを割り当ててしまいがちです。Yohakuはその逆で、何もしない時間に名前と開始・終了を与え、今日・週・月の印として静かに残します。",
          "Weekは各日の余白を黒い四角で、Monthは余白のある日をマスで示します。アートやパターンを自動生成するアプリではなく、置いた時間そのものを見返すための画面です。",
        ],
      },
      {
        id: "prep-note",
        date: "2026.08.01",
        datetime: "2026-08-01",
        badge: "準備中",
        badgeTone: "note" as const,
        title: "App Store公開に向けて",
        summary: "iPhone・iOS 17以降向け。基本機能は無料、バナー広告あり。一度きりの広告削除も用意しています。",
        body: [
          "現在はApp Storeでの公開準備中です。基本機能はすべて無料で、無料版には控えめなバナー広告が表示される場合があります。一度きりの「広告を永久に削除」は応援のお礼であり、追加機能の解放やサブスクリプションではありません。",
          "価格や表示内容は、公開時のApp Store上の記載が正しいものとします。",
        ],
      },
    ]
  : [
      {
        id: "site-launch",
        date: "2026.08.01",
        datetime: "2026-08-01",
        badge: "News",
        badgeTone: "default" as const,
        title: "The official Yohaku brand site is now live",
        summary: "Concept, features, how-to, pricing, FAQ, Privacy Policy, and Terms of Use—in one place.",
        body: [
          "The official Yohaku brand site is live. It explains the idea behind the app, what Today / Week / Month can do, and how free use and ad removal fit together—while the product is still preparing for release.",
          "This site is a brand guide ahead of App Store availability. There is no download link yet. When the app is ready, we will share it here as well.",
          "Spaces stay on your device. There is no Yohaku account or cloud sync. See the Privacy Policy and Terms for details.",
        ],
      },
      {
        id: "column-space",
        date: "2026.08.01",
        datetime: "2026-08-01",
        badge: "Column",
        badgeTone: "column" as const,
        title: "Not another plan—just space",
        summary: "Yohaku is not a task manager or habit tracker. It is a small tool for naming time with nothing planned.",
        body: [
          "Calendars fill quickly, and open time is easy to assign. Yohaku does the opposite: give unplanned time a name and start/end, then look back through quiet marks on day, week, and month views.",
          "Week shows filled squares for each day; Month marks days that hold a space. It does not generate art—it helps you notice the spaces you chose to leave.",
        ],
      },
      {
        id: "prep-note",
        date: "2026.08.01",
        datetime: "2026-08-01",
        badge: "Coming soon",
        badgeTone: "note" as const,
        title: "Preparing for the App Store",
        summary: "iPhone, iOS 17+. Core features free with optional banner ads; one-time ad removal as a thank-you.",
        body: [
          "Yohaku is being prepared for the App Store. Every core feature is free; the free version may show unobtrusive banner ads. A one-time “Remove ads permanently” purchase is a thank-you for support—not a feature unlock or subscription.",
          "When the app ships, the App Store listing is the source of truth for pricing and availability.",
        ],
      },
    ];
---

<AppShell lang={lang} title={title} page={page} description={description}>
  <section class:list={["content-page", `content-${page}`]}>
    <header class:list={["content-hero", page !== "privacy" && page !== "terms" && "content-hero--center"]}>
      <p class="content-eyebrow">{page.toUpperCase()}</p>
      <h1>{title}</h1>
      {(page === "privacy" || page === "terms") && (
        <div class="legal-dates">
          <p>{ja ? "制定日：2026年7月29日" : "Effective date: July 29, 2026"}</p>
          <p>{ja ? "最終更新日：2026年8月4日" : "Last updated: August 4, 2026"}</p>
        </div>
      )}
    </header>

    {page === "features" && (
      <div class="feature-blocks">
        {featureBlocks.map((block, i) => (
          <article class:list={["feature-block", i % 2 === 1 && "is-reverse"]}>
            <div class="feature-block-copy">
              <h2>{block.heading}</h2>
              <p>{block.body}</p>
            </div>
            <div class="feature-block-visual">
              <PhoneMock kind={block.kind} size="md" lang={lang} />
            </div>
          </article>
        ))}
      </div>
    )}

    {page === "how-to" && (
      <ol class="how-steps">
        {howSteps.map((step) => (
          <li>
            <span class="how-n">{step.n}</span>
            <div>
              <h2>{step.title}</h2>
              <p>{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    )}

    {page === "screenshots" && (
      <div class="concept-page">
        <p class="concept-lead">
          {ja
            ? "予定ではなく、余白だけを。Yohakuは、日々の中に何もしない時間を置き、静かに振り返るための小さな習慣です。"
            : "Not another plan—just space. Yohaku is a small habit for leaving time with nothing planned, then looking back quietly."}
        </p>
        <div class="concept-phones">
          <PhoneMock kind="today" size="md" lang={lang} />
          <PhoneMock kind="week" size="md" lang={lang} />
          <PhoneMock kind="month" size="md" lang={lang} />
        </div>
        <div class="concept-ideas">
          {conceptIdeas.map((idea) => (
            <article>
              <h2>{idea.title}</h2>
              <p>{idea.body}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    {page === "pricing" && (
      <div class="pricing-page">
        <div class="pricing-card">
          <p class="pricing-kicker">v1</p>
          <h2>{ja ? "基本機能は、すべて無料です。" : "Every core feature is free."}</h2>
          <div class="pricing-copy">
            {ja ? (
              <>
                <p>Yohakuの基本機能は、すべて無料で利用できます。</p>
                <p>無料版には、操作を妨げない控えめなバナー広告が表示される場合があります。</p>
                <p>一度きりの「広告を永久に削除」を購入すると、開発への応援のお礼として広告が表示されなくなります。</p>
                <p>追加機能を解放する課金や、サブスクリプションではありません。</p>
              </>
            ) : (
              <>
                <p>Every core feature in Yohaku is available for free.</p>
                <p>The free version may show unobtrusive banner ads.</p>
                <p>A one-time “Remove ads permanently” purchase removes ads as a thank-you for supporting development.</p>
                <p>It does not unlock additional core features and is not a subscription.</p>
              </>
            )}
          </div>
          <ul class="pricing-list">
            {(ja
              ? ["余白の作成・編集・削除", "Today / Week / Month", "任意の通知と振り返り", "18言語", "端末内保存", "アカウント不要"]
              : ["Create, edit and delete spaces", "Today / Week / Month", "Optional notices and check-ins", "18 languages", "On-device storage", "No account"]
            ).map((item) => <li>{item}</li>)}
          </ul>
          <p class="pricing-note">
            {ja
              ? "価格はApp Store上の表示が正しいものとします。購入・復元・返金はAppleの条件に従います。"
              : "The price shown on the App Store is authoritative. Purchases, restores and refunds follow Apple’s terms."}
          </p>
          <p class="pricing-env">
            {ja
              ? "iPhone・iOS 17以降に対応。現在はiPhone向けです。"
              : "Requires an iPhone with iOS 17 or later. Designed for iPhone."}
          </p>
          <span class="store-button store-soon" aria-disabled="true">{storeLabel}</span>
        </div>
      </div>
    )}

    {page === "faq" && (
      <div class="faq-page">
        <nav class="faq-tabs" aria-label={ja ? "カテゴリ" : "Categories"} data-faq-tabs>
          {faqCats.map(([key, label], i) => (
            <button type="button" data-cat={key} aria-current={i === 0 ? "true" : "false"}>{label}</button>
          ))}
        </nav>
        <div class="faq-list" data-faq-list>
          {faqs.map(([cat, q, a], i) => (
            <details data-cat={cat} open={i === 0}>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
        <aside class="faq-contact">
          <h2>{ja ? "解決しない場合" : "Still need help?"}</h2>
          <p>{ja ? "お気軽にお問い合わせください。" : "Feel free to get in touch."}</p>
          <a href={supportHref} target="_blank" rel="noopener noreferrer">{ja ? "お問い合わせ" : "Contact"} →</a>
        </aside>
      </div>
    )}

    {page === "updates" && <NewsFeed lang={lang} posts={newsPosts} />}

    {(page === "privacy" || page === "terms") && (
      <article class="legal-copy">
        {legal.map(([heading, body]) => (
          <section>
            <h2>{heading}</h2>
            {body.split("\n\n").map((para) => (
              <p>{para.split("\n").map((line) => <>{line}<br /></>)}</p>
            ))}
          </section>
        ))}
      </article>
    )}

    {(page === "features" || page === "how-to" || page === "screenshots") && (
      <section class="download-section download-section--inline">
        <h2>{ja ? "余白を置く、小さな習慣を。" : "Leave room. Keep it small."}</h2>
        <span class="store-button store-soon" aria-disabled="true">{storeLabel}</span>
      </section>
    )}
  </section>
</AppShell>

<script is:inline>
  (() => {
    const bindFaq = () => {
      const tabs = document.querySelector("[data-faq-tabs]");
      const list = document.querySelector("[data-faq-list]");
      if (!tabs || !list || tabs.dataset.bound === "1") return;
      tabs.dataset.bound = "1";
      const items = Array.from(list.querySelectorAll("details"));
      tabs.addEventListener("click", (e) => {
        const btn = e.target.closest("button[data-cat]");
        if (!btn) return;
        const cat = btn.getAttribute("data-cat");
        items.forEach((item) => {
          item.hidden = !(cat === "all" || item.getAttribute("data-cat") === cat);
        });
        tabs.querySelectorAll("button").forEach((b) => {
          b.setAttribute("aria-current", String(b.getAttribute("data-cat") === cat));
        });
      });
    };
    document.addEventListener("astro:page-load", bindFaq);
    bindFaq();
  })();
</script>
