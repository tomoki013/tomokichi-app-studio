---
import "../styles/global.css";

interface Props {
  lang: "ja" | "en";
  title: string;
  description: string;
  canonical?: string;
  alternateJa?: string;
  alternateEn?: string;
}

const { lang, title, description, canonical, alternateJa, alternateEn } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternateJa && <link rel="alternate" hreflang="ja" href={alternateJa} />}
    {alternateEn && <link rel="alternate" hreflang="en" href={alternateEn} />}
    {alternateJa && <link rel="alternate" hreflang="x-default" href={alternateJa} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
  </head>

  <body>
    <slot />

    <script is:inline>
      /* Anything marked [data-reveal] drifts up as it enters the viewport.
         Siblings can stagger by setting --reveal-i in markup. */
      (() => {
        const items = document.querySelectorAll("[data-reveal]");
        if (!items.length) return;
        if (
          matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !("IntersectionObserver" in window)
        ) {
          items.forEach((item) => {
            item.classList.add("is-visible");
          });
          return;
        }
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }),
          { threshold: 0.1, rootMargin: "0px 0px -8% 0px" },
        );
        items.forEach((item) => {
          observer.observe(item);
        });
      })();
    </script>
  </body>
</html>
