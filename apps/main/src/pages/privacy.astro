---
import DocPage from "../components/DocPage.astro";
import { legal } from "../lib/copy";

const lang = "en" as const;
---

<DocPage lang={lang} path="/privacy" metaTitle={legal.privacy.metaTitle[lang]} heading={legal.privacy.heading[lang]}>
  <p>{legal.privacy.body[lang]}</p>
  <p class="muted">Last updated: July 26, 2026</p>
</DocPage>
