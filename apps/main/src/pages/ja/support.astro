---
import ArrowLink from "../../components/ArrowLink.astro";
import DocPage from "../../components/DocPage.astro";
import { support } from "../../lib/copy";

const lang = "ja" as const;
---

<DocPage lang={lang} path="/support" current="support" metaTitle={support.metaTitle[lang]} heading={support.heading[lang]}>
  <p>{support.body[lang]}</p>
  <p class="muted">{support.personal[lang]}</p>
  <div class="actions"><ArrowLink href="/ja/apps" label={support.appsCta[lang]} /></div>
</DocPage>
