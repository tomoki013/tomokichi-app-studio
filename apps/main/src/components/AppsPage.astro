---
import type { Locale } from "../data/apps";
import { orderedApps } from "../data/apps";
import { appsPage } from "../lib/copy";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import ArrowLink from "./ArrowLink.astro";
import AppCard from "./AppCard.astro";

const { lang } = Astro.props as { lang: Locale };
const ja = lang === "ja";
const p = (path: string) => (ja ? path : `/en${path === "/" ? "" : path}`);
const visualIcons = ["remeet", "tripory", "soonish", "tana"];
---

<BaseLayout lang={lang} title={appsPage.metaTitle[lang]} description={appsPage.metaDescription[lang]}>
  <div class="site">
    <SiteHeader lang={lang} path="/apps" current="apps" />

    <main>
      <section class="apps-hero shell">
        <div>
          <h1>{appsPage.hero.heading[lang]}</h1>
          <p class="lead">{appsPage.hero.body[lang]}</p>
        </div>
        <div class="apps-visual" aria-hidden="true">
          {visualIcons.map((ic, i) => <div class:list={["app-icon", ic, `i${i + 1}`]}><span></span></div>)}
        </div>
      </section>

      <nav class="apps-filter shell" aria-label={ja ? "ステータスで絞り込み" : "Filter by status"} data-filter-bar>
        {appsPage.filters.map((f, i) => (
          <button type="button" data-filter={f.key} aria-current={i === 0 ? "true" : "false"}>{f.label[lang]}</button>
        ))}
      </nav>

      <section class="apps-list shell" data-apps-list>
        {orderedApps.map((app) => <AppCard app={app} lang={lang} variant="large" />)}
        <p class="apps-empty" hidden data-empty>{ja ? "該当するアプリはありません。" : "No apps match this filter."}</p>
      </section>

      <section class="apps-support shell">
        <h2>{appsPage.bottom.heading[lang]}</h2>
        <p>{appsPage.bottom.body[lang]}</p>
        <ArrowLink href={p("/support")} label={appsPage.bottom.cta[lang]} />
      </section>
    </main>

    <SiteFooter lang={lang} />
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const bar = document.querySelector("[data-filter-bar]");
    const list = document.querySelector("[data-apps-list]");
    if (!bar || !list) return;
    const cards = Array.from(list.querySelectorAll(".app-card"));
    const empty = list.querySelector("[data-empty]");

    const apply = (key) => {
      let shown = 0;
      cards.forEach((card) => {
        const match = key === "all" || card.getAttribute("data-status") === key;
        card.classList.toggle("is-hidden", !match);
        if (match) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
      bar.querySelectorAll("button").forEach((b) =>
        b.setAttribute("aria-current", String(b.getAttribute("data-filter") === key)),
      );
      const url = new URL(location.href);
      if (key === "all") url.searchParams.delete("status");
      else url.searchParams.set("status", key);
      history.replaceState(null, "", url);
    };

    bar.addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-filter]");
      if (btn) apply(btn.getAttribute("data-filter"));
    });

    const initial = new URL(location.href).searchParams.get("status");
    if (initial && ["released", "developing", "concept"].includes(initial)) apply(initial);
  })();
</script>
