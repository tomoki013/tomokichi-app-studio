---
import type { AppItem, Locale } from "../data/apps";
import { appsPage } from "../lib/copy";
import AppIcon from "./AppIcon.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  app: AppItem;
  lang: Locale;
  variant?: "compact" | "large";
}
const { app, lang, variant = "compact" } = Astro.props;
const appsHref = lang === "ja" ? "/apps" : "/en/apps";
const compactHref = app.url ?? appsHref;
const externalCompact = Boolean(app.url);
---

{variant === "compact" ? (
  <a
    class="app-card"
    href={compactHref}
    rel={externalCompact ? "noopener noreferrer" : undefined}
    target={externalCompact ? "_blank" : undefined}
    aria-label={`${app.name} — ${app.tagline[lang]}`}
  >
    <div class="card-body">
      <div class="card-top">
        <AppIcon iconClass={app.iconClass} size={44} />
        <StatusBadge status={app.status} lang={lang} />
      </div>
      <h3>{app.name}</h3>
      <p class="tagline">{app.tagline[lang]}</p>
    </div>
    {app.previewImage && <img class="preview" src={app.previewImage} alt="" loading="lazy" />}
  </a>
) : (
  <article class="app-card large" data-status={app.status}>
    <div class="card-body">
      {app.accent && <span class="accent-line" style={`background:${app.accent}`} aria-hidden="true"></span>}
      <div class="card-top">
        <AppIcon iconClass={app.iconClass} size={54} />
        <StatusBadge status={app.status} lang={lang} />
      </div>
      <h3>{app.name}</h3>
      <p class="tagline">{app.tagline[lang]}</p>
      <p class="desc">{app.description[lang]}</p>
      <div class="meta">
        <span>{app.platform.join(" / ")}</span>
      </div>
      <div class="card-actions">
        {app.url ? (
          <a class="arrow-link soft" href={app.url} rel="noopener noreferrer" target="_blank">
            <span>{appsPage.visit[lang]}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ) : (
          <span class="soon">{appsPage.soon[lang]}</span>
        )}
      </div>
    </div>
    {app.previewImage && <img class="preview" src={app.previewImage} alt={`${app.name}`} loading="lazy" />}
  </article>
)}
