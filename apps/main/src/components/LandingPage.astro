---
import BaseLayout from "../layouts/BaseLayout.astro";

type Locale = "ja" | "en";
const { lang } = Astro.props as { lang: Locale };
const ja = lang === "ja";

const copy = ja
  ? {
      nav: ["アプリ", "思想", "私について", "サポート"],
      hero: "日常に、\nひとつだけ残る\nアプリを。",
      intro: "旅、記憶、余白、いつかやりたいこと。\n日常の小さな感情に、\nそれぞれひとつのアプリをつくっています。",
      learn: "詳しく見る",
      apps: "アプリ一覧",
      all: "すべて見る",
      why: "なぜ作っているのか",
      whyBody:
        "ひとつの大きなアプリに、すべての機能を詰め込みたいわけではありません。\n旅行を残したい日には旅のアプリを、誰かを待つ時間にはそのためのアプリを。\nそれぞれの感情に、ちょうどいい大きさのアプリをつくりたいと考えています。",
      principles: "制作方針",
      about: "作っている人",
      aboutBody:
        "Tomokichiという名前で、WebサイトやiPhoneアプリをつくっています。\n旅や記憶、日常の小さな感情を残すためのプロダクトが好きです。\n大きな課題をすべて解決するものより、「これだけ欲しかった」と思える小さなアプリを、ひとつずつ形にしています。",
      cta: "どれかひとつ、あなたの日常に。",
      ctaSub: "気になるアプリを見つけてみてください。",
      footerSub: "小さなアプリを、ひとつずつ。",
    }
  : {
      nav: ["Apps", "Principles", "About", "Support"],
      hero: "Small apps\nthat stay\nin your life.",
      intro:
        "For travel, memories, blank spaces,\nand things you want to do someday.\nI create one app for each small feeling\nin everyday life.",
      learn: "Learn more",
      apps: "My Apps",
      all: "View all",
      why: "Why I build these apps",
      whyBody:
        "I don’t want to pack everything into one big app.\nWhen I want to remember a trip, I use a travel app.\nWhen I’m waiting for someone, I use an app for that.\nI believe each feeling deserves an app that’s just the right size.",
      principles: "My principles",
      about: "About me",
      aboutBody:
        "I’m Tomokichi, an independent maker of websites and iOS apps.\nI love creating products that help people capture travel, memories, and small feelings in everyday life.\n\nRather than solving every problem at once, I focus on building small apps that feel like, “this is exactly what I wanted.”",
      cta: "Find one that fits your life.",
      ctaSub: "Explore the apps and see what speaks to you.",
      footerSub: "Small apps made independently\nby Tomokichi.",
    };

const apps = [
  {
    name: "Remeet",
    icon: "remeet",
    screen: "/assets/app-remeet.png",
    ja: "また会える日までを、ふたりで待つ",
    en: "Counting down to the day we meet again",
  },
  {
    name: "Tripory",
    icon: "tripory",
    screen: "/assets/app-tripory.png",
    ja: "行った国と旅の記憶を集める",
    en: "Collect places you’ve been and travel memories",
  },
  {
    name: "Soonish",
    icon: "soonish",
    screen: "/assets/app-soonish.png",
    ja: "「いつか」を忘れない場所",
    en: "A place for things you want to do someday",
  },
  {
    name: "Yohaku",
    icon: "yohaku",
    screen: "/assets/app-yohaku.png",
    ja: "予定ではなく、余白をつくる",
    en: "Create blank space in your day, not just schedules",
  },
  {
    name: "Tana",
    icon: "tana",
    screen: "/assets/app-tana.png",
    ja: "持っている本と読んだ記憶を残す",
    en: "Keep track of the books you own and have read",
  },
];

const principles = ja
  ? [
      ["◎", "小さく、ひとつの目的に", "何でもできるアプリではなく、使う理由がひとつで伝わるアプリをつくります。"],
      ["♡", "操作より、体験を考える", "機能を増やす前に、そのアプリを開いたときにどんな気持ちになるかを考えます。"],
      ["☼", "AIは裏側に", "AIを見せることよりも、入力や整理の負担を減らすために使います。"],
      ["♧", "長く使える形に", "アカウント登録や複雑な設定をできるだけ減らし、生活に自然に残るものを目指します。"],
    ]
  : [
      ["◎", "One purpose,\nkept small", "I create apps with a single, clear purpose—not apps that try to do everything."],
      ["♡", "Experience\nover features", "Before adding new features, I think about how the app makes you feel when you open it."],
      ["☼", "AI in the\nbackground", "I use AI to reduce the burden of input and organisation, not to be the main feature."],
      ["♧", "Built to stay\nin your life", "I minimize sign-ups and complex settings so the apps can stay with you naturally for a long time."],
    ];
---

<BaseLayout
  lang={lang}
  title={ja ? "tomokichi — 小さなアプリを、ひとつずつ。" : "tomokichi — Small apps for everyday life."}
  description={copy.intro.replaceAll("\n", " ")}
>
  <div class="site">
    <header class="header shell">
      <a class="brand" href={ja ? "/" : "/en"}>tomokichi</a>
      <nav aria-label="Main navigation">
        {copy.nav.map((label, index) => <a href={index === 0 ? "#apps" : index === 1 ? "#principles" : index === 2 ? "#about" : "mailto:hello@tomokichi.dev"}>{label}</a>)}
      </nav>
      <div class="languages"><a class:list={{ active: ja }} href="/">JA</a><span>|</span><a class:list={{ active: !ja }} href="/en">EN</a></div>
    </header>

    <main>
      <section class="hero shell">
        <div class="hero-copy">
          <h1>{copy.hero.split("\n").map((line) => <>{line}<br /></>)}</h1>
          <p>{copy.intro.split("\n").map((line) => <>{line}<br /></>)}</p>
          <a class="arrow-link" href="#apps">{copy.learn}<span>→</span></a>
        </div>
        <figure class="hero-visual">
          <img src="/assets/hero-phone.png" alt="Remeet app on an iPhone" />
        </figure>
        <div class="dots" aria-hidden="true"><b></b><i></i><i></i></div>
      </section>

      <section class="apps-section shell" id="apps">
        <div class="section-heading"><h2>{copy.apps}</h2><a href="#all-apps">{copy.all}<span>→</span></a></div>
        <div class="app-grid">
          {apps.map((app) => (
            <article class="app-card">
              <div class:list={["app-icon", app.icon]} aria-hidden="true"><span></span></div>
              <h3>{app.name}</h3>
              <p>{app[lang]}</p>
              <small>⌁ {ja ? "公開中" : "Available"}</small>
              <img class="screen" src={app.screen} alt={`${app.name} app screen`} />
            </article>
          ))}
        </div>
      </section>

      <section class="why shell">
        <div><h2>{copy.why}</h2><p>{copy.whyBody.split("\n").map((line) => <>{line}<br /></>)}</p></div>
        <img src="/assets/workspace.png" alt={ja ? "窓辺のノートとコーヒー" : "A notebook and coffee by a window"} />
      </section>

      <section class="principles shell" id="principles">
        <h2>{copy.principles}</h2>
        <div class="principle-grid">
          {principles.map(([icon, title, body]) => (
            <article><span>{icon}</span><h3>{title.split("\n").map((line) => <>{line}<br /></>)}</h3><p>{body}</p></article>
          ))}
        </div>
      </section>

      <section class="about shell" id="about">
        <h2>{copy.about}</h2>
        <img src="/assets/avatar.png" alt="Tomokichi" />
        <div>
          <p>{copy.aboutBody.split("\n").map((line) => <>{line}<br /></>)}</p>
          <ul><li>● Kyoto / Tokyo</li><li>◉ Website</li><li>◉ GitHub</li><li>↗ Contact</li></ul>
        </div>
      </section>

      <section class="final-cta shell" id="all-apps">
        <h2>{copy.cta}</h2><p>{copy.ctaSub}</p>
        <div class="mini-apps">
          {apps.map((app) => <a href={app.name === "Remeet" ? "https://remeet.tmkch.io" : "#apps"}><div class:list={["app-icon", app.icon]}><span></span></div><small>{app.name}</small></a>)}
        </div>
        <a class="view-all" href="#apps">{copy.all} →</a>
      </section>
    </main>

    <footer class="footer shell">
      <div><strong>tomokichi</strong><p>{copy.footerSub.split("\n").map((line) => <>{line}<br /></>)}</p></div>
      <div class="footer-links"><a href="#apps">Apps</a><a href="#principles">Principles</a><a href="#about">About</a><a href="mailto:hello@tomokichi.dev">Support</a><a href="#">Privacy</a></div>
      <div class="social">𝕏　◎　✉</div>
      <small>© 2026 Tomokichi. All rights reserved.</small>
    </footer>
  </div>
</BaseLayout>
