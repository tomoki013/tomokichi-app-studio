---
import AppSiteShell from "@tomokichi/app-site/AppSiteShell.astro";

type Locale = "ja" | "en";
const { lang, title, page = "", description } = Astro.props as {
  lang: Locale;
  title: string;
  page?: string;
  description?: string;
};
const ja = lang === "ja";
const base = ja ? "/ja" : "";
const href = (slug: string) => `${base}/${slug}`.replaceAll("//", "/");
const jaPageHref = (`/ja/${page}`.replace(/\/$/, "")) || "/ja";
const enPageHref = `/${page}`.replace(/\/$/, "") || "/";
const supportHref = `https://tmkch.io/${ja ? "ja/" : ""}support?app=colorvia`;
const nav = [
  { slug: "features", label: ja ? "機能" : "Features", href: href("features") },
  { slug: "how-to", label: ja ? "使い方" : "How it works", href: href("how-to") },
  { slug: "faq", label: "FAQ", href: href("faq") },
  { slug: "updates", label: ja ? "お知らせ" : "News", href: href("updates") },
];
const footerColumns = ja
  ? [
      { title: "プロダクト", links: [{ label: "機能", href: href("features") }, { label: "使い方", href: href("how-to") }, { label: "スクリーンショット", href: href("screenshots") }] },
      { title: "サポート", links: [{ label: "よくある質問", href: href("faq") }, { label: "お知らせ", href: href("updates") }, { label: "お問い合わせ", href: supportHref, external: true }] },
      { title: "規約", links: [{ label: "プライバシーポリシー", href: href("privacy") }, { label: "利用規約", href: href("terms") }] },
      { title: "Tomokichi", links: [{ label: "Tomokichi", href: "https://tmkch.io/ja", external: true }, { label: "ほかのアプリ", href: "https://tmkch.io/ja/apps", external: true }] },
    ]
  : [
      { title: "Product", links: [{ label: "Features", href: href("features") }, { label: "How it works", href: href("how-to") }, { label: "Screenshots", href: href("screenshots") }] },
      { title: "Support", links: [{ label: "FAQ", href: href("faq") }, { label: "News", href: href("updates") }, { label: "Contact", href: supportHref, external: true }] },
      { title: "Legal", links: [{ label: "Privacy Policy", href: href("privacy") }, { label: "Terms of Service", href: href("terms") }] },
      { title: "Tomokichi", links: [{ label: "Tomokichi", href: "https://tmkch.io", external: true }, { label: "Other apps", href: "https://tmkch.io/apps", external: true }] },
    ];
const metaDescription = description ?? (ja
  ? "訪れた国を選ぶだけで、自分だけの世界地図をつくれるシンプルな記録アプリColorvia。"
  : "Colorvia is a simple app that turns the countries you visit into a world map of your own.");
---

<AppSiteShell
  lang={lang}
  title={title}
  description={metaDescription}
  page={page}
  brand="Colorvia"
  logoImage="/assets/colorvia-icon.png"
  tagline={ja ? "世界を、シンプルに彩ろう。" : "Colour the world, simply."}
  siteUrl="https://colorvia.tmkch.io"
  homeHref={ja ? "/ja" : "/"}
  jaPageHref={jaPageHref}
  enPageHref={enPageHref}
  nav={nav}
  footerColumns={footerColumns}
  appStoreLabel={ja ? "App Storeで見る" : "View on App Store"}
  menuLabel={ja ? "メニュー" : "Menu"}
>
  <slot />
</AppSiteShell>
