---
import NewsFeed from "@tomokichi/app-site/NewsFeed.astro";
import { supportUrl } from "@tomokichi/app-site/urls";
import {
  descriptions,
  type Locale,
  languagesEn,
  languagesJa,
  type Page,
  pick,
  privacySections,
  regions,
  termsSections,
  titles,
} from "../lib/content";
import AppScreen from "./AppScreen.astro";
import AppShell from "./AppShell.astro";

const { lang, page } = Astro.props as { lang: Locale; page: Page };
const ja = lang === "ja";
const supportHref = supportUrl("colorvia", lang);
const title = pick(ja, titles[page]);
const description = pick(ja, descriptions[page]);
const storeLabel = ja ? "App Storeで近日公開" : "Coming soon on the App Store";
const legal = page === "privacy" ? privacySections(ja) : page === "terms" ? termsSections(ja) : [];

const newsPosts = ja
  ? [
      {
        id: "site-launch",
        date: "2026.08.01",
        datetime: "2026-08-01",
        badge: "お知らせ",
        title: "Colorvia公式ブランドサイトを公開しました",
        summary: "機能、地域マップ、使い方、FAQ、プライバシーポリシー、利用規約をまとめて掲載しています。",
        body: [
          "Colorviaの公式ブランドサイトを公開しました。訪れた国や地域を地図の色として残すアプリの考え方と、対応している地域マップの範囲を、公開準備中の段階からそのままお伝えしています。",
          "現時点ではApp Storeへのリンクはありません。配信の準備が整い次第、サイトからもご案内します。",
          "地図はCanvas描画で、オフラインでも閲覧できます。データはJSONで書き出し・読み込みでき、端末内に保存されます。詳細はプライバシーポリシーと利用規約をご確認ください。",
        ],
      },
      {
        id: "column-map",
        date: "2026.08.01",
        datetime: "2026-08-01",
        badge: "コラム",
        badgeTone: "column" as const,
        title: "国から、その先の地域まで",
        summary: "対応国では都道府県・州など、国の内側まで訪れた場所を残せます。",
        body: [
          "Colorviaは訪問した国を色づけるだけでなく、対応している国では都道府県や州などの単位まで記録できます。都市名や地名から該当する地域を探すこともできます。",
          "地図や地域区分は旅の記録のために簡略化したもので、政治的な立場を示すものではありません。",
        ],
      },
      {
        id: "prep-note",
        date: "2026.08.01",
        datetime: "2026-08-01",
        badge: "準備中",
        badgeTone: "note" as const,
        title: "App Store公開に向けて",
        summary: "iPhone・iOS 18以降向け。現在公開準備中です。",
        body: [
          "Colorviaは現在App Store公開準備中です。対応環境や価格の最終表示は、公開時のApp Store上の記載が正しいものとします。",
        ],
      },
    ]
  : [
      {
        id: "site-launch",
        date: "2026.08.01",
        datetime: "2026-08-01",
        badge: "Update",
        title: "The official Colorvia brand site is now live",
        summary: "Features, regional maps, how-to, FAQ, Privacy Policy, and Terms—in one place.",
        body: [
          "The official Colorvia brand site is live. It explains colouring countries and regions you have visited, and which in-country maps are supported—while the app is still preparing for release.",
          "There is no App Store link yet. When distribution is ready, we will share it here as well.",
          "Maps are canvas-drawn and work offline. Data can be exported and imported as JSON and stays on your device. See the Privacy Policy and Terms for details.",
        ],
      },
      {
        id: "column-map",
        date: "2026.08.01",
        datetime: "2026-08-01",
        badge: "Column",
        badgeTone: "column" as const,
        title: "From countries to the places inside them",
        summary: "In supported countries, record prefectures, states, and other travel areas.",
        body: [
          "Colorvia does more than tint countries: where supported, you can mark prefectures, states, and similar units, and search by city or place name.",
          "Maps and divisions are simplified for travel logging and do not express a political position.",
        ],
      },
      {
        id: "prep-note",
        date: "2026.08.01",
        datetime: "2026-08-01",
        badge: "Coming soon",
        badgeTone: "note" as const,
        title: "Preparing for the App Store",
        summary: "Designed for iPhone on iOS 18+.",
        body: [
          "Colorvia is being prepared for the App Store. The listing will be the source of truth for requirements and pricing when it ships.",
        ],
      },
    ];


const featureGroups = ja
  ? [
      {
        h: "世界地図",
        screen: "home" as const,
        items: [
          "訪問国を選んだ地図色で表示",
          "ピンチズーム、ドラッグ移動、ダブルタップズーム",
          "拡大・縮小ボタンと地図位置リセット",
          "アプリ内同梱の地理データ（オンライン地図タイルは不使用）",
        ],
      },
      {
        h: "国の選択",
        screen: "controls" as const,
        items: [
          "ホーム右下の＋ボタンから追加",
          "国名検索、国旗、日本語名／英語名",
          "地域別一覧、複数国の一括選択",
          "確定前の地図プレビュー",
        ],
      },
      {
        h: "統計",
        screen: "stats" as const,
        items: [
          "訪問国数と世界の訪問率",
          "大陸別の訪問数",
          "訪問済み国一覧",
          "地域マップの訪問数・訪問率・一覧",
        ],
      },
      {
        h: "地域マップ",
        screen: "home" as const,
        items: [
          "対応11か国",
          "地域の塗り分け、訪問済み／未訪問フィルター",
          "都市名・地名からの地域検索",
          "地域別統計と共有用画像",
        ],
      },
      {
        h: "パーソナライズとデータ",
        screen: "coral" as const,
        items: [
          "ライト／ダーク／システム設定",
          "地図色の変更",
          "JSON書き出し・読み込みと不整合の検出",
          "全データ削除",
        ],
      },
      {
        h: "その他",
        screen: "dark" as const,
        items: [
          "共有",
          "11言語",
          "オフライン対応",
          "アカウント不要・端末内保存",
          "アプリ内問い合わせ",
          "法務文書のオフラインフォールバック",
          "控えめなバナー広告（高さに余裕がある端末）",
        ],
      },
    ]
  : [
      {
        h: "World map",
        screen: "home" as const,
        items: [
          "Visited countries in your chosen map colour",
          "Pinch, drag and double-tap zoom",
          "Zoom buttons and map reset",
          "Bundled geography—no online map tiles",
        ],
      },
      {
        h: "Country selection",
        screen: "controls" as const,
        items: [
          "Add from the + button on Home",
          "Search, flags, local and English names",
          "Browse by region; multi-select",
          "Map preview before confirming",
        ],
      },
      {
        h: "Statistics",
        screen: "stats" as const,
        items: [
          "Visit count and world percentage",
          "Breakdown by continent",
          "List of visited countries",
          "Regional visit counts, rates and lists",
        ],
      },
      {
        h: "Regional maps",
        screen: "home" as const,
        items: [
          "Eleven supported countries",
          "Colour by visit; visited/unvisited filters",
          "Search by city or place name",
          "Regional stats and share images",
        ],
      },
      {
        h: "Personalisation and data",
        screen: "coral" as const,
        items: [
          "Light / dark / system appearance",
          "Map colour choices",
          "JSON export/import with inconsistency checks",
          "Delete all data",
        ],
      },
      {
        h: "More",
        screen: "english" as const,
        items: [
          "Sharing",
          "Eleven languages",
          "Offline use",
          "No account; on-device storage",
          "In-app support",
          "Offline legal fallback",
          "Quiet banner ads on taller screens",
        ],
      },
    ];

const howGuides = ja
  ? [
      {
        t: "はじめる",
        screen: "home" as const,
        note: "まずは、これまでに訪れた国をひとつ選ぶだけで大丈夫です。",
        steps: ["アプリを開くとオンボーディングのあとホームの世界地図が表示されます。", "アカウント登録は不要です。"],
      },
      {
        t: "国を追加・削除する",
        screen: "controls" as const,
        note: "地図を直接タップするのではなく、右下の＋から選びます。",
        steps: [
          "ホーム右下の＋をタップします。",
          "国名を検索するか、地域別一覧から探します。",
          "訪れた国にチェックを付け、右上の確定で保存します。",
          "世界地図を直接タップして国を追加することはできません。",
        ],
      },
      {
        t: "世界地図を見る",
        screen: "coral" as const,
        note: "地図色はあとから何度でも変えられます。",
        steps: ["ピンチやボタンで拡大・縮小します。", "ドラッグで移動し、リセットで初期表示に戻せます。", "設定から地図色を変えられます。"],
      },
      {
        t: "統計を見る",
        screen: "stats" as const,
        note: "ホーム下部のシートを上へ動かすと、旅の広がりが数字で見えます。",
        steps: ["ホーム下部のシートを開きます。", "訪問国数、世界の訪問率、大陸別の内訳、訪問済み国一覧を確認します。"],
      },
      {
        t: "地域を記録する",
        screen: "home" as const,
        note: "日本の都道府県やアメリカの州など、対応する11か国で使えます。",
        steps: [
          "対応国を開き、地域マップまたは一覧へ進みます。",
          "訪れた都道府県・州・県などにチェックを付けます。",
          "訪問数と割合、フィルター、共有用画像が使えます。",
        ],
      },
      {
        t: "地名検索",
        screen: "controls" as const,
        note: "地名データはアプリ内に入っているため、旅先で通信がなくても検索できます。",
        steps: ["地域マップの検索から、都市名や地名で該当地域を探せます。", "検索データはアプリ内に同梱されており、オフラインでも利用できます。"],
      },
      {
        t: "データ移行",
        screen: "dark" as const,
        note: "自動同期ではないため、機種変更前にJSONを書き出して保管してください。",
        steps: [
          "設定 → データ管理 → JSON書き出し。",
          "新しい端末でJSONを読み込み、訪問国と地域の記録を復元します。",
          "親国が未訪問の不整合は、親国を訪問済みにするか該当地域を除外して解決できます。",
        ],
      },
      {
        t: "テーマ・地図色",
        screen: "dark" as const,
        note: "夜の旅支度にはダーク、地図を明るく眺めたいときはライトがおすすめです。",
        steps: ["設定からシステム／ライト／ダークを選べます。", "地図色を変更して世界地図の印象を変えられます。"],
      },
    ]
  : [
      {
        t: "Getting started",
        screen: "english" as const,
        note: "Begin with just one country you remember visiting.",
        steps: ["After a short onboarding, Home shows the world map.", "No account is required."],
      },
      {
        t: "Add or remove countries",
        screen: "controls" as const,
        note: "Use + at the bottom-right rather than tapping the map itself.",
        steps: [
          "Tap + at the bottom-right of Home.",
          "Search by name or browse by region.",
          "Check visited countries and confirm.",
          "You cannot add countries by tapping the world map.",
        ],
      },
      {
        t: "Explore the world map",
        screen: "coral" as const,
        note: "You can change the map colour whenever you like.",
        steps: ["Pinch or use buttons to zoom.", "Drag to pan; reset returns to the default view.", "Change map colour in Settings."],
      },
      {
        t: "View statistics",
        screen: "stats" as const,
        note: "Pull up the sheet on Home to see your travels as clear totals.",
        steps: ["Open the bottom sheet on Home.", "See visit count, world percentage, continents and visited lists."],
      },
      {
        t: "Record regions",
        screen: "home" as const,
        note: "Regional maps are available for eleven supported countries.",
        steps: [
          "Open a supported country and its regional map or list.",
          "Check prefectures, states, provinces and more.",
          "Use counts, rates, filters and share images.",
        ],
      },
      {
        t: "Place search",
        screen: "controls" as const,
        note: "The search index is bundled, so it works offline while travelling.",
        steps: ["Search by city or place name inside regional views.", "Search indexes are bundled and work offline."],
      },
      {
        t: "Move your data",
        screen: "dark" as const,
        note: "Export before changing phones; Colorvia does not sync automatically.",
        steps: [
          "Settings → Data management → export JSON.",
          "Import on a new device to restore countries and regions.",
          "Inconsistent parent countries can be marked visited or regions excluded.",
        ],
      },
      {
        t: "Theme and map colour",
        screen: "dark" as const,
        note: "Choose the appearance that feels best for the way you travel.",
        steps: ["Choose system, light or dark in Settings.", "Pick a map colour that suits you."],
      },
    ];

const faqs = ja
  ? [
      ["base", "Colorviaはどんなアプリですか？", "訪れた国を記録し、世界地図を色づかせる旅の記録アプリです。対応国では都道府県や州まで残せます。"],
      ["base", "無料で使えますか？", "はい。基本機能は無料です。高さに余裕がある端末ではホーム下部にバナー広告が表示される場合があります。現在、広告削除課金はありません。"],
      ["base", "アカウントは必要ですか？", "いいえ。"],
      ["base", "対応環境は？", "iPhone・iOS 18以降向けです。iPad専用の最適化レイアウトは現時点ではありません。"],
      ["country", "地図上で国をタップして追加できますか？", "いいえ。ホームの＋から国選択リストで追加します。地図では拡大・移動・リセットができます。"],
      ["country", "一度に複数の国を選べますか？", "はい。リストで複数にチェックを付けてから確定できます。"],
      ["country", "世界割合はどう計算されますか？", "Colorviaが定義する195か国を基準に計算しています。"],
      ["region", "地域マップとは？", "日本・フランスなど11か国で、都道府県や州など国の中の地域まで訪問を記録できる機能です。"],
      ["region", "どの国に対応していますか？", "日本、フランス、スペイン、韓国、エジプト、タイ、トルコ、アメリカ、マレーシア、ベルギー、シンガポールです。"],
      ["region", "地名から地域を探せますか？", "はい。都市名や地名の検索インデックスがアプリ内にあり、オフラインでも使えます。"],
      ["data", "データはどこに保存されますか？", "訪問国と地域の記録は端末内に保存されます。"],
      ["data", "自動同期できますか？", "現在、iCloudなどを使った端末間の自動同期には対応していません。"],
      ["data", "データをバックアップできますか？", "はい。設定の「データ管理」から、訪問国と地域の訪問記録をJSONファイルとして書き出せます。"],
      ["data", "新しい端末へ復元できますか？", "旧端末で書き出したJSONを、新しい端末のColorviaで読み込むことで、対応する訪問記録を復元できます。"],
      ["data", "JSONには何が含まれますか？", "訪問国、地域の訪問状態、各記録の更新日時などが含まれます。"],
      ["data", "すべてのデータを削除できますか？", "はい。設定のデータ管理から削除できます。"],
      ["display", "テーマや地図色を変えられますか？", "はい。設定からライト／ダーク／システムと地図色を変更できます。"],
      ["display", "共有できますか？", "はい。訪問状況や地域マップの共有用画像を作成できます。"],
      ["net", "オフラインでも使えますか？", "世界地図、訪問国の登録、統計、地域マップ、地名検索、データの書き出し・読み込みなど、主要機能はオフラインで利用できます。"],
      ["net", "通信が必要な操作は？", "広告の取得、広告同意、問い合わせ送信、最新のプライバシーポリシー・利用規約の表示、外部サイトやライセンスページの表示などです。"],
      ["net", "広告は表示されますか？", "はい。Google Mobile Adsによるバナーがホーム下部に出る場合があります。画面高が700pt未満の端末では表示しないことがあります。インタースティシャルやリワード広告はありません。"],
    ]
  : [
      ["base", "What is Colorvia?", "A travel log that colours the countries you visit on a world map, with regional detail in 11 supported countries."],
      ["base", "Is it free?", "Yes. Core features are free. A banner ad may appear on taller devices. There is no remove-ads purchase today."],
      ["base", "Do I need an account?", "No."],
      ["base", "What devices are supported?", "iPhone on iOS 18 or later. There is no iPad-optimized layout yet."],
      ["country", "Can I tap the world map to add a country?", "No. Use Home’s + button and the country list. The map supports zoom, pan and reset only."],
      ["country", "Can I select multiple countries at once?", "Yes. Check several in the list, then confirm."],
      ["country", "How is world percentage calculated?", "Against the 195 countries defined by Colorvia."],
      ["region", "What are regional maps?", "In 11 countries you can mark prefectures, states, provinces and similar units inside the country."],
      ["region", "Which countries are supported?", "Japan, France, Spain, South Korea, Egypt, Thailand, Türkiye, the United States, Malaysia, Belgium and Singapore."],
      ["region", "Can I search by city name?", "Yes. Place-search indexes are bundled and work offline."],
      ["data", "Where is data stored?", "On your device."],
      ["data", "Is there automatic sync?", "Not via iCloud or similar today."],
      ["data", "Can I back up my data?", "Yes. Export visited countries and regions as JSON from Settings → Data management."],
      ["data", "Can I restore on a new phone?", "Import the JSON exported from your previous device."],
      ["data", "What does the JSON include?", "Visited countries, regional visit state and update timestamps."],
      ["data", "Can I delete everything?", "Yes, from Data management in Settings."],
      ["display", "Can I change theme or map colour?", "Yes, in Settings."],
      ["display", "Can I share?", "Yes—share summaries and regional map images."],
      ["net", "Does it work offline?", "Yes for the world map, visit tracking, statistics, regional maps, place search and JSON import/export."],
      ["net", "What needs a network?", "Loading ads, ad consent, support messages, the latest legal documents, and opening external sites or licences."],
      ["net", "Are there ads?", "Yes—a Google Mobile Ads banner may appear on Home on taller screens. No interstitial or rewarded ads."],
    ];

const faqCats = ja
  ? [["all", "すべて"], ["base", "基本"], ["country", "国の記録"], ["region", "地域"], ["data", "データ"], ["display", "表示"], ["net", "通信・広告"]]
  : [["all", "All"], ["base", "Basics"], ["country", "Countries"], ["region", "Regions"], ["data", "Data"], ["display", "Display"], ["net", "Network & ads"]];

const shots = [
  { screen: "home" as const, cap: ["世界地図", "World map"] },
  { screen: "stats" as const, cap: ["統計", "Statistics"] },
  { screen: "controls" as const, cap: ["地図操作", "Map controls"] },
  { screen: "coral" as const, cap: ["地図色", "Map colour"] },
  { screen: "dark" as const, cap: ["ダーク", "Dark"] },
  { screen: "english" as const, cap: ["英語表示", "English UI"] },
] as const;
---

<AppShell lang={lang} title={title} page={page} description={description}>
  <section class:list={["content-page", `content-${page}`]}>
    <header class="content-hero">
      <p class="content-eyebrow">{page.toUpperCase()}</p>
      <h1>{title}</h1>
      {(page === "privacy" || page === "terms") && (
        <div class="legal-dates">
          <p>{ja ? "制定日：2026年7月28日" : "Effective date: July 28, 2026"}</p>
          <p>{ja ? "最終更新日：2026年8月1日" : "Last updated: August 1, 2026"}</p>
        </div>
      )}
    </header>

    {page === "features" && (
      <div class="feature-showcase">
        <header class="feature-showcase-intro">
          <p>{ja ? "旅の記録を、地図の景色に。" : "Turn travel memories into a map."}</p>
          <h2>{ja ? "選ぶ、眺める、振り返る。必要なことを、ひとつの場所に。" : "Choose, explore, and look back—all in one quiet place."}</h2>
        </header>
        {featureGroups.map((g, index) => (
          <article class:list={["feature-story", index % 2 === 1 && "is-reverse"]}>
            <div class="feature-story-copy">
              <span>0{index + 1}</span>
              <h2>{g.h}</h2>
              <ul>{g.items.map((item) => <li>{item}</li>)}</ul>
            </div>
            <div class="feature-story-screen">
              <AppScreen screen={g.screen} size="md" lang={lang} />
            </div>
          </article>
        ))}
        <p class="env-line">
          {ja
            ? `11言語対応：${languagesJa}`
            : `Eleven languages: ${languagesEn}`}
        </p>
      </div>
    )}

    {page === "regions" && (
      <div class="regions-page">
        <p class="lead">
          {ja
            ? "対応している国では、都道府県、州、県、連邦直轄領、旅行エリアなど、国の中で訪れた地域まで記録できます。都市名や地名から該当する地域を検索することもできます。"
            : "In supported countries, record states, prefectures, provinces, federal territories and travel areas. Search by city or place name to find the matching region."}
        </p>
        <div class="region-grid">
          {regions.map((r) => (
            <article class="region-card">
              <span class="region-flag" aria-hidden="true">{r.flag}</span>
              <h2>{ja ? r.nameJa : r.nameEn}</h2>
              <p class="region-unit">{ja ? r.unitJa : r.unitEn}</p>
              <p class="region-count">{ja ? `${r.count} 地域` : `${r.count} regions`}</p>
            </article>
          ))}
        </div>
        <p class="region-disclaimer">
          {ja
            ? "Colorviaの地図や地域区分は、旅の記録を目的として簡略化・整理されています。政治的な立場や主張を示すものではありません。"
            : "Maps and regional divisions in Colorvia are simplified for travel logging and do not express a political position."}
        </p>
      </div>
    )}

    {page === "how-to" && (
      <div class="how-showcase">
        <header class="how-showcase-intro">
          <p>{ja ? "はじめてのColorvia" : "Your first map"}</p>
          <h2>{ja ? "思い出した国から、ひとつずつ色を置いてみましょう。" : "Start by colouring one place you remember."}</h2>
        </header>
        {howGuides.map((g, i) => (
          <article class:list={["how-story", i % 2 === 1 && "is-reverse"]}>
            <div class="how-story-copy">
              <p class="how-story-number">STEP {String(i + 1).padStart(2, "0")}</p>
              <h2>{g.t}</h2>
              <ol>{g.steps.map((s) => <li>{s}</li>)}</ol>
              <aside><span aria-hidden="true">○</span><p>{g.note}</p></aside>
            </div>
            <div class="how-story-screen">
              <AppScreen screen={g.screen} size="md" lang={lang} />
            </div>
          </article>
        ))}
      </div>
    )}

    {page === "screenshots" && (
      <div class="shot-gallery">
        {shots.map((s) => (
          <AppScreen screen={s.screen} size="md" lang={lang} label={s.cap[ja ? 0 : 1]} />
        ))}
      </div>
    )}

    {page === "faq" && (
      <div class="faq-page">
        <nav class="faq-tabs" data-faq-tabs aria-label={ja ? "カテゴリ" : "Categories"}>
          {faqCats.map(([key, label], i) => (
            <button type="button" data-cat={key} aria-current={i === 0 ? "true" : "false"}>{label}</button>
          ))}
        </nav>
        <div class="faq-list" data-faq-list>
          {faqs.map(([cat, q, a], i) => (
            <details data-cat={cat} open={i === 0}>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
        <aside class="faq-contact">
          <h2>{ja ? "解決しない場合" : "Still need help?"}</h2>
          <a href={supportHref} target="_blank" rel="noopener noreferrer">{ja ? "お問い合わせ" : "Contact"} →</a>
        </aside>
      </div>
    )}

    {page === "updates" && <NewsFeed lang={lang} posts={newsPosts} />}

    {(page === "privacy" || page === "terms") && (
      <article class="legal-copy">
        {legal.map(([heading, body]) => (
          <section>
            <h2>{heading}</h2>
            {body.split("\n\n").map((para) => (
              <p>{para.split("\n").map((line) => <>{line}<br /></>)}</p>
            ))}
          </section>
        ))}
      </article>
    )}

    {(page === "features" || page === "how-to" || page === "regions") && (
      <div class="content-cta">
        <span class="store-button store-soon" aria-disabled="true">● <span>{storeLabel}</span></span>
      </div>
    )}
  </section>
</AppShell>

<script is:inline>
  (() => {
    const bindFaq = () => {
      const tabs = document.querySelector("[data-faq-tabs]");
      const list = document.querySelector("[data-faq-list]");
      if (!tabs || !list || tabs.dataset.bound === "1") return;
      tabs.dataset.bound = "1";
      const items = Array.from(list.querySelectorAll("details"));
      tabs.addEventListener("click", (e) => {
        const btn = e.target.closest("button[data-cat]");
        if (!btn) return;
        const cat = btn.getAttribute("data-cat");
        items.forEach((item) => {
          item.hidden = !(cat === "all" || item.getAttribute("data-cat") === cat);
        });
        tabs.querySelectorAll("button").forEach((b) => {
          b.setAttribute("aria-current", String(b.getAttribute("data-cat") === cat));
        });
      });
    };
    document.addEventListener("astro:page-load", bindFaq);
    bindFaq();
  })();
</script>
