---
import { supportHref } from "../lib/links";

type Locale = "ja" | "en";
const { lang, title, page = "" } = Astro.props as { lang: Locale; title: string; page?: string };
const ja = lang === "ja";
/* English is the default locale at the site root; Japanese lives under /ja. */
const base = ja ? "/ja" : "";
const href = (slug: string) => `${base}/${slug}`.replaceAll("//", "/");
const jaPageHref = (`/ja/${page}`.replace(/\/$/, "")) || "/ja";
const enPageHref = `/${page}`.replace(/\/$/, "") || "/";
const labels = ja
  ? { features: "機能", how: "使い方", pricing: "料金", faq: "よくある質問", news: "お知らせ", store: "App Storeで見る", menu: "メニュー" }
  : { features: "Features", how: "How it works", pricing: "Pricing", faq: "FAQ", news: "News", store: "View on App Store", menu: "Menu" };

/* Footer link columns. [label, url, isExternal?] */
const footerCols: { title: string; links: [string, string, boolean?][] }[] = ja
  ? [
      { title: "プロダクト", links: [["機能", href("features")], ["使い方", href("how-to")], ["スクリーンショット", href("screenshots")], ["ウィジェット", href("widgets")], ["料金", href("pricing")]] },
      { title: "サポート", links: [["よくある質問", href("faq")], ["お知らせ", href("updates")], ["お問い合わせ", supportHref("ja"), true]] },
      { title: "規約", links: [["プライバシーポリシー", href("privacy")], ["利用規約", href("terms")]] },
      { title: "Tomokichi", links: [["Tomokichi", "https://tmkch.io/ja", true], ["ほかのアプリ", "https://tmkch.io/ja/apps", true]] },
    ]
  : [
      { title: "Product", links: [["Features", href("features")], ["How it works", href("how-to")], ["Screenshots", href("screenshots")], ["Widgets", href("widgets")], ["Pricing", href("pricing")]] },
      { title: "Support", links: [["FAQ", href("faq")], ["News", href("updates")], ["Contact", supportHref("en"), true]] },
      { title: "Legal", links: [["Privacy Policy", href("privacy")], ["Terms of Service", href("terms")]] },
      { title: "Tomokichi", links: [["Tomokichi", "https://tmkch.io", true], ["Other apps", "https://tmkch.io/apps", true]] },
    ];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={title} />
    <link rel="icon" type="image/png" href="/assets/remeet-icon.png" />
    <title>{title} — Remeet</title>
  </head>
  <body>
    <div class="mock-page">
      <header class="mock-header">
        <div class="mock-header-inner">
          <a class="mock-logo" href={ja ? "/ja" : "/"}><img src="/assets/remeet-icon.png" alt="" /> Remeet</a>
          <nav aria-label="Main navigation">
            <a class:list={{ active: page === "features" }} href={href("features")}>{labels.features}</a>
            <a class:list={{ active: page === "how-to" }} href={href("how-to")}>{labels.how}</a>
            <a class:list={{ active: page === "pricing" }} href={href("pricing")}>{labels.pricing}</a>
            <a class:list={{ active: page === "faq" }} href={href("faq")}>{labels.faq}</a>
            <a class:list={{ active: page === "updates" }} href={href("updates")}>{labels.news}</a>
          </nav>
          <div class="mock-actions">
            <div class="lang-switch">
              <a class:list={{ active: !ja }} href={enPageHref} aria-label="English">EN</a>
              <span class="lang-sep">/</span>
              <a class:list={{ active: ja }} href={jaPageHref} aria-label="日本語">JA</a>
            </div>
            <a class="appstore-pill" href="#download">{labels.store}</a>
            <button class="mobile-menu" type="button" aria-label={labels.menu}>☰</button>
          </div>
        </div>
      </header>
      <main><slot /></main>
      <footer class="mock-footer">
        <div class="footer-brand">
          <a class="mock-logo" href={ja ? "/ja" : "/"}><img src="/assets/remeet-icon.png" alt="" /> Remeet</a>
          <p>{ja ? "再会までの時間を、特別な思い出に。" : "Make the wait part of your story."}</p>
        </div>
        <div class="footer-cols">
          {footerCols.map((col) => (
            <nav aria-label={col.title}>
              <h2>{col.title}</h2>
              {col.links.map(([label, url, external]) => (
                <a href={url} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{label}</a>
              ))}
            </nav>
          ))}
        </div>
        <div class="footer-base">
          <small>© 2026 Remeet</small>
          <p class="made-with">Made with ♡ by Tomokichi</p>
        </div>
      </footer>
    </div>
    <script is:inline>
      (() => {
        const header = document.querySelector(".mock-header");
        if (header) {
          let scheduled = false;
          const syncHeader = () => {
            header.classList.toggle("is-compact", window.scrollY > 96);
            scheduled = false;
          };
          window.addEventListener(
            "scroll",
            () => {
              if (!scheduled) {
                scheduled = true;
                requestAnimationFrame(syncHeader);
              }
            },
            { passive: true },
          );
          syncHeader();
        }

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const items = document.querySelectorAll(
          ".landing-sections section, .feature-grid article, .step-grid article, .subpage > :not(.page-intro):not(.page-hero), .home-notice",
        );

        if (reduceMotion || !("IntersectionObserver" in window)) {
          items.forEach((item) => {
            item.classList.add("is-visible");
          });
          return;
        }

        items.forEach((item, index) => {
          item.classList.add("reveal-item");
          item.style.setProperty("--reveal-delay", `${(index % 6) * 45}ms`);
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -7% 0px" },
        );
        items.forEach((item) => {
          observer.observe(item);
        });
      })();
    </script>
  </body>
</html>
