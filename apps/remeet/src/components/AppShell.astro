---
import AppSiteShell from "@tomokichi/app-site/AppSiteShell.astro";
import { appSiteUrl, mainSiteUrl } from "@tomokichi/app-site/urls";
import { supportHref } from "../lib/links";

type Locale = "ja" | "en";
const { lang, title, page = "", description } = Astro.props as {
  lang: Locale;
  title: string;
  page?: string;
  description?: string;
};
const ja = lang === "ja";
const base = ja ? "/ja" : "";
const href = (slug: string) => `${base}/${slug}`.replaceAll("//", "/");
const jaPageHref = (`/ja/${page}`.replace(/\/$/, "")) || "/ja";
const enPageHref = `/${page}`.replace(/\/$/, "") || "/";
const labels = ja
  ? { features: "機能", how: "使い方", pricing: "料金", faq: "よくある質問", news: "お知らせ" }
  : { features: "Features", how: "How it works", pricing: "Pricing", faq: "FAQ", news: "News" };
const nav = [
  { slug: "features", label: labels.features, href: href("features") },
  { slug: "how-to", label: labels.how, href: href("how-to") },
  { slug: "pricing", label: labels.pricing, href: href("pricing") },
  { slug: "faq", label: labels.faq, href: href("faq") },
  { slug: "updates", label: labels.news, href: href("updates") },
];
const footerColumns = ja
  ? [
      { title: "プロダクト", links: [{ label: "機能", href: href("features") }, { label: "使い方", href: href("how-to") }, { label: "スクリーンショット", href: href("screenshots") }, { label: "ウィジェット", href: href("widgets") }, { label: "料金", href: href("pricing") }] },
      { title: "サポート", links: [{ label: "よくある質問", href: href("faq") }, { label: "お知らせ", href: href("updates") }, { label: "お問い合わせ", href: supportHref("ja"), external: true }] },
      { title: "規約", links: [{ label: "プライバシーポリシー", href: href("privacy") }, { label: "利用規約", href: href("terms") }] },
      { title: "Tomokichi", links: [{ label: "Tomokichi", href: mainSiteUrl("ja"), external: true }, { label: "ほかのアプリ", href: mainSiteUrl("ja", "/apps"), external: true }] },
    ]
  : [
      { title: "Product", links: [{ label: "Features", href: href("features") }, { label: "How it works", href: href("how-to") }, { label: "Screenshots", href: href("screenshots") }, { label: "Widgets", href: href("widgets") }, { label: "Pricing", href: href("pricing") }] },
      { title: "Support", links: [{ label: "FAQ", href: href("faq") }, { label: "News", href: href("updates") }, { label: "Contact", href: supportHref("en"), external: true }] },
      { title: "Legal", links: [{ label: "Privacy Policy", href: href("privacy") }, { label: "Terms of Service", href: href("terms") }] },
      { title: "Tomokichi", links: [{ label: "Tomokichi", href: mainSiteUrl("en"), external: true }, { label: "Other apps", href: mainSiteUrl("en", "/apps"), external: true }] },
    ];
const metaDescription = description ?? (ja
  ? "Remeetは、大切な人との次の再会までを、思い出とともに楽しむためのアプリです。"
  : "Remeet makes the wait until your next reunion part of the story.");
---

<AppSiteShell
  lang={lang}
  title={title}
  description={metaDescription}
  page={page}
  brand="Remeet"
  logoImage="/assets/remeet-icon.png"
  ogImage="/assets/sky-vase.png"
  tagline={ja ? "再会までの時間を、特別な思い出に。" : "Make the wait part of your story."}
  siteUrl={appSiteUrl("remeet")}
  homeHref={ja ? "/ja" : "/"}
  jaPageHref={jaPageHref}
  enPageHref={enPageHref}
  nav={nav}
  footerColumns={footerColumns}
  appStoreLabel={ja ? "App Storeで見る" : "View on App Store"}
  menuLabel={ja ? "メニュー" : "Menu"}
  pageClass="remeet-page"
>
  <slot />
  <script is:inline>
    (() => {
      const items = document.querySelectorAll(
        ".landing-sections section, .feature-grid article, .step-grid article, .subpage > :not(.page-intro):not(.page-hero), .app-hero-notice",
      );
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
        items.forEach((item) => {
          item.classList.add("is-visible");
        });
        return;
      }
      items.forEach((item, index) => {
        item.classList.add("reveal-item");
        item.style.setProperty("--reveal-delay", `${(index % 6) * 45}ms`);
      });
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -7% 0px" },
      );
      items.forEach((item) => {
        observer.observe(item);
      });
    })();
  </script>
</AppSiteShell>
