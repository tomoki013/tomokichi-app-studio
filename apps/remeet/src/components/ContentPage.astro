---
import AppShell from "./AppShell.astro";

type Locale = "ja" | "en";
type Page = "features" | "how-to" | "screenshots" | "widgets" | "pricing" | "faq" | "privacy" | "terms" | "updates";
const { lang, page } = Astro.props as { lang: Locale; page: Page };
const ja = lang === "ja";

const titleMap: Record<Page, [string, string]> = {
  features: ["Remeetの主な機能", "Main features of Remeet"],
  "how-to": ["使い方はとても簡単", "Simple to get started"],
  screenshots: ["スクリーンショット", "Screenshots"],
  widgets: ["ウィジェットでも\nいつでも確認", "Stay close with widgets"],
  pricing: ["料金・プラン", "Pricing & plans"],
  faq: ["よくある質問", "Frequently asked questions"],
  privacy: ["プライバシーポリシー", "Privacy Policy"],
  terms: ["利用規約", "Terms of Service"],
  updates: ["アップデート情報", "Updates"],
};
const subtitleMap: Partial<Record<Page, [string, string]>> = {
  features: ["再会までの時間を、もっと意味のあるものに。", "Make the time until your reunion more meaningful."],
  "how-to": ["たった4ステップで、すぐに始められます。", "Start in just four simple steps."],
  screenshots: ["美しく、シンプルで、使いやすいデザイン。", "Beautiful, simple, and easy to use."],
  widgets: ["ホーム画面やロック画面から、再会までの時間をすぐにチェック。", "Check your countdown from the Home Screen or Lock Screen."],
  pricing: ["あなたのペースに合わせて選べるプラン。", "Choose the plan that fits your pace."],
  faq: ["Remeetについて、よくいただくご質問。", "Answers to common questions about Remeet."],
  updates: ["新機能や改善内容をお知らせします。", "See new features and improvements."],
};

const features = ja
  ? [
      ["◴", "再会までのカウントダウン", "再会の日までをカウントダウン。進捗とメッセージで、期待が少しずつ高まります。"],
      ["▧", "待っている間の記録", "写真・日記・思い出を記録して、離れている時間もかけがえのない思い出に。"],
      ["♡", "あったらやりたいこと", "一緒にしたいことをリスト化。次の再会をもっと楽しみにできます。"],
      ["▣", "複数の再会予定を管理", "旅行や帰省など、複数の再会予定をまとめて管理できます。"],
      ["◰", "ウィジェット対応", "ホーム画面やロック画面で、いつでも再会までの時間を確認できます。"],
      ["◎", "多言語対応", "日本語・英語・フランス語・韓国語・スペイン語・中国語に対応。"],
    ]
  : [
      ["◴", "Reunion countdown", "Count down with progress and thoughtful messages as the moment draws closer."],
      ["▧", "Memories while apart", "Keep photos, journals and memories so time apart becomes part of your story."],
      ["♡", "Things to do together", "Build a shared list and make the next reunion even more exciting."],
      ["▣", "Multiple reunion plans", "Keep trips, visits and multiple upcoming reunions in one place."],
      ["◰", "Widget support", "See the countdown anytime from your Home Screen or Lock Screen."],
      ["◎", "Multilingual", "Available in Japanese, English, French, Korean, Spanish and Chinese."],
    ];

const steps = ja
  ? [
      ["再会の予定を作成", "再会の日付と出会いの場所を設定します。", "/assets/world-route.png"],
      ["日々を記録する", "写真や日記を追加して、思い出を可視化。思い出として残します。", "/assets/memories-board.png"],
      ["やりたいことを集める", "一緒にしたいことリストを追加。次の目的がもっと楽しみに。", "/assets/ideas-board.png"],
      ["再会の日を迎える", "カウントダウンがゼロになったら、再会の合図を。", "/assets/heart-balloons.png"],
    ]
  : [
      ["Create a reunion", "Set the date and the places where you will meet again.", "/assets/world-route.png"],
      ["Record each day", "Add photos and journals to make your memories visible.", "/assets/memories-board.png"],
      ["Collect things to do", "Build a shared list and look forward to your next adventure.", "/assets/ideas-board.png"],
      ["Meet again", "When the countdown reaches zero, it is finally time to reunite.", "/assets/heart-balloons.png"],
    ];

const faqs = ja
  ? [
      ["無料でも使えますか？", "はい、基本機能はすべて無料でご利用いただけます。プレミアムでは、より便利にご利用いただける機能を提供しています。"],
      ["データはどこに保存されますか？", "大切な記録は安全に保存され、端末間でも引き継げます。"],
      ["機種変更してもデータは残りますか？", "アカウント連携を行うことで、新しい端末へデータを移行できます。"],
      ["オフラインでも使えますか？", "一部の機能を除き、記録の閲覧や編集はオフラインでもご利用いただけます。"],
      ["プレミアムの解約はできますか？", "App Storeのサブスクリプション設定からいつでも解約できます。"],
    ]
  : [
      ["Can I use Remeet for free?", "Yes. All essential features are free. Premium adds extra ways to personalise and organise your experience."],
      ["Where is my data stored?", "Your important memories are stored securely and can be carried across devices."],
      ["Will my data remain after changing phones?", "Connect your account to transfer your data safely to a new device."],
      ["Can I use it offline?", "Most records can be viewed and edited offline, with a few exceptions."],
      ["Can I cancel Premium?", "You can cancel anytime from your App Store subscription settings."],
    ];

const legal = {
  privacy: ja
    ? [
        ["1. はじめに", "本ポリシーは、運営者（Tomokichi）が提供するiOSアプリケーション「Remeet」および本ウェブサイト（以下あわせて「本サービス」）における、利用者情報の取扱いについて定めるものです。本ウェブサイトに掲載する内容を正本とし、本アプリ内からは本ウェブサイトを参照します。"],
        ["2. 運営者情報", "本サービスは、運営者（Tomokichi）が個人で開発・運営しています。お問い合わせ先は本ページ末尾に記載しています。"],
        ["3. 適用範囲", "本ポリシーは、本アプリの利用および本ウェブサイトの閲覧に関して適用されます。"],
        ["4. 基本方針", "本アプリはアカウント登録を必要とせず、利用者が入力・撮影した情報は、原則として利用者の端末内にのみ保存されます。運営者は、利用者の記録内容を収集・閲覧できるサーバーを保有しておらず、広告配信や行動解析のためのSDKは組み込んでいません。"],
        ["5. 端末内に保存する情報", "本アプリは、利用者が入力または選択した次の情報を、端末内のデータベースおよびApp Group領域に保存します。\n\n・再会予定の名称、離れ始めた日時、再会日時、メモ\n・自分・相手・待ち合わせ場所の地名、緯度経度、タイムゾーン\n・「会ったらやりたいこと」の項目と完了状態\n・待っている間の記録および再会記録の写真、日付、メモ、感想、5段階評価\n・通知のオン／オフなどのアプリ設定\n\nこれらはウィジェット表示のため同一開発者のApp Group内で共有されますが、端末外へは送信されません。"],
        ["6. 外部サーバーへ送信される情報", "本アプリが外部と通信を行うのは、次の場合に限られます。いずれも再会予定の名称や写真、メモなど利用者の記録内容は含みません。\n\n(1) 天気の取得：登録された場所の緯度経度を、天気情報の取得のためOpen-Meteo（open-meteo.com）へ送信します。氏名や端末識別子は送信しません。\n\n(2) 地名の検索・現在地の地名変換：入力された検索語または取得した座標を、Appleのジオコーディング機能へ送信します。取扱いはAppleのプライバシーポリシーに従います。\n\n(3) 法的文書の表示：プライバシーポリシー・利用規約の最新版を表示するため、本ウェブサイトへ通信します。"],
        ["7. 端末の機能へのアクセス", "本アプリは次の機能を、利用者の許可を得たうえで、以下の目的にのみ使用します。許可はiOSの「設定」からいつでも変更・取消できます。\n\n・カメラ：再会の瞬間を写真として残すために使用します。\n・写真ライブラリ：再会までの思い出と再会の写真を残すために使用します。\n・位置情報：現在地を再会予定の場所として簡単に入力するために使用します。「現在地を使う」を押したときにのみ一度だけ取得し、継続的な追跡は行いません。\n・カレンダー：再会予定をカレンダーへ追加するために使用します。利用者が明示的に操作した場合にのみ書き込み、既存の予定を読み取ることはありません。"],
        ["8. 第三者提供", "運営者は、利用者の情報を第三者へ販売、貸与または提供しません。ただし、法令に基づく開示請求があった場合を除きます。"],
        ["9. 保存期間と削除", "端末内の情報は、利用者が削除するまで保存されます。個々の記録は各画面から、すべてのデータはアプリ内の設定画面から削除できます。本アプリをアンインストールした場合、端末内に保存された情報は削除され、運営者が復旧することはできません。"],
        ["10. データの持ち出し", "アプリ内の設定画面から、保存されている情報をJSON形式で書き出すことができます。書き出したファイルの管理は利用者の責任において行ってください。"],
        ["11. 安全管理措置", "本アプリはアカウント登録を必要としないため、パスワードなどの認証情報を取り扱いません。端末内の情報は、iOSの標準的なセキュリティ機構のもとで保護されます。"],
        ["12. 未成年者の利用", "未成年の方が本アプリを利用する場合は、保護者の同意を得たうえでご利用ください。"],
        ["13. 本ポリシーの変更", "法令の改正または本アプリの機能変更に伴い、本ポリシーを変更する場合があります。重要な変更を行う場合は、本アプリ内または本ウェブサイトにて周知します。変更後の内容は、掲載された時点から適用されます。"],
        ["14. お問い合わせ", "本ポリシーおよび個人情報の取扱いに関するお問い合わせは、support@tmkch.io までご連絡ください。"],
      ]
    : [
        ["1. Introduction", "This policy sets out how the operator (Tomokichi) handles user information across the iOS application \"Remeet\" and this website (together, the \"Service\"). This website is the authoritative version; the App refers back to it."],
        ["2. About the operator", "The Service is developed and operated by an individual, the operator (Tomokichi). Contact details are listed at the end of this page."],
        ["3. Scope", "This policy applies to use of the app and browsing of this website."],
        ["4. Basic policy", "The app does not require account registration. Information you enter or capture is stored only on your device, in principle. The operator does not operate any server that can collect or view your records, and no advertising or analytics SDKs are included."],
        ["5. Information stored on your device", "The app stores the following information you enter or choose, in an on-device database and an App Group container.\n\n・Reunion plan names, the date you started being apart, the reunion date, and notes\n・Place names, coordinates and time zones for you, your partner, and the meeting place\n・Items on your shared wish list and their completed status\n・Photos, dates, notes, impressions and a 5-star rating for waiting-period and reunion records\n・App settings such as notification on/off\n\nThis data is shared within the developer's App Group so it can appear in widgets, but it is never sent off your device."],
        ["6. Information sent to external servers", "The app communicates externally only in the following cases. None of these include your recorded content such as plan names, photos or notes.\n\n(1) Weather: the coordinates of a saved place are sent to Open-Meteo (open-meteo.com) to fetch current weather. No name or device identifier is sent.\n\n(2) Place search and reverse geocoding: a search term you enter, or coordinates obtained from the device, are sent to Apple's geocoding service. Handling follows Apple's own privacy policy.\n\n(3) Legal documents: the app connects to this website to display the latest Privacy Policy and Terms of Service."],
        ["7. Access to device features", "With your permission, the app uses the following features only for the stated purpose. You can change or revoke permission at any time from iOS Settings.\n\n・Camera: to capture photos of the reunion moment.\n・Photo library: to save memories and reunion photos.\n・Location: to make it easy to enter your current place as a reunion location. It is read once, only when you tap \"Use current location\", and is never tracked continuously.\n・Calendar: to add a reunion plan to your calendar. It only writes an entry when you explicitly choose to, and never reads existing events."],
        ["8. Disclosure to third parties", "The operator does not sell, lend or otherwise disclose your information to third parties, except where required by law."],
        ["9. Retention and deletion", "Information stored on your device is kept until you delete it. Individual records can be deleted from their respective screens, and all data can be deleted from the app's settings screen. Uninstalling the app deletes the information stored on your device, and the operator cannot recover it."],
        ["10. Exporting your data", "From the app's settings screen, you can export your stored information as a JSON file. You are responsible for managing any file you export."],
        ["11. Security measures", "Because the app does not require an account, it does not handle authentication credentials such as passwords. Information on your device is protected by iOS's standard security mechanisms."],
        ["12. Use by minors", "If a minor uses the app, please do so with the consent of a parent or guardian."],
        ["13. Changes to this policy", "This policy may be revised in response to changes in law or to the app's functionality. Material changes will be announced within the app or on this website, and take effect once published."],
        ["14. Contact", "For questions about this policy or how your information is handled, please contact support@tmkch.io."],
      ],
  terms: ja
    ? [
        ["第1条（適用）", "本規約は、運営者（Tomokichi）が提供するiOSアプリケーション「Remeet」（以下「本アプリ」）および本ウェブサイト（あわせて「本サービス」）の利用条件を定めるものです。本ウェブサイトに掲載する内容を正本とし、本アプリ内からは本ウェブサイトを参照します。利用者は、本アプリをダウンロードまたは本サービスを利用した時点で、本規約に同意したものとみなされます。"],
        ["第2条（本サービスの内容）", "本アプリは、大切な人との再会予定、会ったらやりたいこと、写真やメモ、再会の記録を、利用者の端末上で作成・保存・閲覧するための機能を提供します。本アプリはアカウント登録を必要とせず、利用者間でデータを共有する機能は提供していません。"],
        ["第3条（利用料金）", "本アプリは無料で提供されます。ただし、通信に必要な費用（パケット通信料等）は利用者の負担とします。"],
        ["第4条（利用者の責任）", "利用者は、自己の責任において本サービスを利用するものとし、入力する情報について必要な権利を有していることを保証します。第三者が写り込んだ写真等を保存する場合は、当該第三者の権利に配慮するものとします。"],
        ["第5条（禁止事項）", "利用者は、本サービスの利用にあたり、次の行為をしてはなりません。\n\n1. 法令または公序良俗に違反する行為\n2. 運営者または第三者の権利、財産、名誉、プライバシーを侵害する行為\n3. 本アプリの複製、改変、逆コンパイル、逆アセンブルその他のリバースエンジニアリング\n4. 本サービスの運営を妨害し、または不正にアクセスする行為\n5. その他、運営者が不適切と合理的に判断する行為"],
        ["第6条（知的財産権）", "本サービスおよびこれに含まれるプログラム、デザイン、文章、画像等に関する著作権その他の知的財産権は、運営者または正当な権利者に帰属します。利用者が本アプリ内で作成・保存した記録の権利は、利用者に帰属します。"],
        ["第7条（データの管理とバックアップ）", "本アプリのデータは利用者の端末内に保存されます。利用者は、必要に応じてアプリ内の設定画面から自らバックアップを作成するものとします。端末の故障・紛失、本アプリの削除、OSのアップデートその他の事由によるデータの消失について、運営者は責任を負いません。"],
        ["第8条（保証の否認・免責事項）", "運営者は、本サービスが利用者の特定の目的に適合すること、期待する機能・正確性・有用性を有すること、および不具合が生じないことを保証しません。本アプリが表示する天気情報および地名情報は外部サービスから取得したものであり、その正確性・完全性を保証しません。運営者は、本サービスの利用によって利用者に生じた損害について、運営者の故意または重過失による場合を除き、責任を負いません。消費者契約法その他の強行法規により運営者の免責が認められない場合、運営者の責任は法令上認められる範囲に限定されます。"],
        ["第9条（本サービスの変更・中断・終了）", "運営者は、事前の通知なく本サービスの内容を変更し、または提供を中断・終了することがあります。重要な変更については、本アプリ内または本ウェブサイトにて周知するよう努めます。"],
        ["第10条（本規約の変更）", "運営者は、必要と判断した場合、本規約を変更することがあります。変更後の規約は、本アプリ内または本ウェブサイトに掲載された時点から効力を生じます。変更後に本サービスを継続して利用した場合、変更に同意したものとみなされます。"],
        ["第11条（準拠法および管轄裁判所）", "本規約の解釈および適用は日本法に準拠します。本サービスに関して運営者と利用者との間で紛争が生じた場合は、東京地方裁判所を第一審の専属的合意管轄裁判所とします。"],
        ["第12条（お問い合わせ）", "本規約に関するお問い合わせは、support@tmkch.io までご連絡ください。"],
      ]
    : [
        ["Article 1 — Application", "These Terms set out the conditions for using the iOS application \"Remeet\" (the \"App\") and this website (together, the \"Service\"), provided by the operator (Tomokichi). This website is the authoritative version; the App refers back to it. You are deemed to have agreed to these Terms once you download the App or otherwise use the Service."],
        ["Article 2 — The Service", "The App lets you create, store and view reunion plans, a shared wish list, photos, notes and reunion records on your own device. The App does not require account registration and does not offer any feature for sharing data between users."],
        ["Article 3 — Fees", "The App is provided free of charge. You are responsible for any data or communication charges incurred while using it."],
        ["Article 4 — User responsibility", "You are responsible for your own use of the Service and warrant that you hold any rights necessary for the information you enter. When saving photos that include third parties, please be considerate of their rights."],
        ["Article 5 — Prohibited conduct", "You must not:\n\n1. Violate any law or public order and morals\n2. Infringe the rights, property, reputation or privacy of the operator or any third party\n3. Copy, modify, decompile, disassemble or otherwise reverse-engineer the App\n4. Interfere with the operation of, or gain unauthorised access to, the Service\n5. Engage in any other conduct the operator reasonably considers inappropriate"],
        ["Article 6 — Intellectual property", "Copyright and other intellectual property rights in the Service and the programs, design, text and images it contains belong to the operator or the relevant rights holders. Rights to records you create and store within the App belong to you."],
        ["Article 7 — Data management and backup", "App data is stored on your device. You are responsible for creating your own backups from the app's settings screen when needed. The operator is not liable for loss of data caused by device failure or loss, uninstalling the App, OS updates, or other such events."],
        ["Article 8 — Disclaimer", "The operator does not warrant that the Service will suit any particular purpose, that it will have any expected functionality, accuracy or usefulness, or that it will be free of defects. Weather and place-name information shown by the App comes from external services, and its accuracy and completeness are not guaranteed. Except where caused by the operator's willful misconduct or gross negligence, the operator is not liable for damages arising from your use of the Service. Where the Consumer Contract Act or other mandatory law does not permit this disclaimer, the operator's liability is limited to the extent permitted by law."],
        ["Article 9 — Changes, suspension and termination", "The operator may change the content of the Service, or suspend or discontinue it, without prior notice. The operator will endeavor to announce material changes within the App or on this website."],
        ["Article 10 — Changes to these Terms", "The operator may revise these Terms when considered necessary. Revised Terms take effect once posted within the App or on this website. Continued use of the Service after a revision constitutes acceptance of it."],
        ["Article 11 — Governing law and jurisdiction", "These Terms are governed by the laws of Japan. Any dispute relating to the Service shall be subject to the exclusive jurisdiction of the Tokyo District Court as the court of first instance."],
        ["Article 12 — Contact", "For questions about these Terms, please contact support@tmkch.io."],
      ],
};
const title = titleMap[page][ja ? 0 : 1];
const subtitle = subtitleMap[page]?.[ja ? 0 : 1];
---

<AppShell lang={lang} title={title} page={page}>
  <section class:list={["subpage", `subpage-${page}`]}>
    <header class="page-intro">
      <h1>{title.split("\n").map((line) => <>{line}<br /></>)}</h1>
      {subtitle && <p>{subtitle}</p>}
      {(page === "privacy" || page === "terms") && <small>{ja ? "制定日：2026年7月24日／最終更新日：2026年7月24日" : "Effective: July 24, 2026 / Last updated: July 24, 2026"}</small>}
    </header>

    {page === "features" && <><div class="feature-page-grid">{features.map(([icon, heading, body]) => <article><span>{icon}</span><div><h2>{heading}</h2><p>{body}</p></div></article>)}</div><a class="orange-cta" href={ja ? "/how-to" : "/en/how-to"}>{ja ? "すべての機能を見る" : "Explore all features"} →</a></>}

    {page === "how-to" && <><div class="how-page-list">{steps.map(([heading, body, image], i) => <article><b>{i + 1}</b><div><h2>{heading}</h2><p>{body}</p></div><img src={image} alt="" /></article>)}</div><a class="orange-cta" href="#download">{ja ? "今すぐ始める" : "Get started"}</a></>}

    {page === "screenshots" && <div class="screens-stage"><div class="ghost-card left"></div><img src="/assets/app-phone.png" alt="Remeet app screen" /><div class="ghost-card right"></div><button aria-label="Previous">‹</button><button aria-label="Next">›</button><div class="carousel-dots">●　○ ○ ○ ○</div></div>}

    {page === "widgets" && <div class="single-showcase"><img src="/assets/widget-showcase.png" alt="Remeet Home Screen and Lock Screen widgets" /></div>}

