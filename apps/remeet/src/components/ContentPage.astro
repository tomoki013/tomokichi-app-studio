---
import {
  faqs as faqList,
  features as featureList,
  guides as guideList,
  icons,
  type Locale,
  type Page,
  pageDescriptions,
  pick,
  privacySections,
  steps as stepList,
  subtitleMap,
  termsSections,
  titleMap,
} from "../lib/content";
import { supportHref } from "../lib/links";
import AppShell from "./AppShell.astro";

const { lang, page } = Astro.props as { lang: Locale; page: Page };
const ja = lang === "ja";
const title = pick(ja, titleMap[page]);
const subtitle = subtitleMap[page] ? pick(ja, subtitleMap[page]!) : undefined;
const description = pageDescriptions[page] ? pick(ja, pageDescriptions[page]!) : undefined;
const features = featureList(ja);
const steps = stepList(ja);
const guides = guideList(ja);
const faqs = faqList(ja);
const legalSections = page === "privacy" ? privacySections(ja) : page === "terms" ? termsSections(ja) : [];
const legalDate = ja
  ? "制定日：2026年7月24日／最終更新日：2026年8月1日"
  : "Effective date: July 24, 2026 / Last updated: August 1, 2026";

const faqCategories = ja
  ? [["all", "すべて"], ["start", "はじめての方へ"], ["feature", "機能について"], ["data", "データについて"], ["other", "その他"]]
  : [["all", "All"], ["start", "Getting started"], ["feature", "Features"], ["data", "Your data"], ["other", "Other"]];

const planIncludes = ja
  ? [
      "再会予定の作成（数の制限はありません）",
      "待っている間の記録（写真・メモ）",
      "会ったらやりたいことリスト",
      "再会のアルバムと振り返り",
      "ホーム画面・ロック画面のウィジェット",
      "ローカル通知（4種類）",
      "6言語対応",
      "アカウント登録不要",
      "端末内保存",
    ]
  : [
      "Create reunion plans (no limit)",
      "Waiting memories (photos and notes)",
      "List of things you want to do together",
      "Reunion albums and reflections",
      "Home Screen and Lock Screen widgets",
      "Local notifications (four kinds)",
      "Six languages",
      "No account required",
      "On-device storage",
    ];

const screenshots = ja
  ? [
      { src: "/assets/feature-countdown.png", alt: "再会までのカウントダウン画面", label: "カウントダウン" },
      { src: "/assets/feature-map.png", alt: "ルートイラストのホーム画面", label: "ルートイラスト" },
      { src: "/assets/feature-memory.png", alt: "待っている間の記録", label: "待っている間の記録" },
      { src: "/assets/feature-list.png", alt: "会ったらやりたいことリスト", label: "やりたいこと" },
      { src: "/assets/feature-album.png", alt: "再会アルバム", label: "アルバム" },
      { src: "/assets/feature-widget.png", alt: "ホーム画面とロック画面のウィジェット", label: "ウィジェット" },
    ]
  : [
      { src: "/assets/feature-countdown.png", alt: "Reunion countdown screen", label: "Countdown" },
      { src: "/assets/feature-map.png", alt: "Home screen with route illustration", label: "Route illustration" },
      { src: "/assets/feature-memory.png", alt: "Waiting memories", label: "Memories" },
      { src: "/assets/feature-list.png", alt: "Wish list", label: "Wish list" },
      { src: "/assets/feature-album.png", alt: "Reunion album", label: "Album" },
      { src: "/assets/feature-widget.png", alt: "Home Screen and Lock Screen widgets", label: "Widgets" },
    ];

const heroEyebrow: Partial<Record<Page, string>> = {
  features: "FEATURES",
  "how-to": "HOW TO USE",
  pricing: "PRICING",
  faq: "FAQ",
  updates: "NEWS",
  screenshots: "SCREENSHOTS",
  widgets: "WIDGETS",
};

const storeLabel = ja ? "App Storeで近日公開" : "Coming soon on the App Store";
const envLine = ja ? "iPhone・iOS 26以降に対応" : "Requires an iPhone running iOS 26 or later.";
const envNote = ja
  ? "現在のバージョンはiPhone向けです。iPadに最適化されたレイアウトは今後対応予定です。"
  : "The current version is designed for iPhone. An iPad-optimized layout is planned for a future update.";
---

<AppShell lang={lang} title={title} page={page} description={description}>
  <section class:list={["subpage", `subpage-${page}`]}>
    {heroEyebrow[page] ? (
      <header class="page-hero">
        <div class="page-hero-copy">
          <p class="eyebrow">{heroEyebrow[page]}</p>
          <h1>{title}</h1>
          {subtitle && <p class="lead">{subtitle}</p>}
        </div>
        <figure class="hero-art" aria-hidden="true">
          <span class="blob blob-a"></span>
          <span class="blob blob-b"></span>
          {page === "features" && <img src="/assets/app-phone.png" alt="" width="941" height="1672" loading="lazy" decoding="async" />}
          {page === "how-to" && <img src="/assets/feature-countdown.png" alt="" width="941" height="1672" loading="lazy" decoding="async" />}
          {page === "updates" && <img src="/assets/update-showcase.png" alt="" width="1122" height="1402" loading="lazy" decoding="async" />}
          {page === "screenshots" && <img src="/assets/app-phone.png" alt="" width="941" height="1672" loading="lazy" decoding="async" />}
          {page === "widgets" && <img src="/assets/widget-showcase.png" alt="" width="1122" height="1402" loading="lazy" decoding="async" />}
          {page === "faq" && <span class="hero-marks"><b>?</b><i>?</i></span>}
          {page === "pricing" && <img src="/assets/sky-vase.png" alt="" width="1122" height="1402" loading="lazy" decoding="async" />}
        </figure>
      </header>
    ) : (
      <header class="page-intro">
        <h1>{title}</h1>
        {subtitle && <p>{subtitle}</p>}
        {(page === "privacy" || page === "terms") && <small>{legalDate}</small>}
      </header>
    )}

    {page === "features" && (
      <>
        <div class="feature-page-grid">
          {features.map(([icon, heading, body]) => (
            <article>
              <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} /></span>
              <div><h2>{heading}</h2><p>{body}</p></div>
            </article>
          ))}
        </div>
        <p class="env-note feature-env"><strong>{envLine}</strong><br />{envNote}</p>
        <a class="orange-cta" href={ja ? "/ja/how-to" : "/how-to"}>{ja ? "使い方を見る" : "See how it works"} →</a>
      </>
    )}

    {page === "how-to" && (
      <>
        <ol class="step-row">
          {steps.map(([icon, heading, body], i) => (
            <li>
              <span class="step-no">{i + 1}</span>
              <article>
                <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} /></span>
                <h2>{heading}</h2>
                <p>{body}</p>
              </article>
            </li>
          ))}
        </ol>
        <aside class="how-note">
          <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons.bulb} /></span>
          <div>
            <h2>{ja ? "はじめての方へ" : "New to Remeet?"}</h2>
            <p>{ja ? "アカウント登録は必要ありません。データは端末内に保存され、相手との共有機能は v1.0.0 にはありません。" : "No account is needed. Data stays on your device; partner sharing is not part of v1.0.0."}</p>
          </div>
        </aside>
        <section class="guide-block">
          <h2 class="block-title">{ja ? "もっと詳しく" : "In more detail"}</h2>
          <div class="guide-visual-list">
            {guides.map((guide) => (
              <article class="guide-visual">
                <div class="guide-visual-copy">
                  <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[guide.icon]} /></span>
                  <h3>{guide.title}</h3>
                  <ol>{guide.steps.map((item) => <li>{item}</li>)}</ol>
                  {guide.note && <p class="guide-note">{guide.note}</p>}
                </div>
                <figure>
                  <img src={guide.image} alt={guide.imageAlt} width="941" height="1672" loading="lazy" decoding="async" />
                </figure>
              </article>
            ))}
          </div>
        </section>
        <aside class="how-help">
          <p>{ja ? "使い方でわからないことがあれば、よくある質問もご覧ください。" : "If anything is still unclear, the FAQ may help."}</p>
          <a href={ja ? "/ja/faq" : "/faq"}>{ja ? "よくある質問へ" : "Go to the FAQ"} →</a>
        </aside>
        <span class="orange-cta store-soon" aria-disabled="true">{storeLabel}</span>
      </>
    )}

    {page === "screenshots" && (
      <div class="shot-gallery">
        {screenshots.map((shot) => (
          <figure>
            <img src={shot.src} alt={shot.alt} width="941" height="1672" loading="lazy" decoding="async" />
            <figcaption>{shot.label}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {page === "widgets" && (
      <div class="single-showcase">
        <img
          src="/assets/widget-showcase.png"
          alt={ja ? "Remeetのホーム画面とロック画面ウィジェット" : "Remeet Home Screen and Lock Screen widgets"}
          width="1122"
          height="1402"
          loading="lazy"
          decoding="async"
        />
        <p class="showcase-note">
          {ja
            ? "Small / Medium / Large とロック画面に対応。表示内容はウィジェットのサイズによって異なります。"
            : "Supports Small, Medium, Large and Lock Screen families. What’s shown depends on the widget size."}
        </p>
      </div>
    )}

    {page === "pricing" && (
      <>
        <div class="plan-card">
          <p class="plan-label">v1.0.0</p>
          <strong class="plan-price">{ja ? "無料" : "Free"}</strong>
          <div class="plan-message">
            {ja ? (
              <>
                <p>Remeetは無料で利用できます。</p>
                <p>アカウント登録やログインは必要ありません。<br />一部の画面には広告が表示されます。<br />現在、有料プランや広告削除機能は提供していません。</p>
              </>
            ) : (
              <>
                <p>Remeet is free to use.</p>
                <p>No account or sign-in is required.<br />Ads may appear on some screens.<br />Paid plans and ad removal are not currently available.</p>
              </>
            )}
          </div>
          <ul class="plan-list">{planIncludes.map((item) => <li>{item}</li>)}</ul>
          <p class="plan-ad-note">
            {ja
              ? "広告はホームや、件数が増えたやりたいこと・記録の一覧など、待つ体験の一部画面に表示されます。アルバム画面には広告を出しません。"
              : "Ads may appear on Home and on longer wish or memory lists. The album screen is kept free of ads."}
          </p>
          <p class="env-note"><strong>{envLine}</strong><br />{envNote}</p>
          <span class="orange-cta store-soon" aria-disabled="true">{storeLabel}</span>
        </div>
      </>
    )}

    {page === "faq" && (
      <>
        <nav class="faq-tabs" aria-label={ja ? "カテゴリで絞り込み" : "Filter by category"} data-faq-tabs>
          {faqCategories.map(([key, label], i) => (
            <button type="button" data-cat={key} aria-current={i === 0 ? "true" : "false"}>{label}</button>
          ))}
        </nav>
        <div class="faq-layout">
          <div class="faq-list" data-faq-list>
            {faqs.map(([cat, q, a], i) => (
              <details data-cat={cat} open={i === 0}>
                <summary><span class="q">Q.</span>{q}<span class="mark" aria-hidden="true"></span></summary>
                <p set:html={a.replaceAll("\n\n", "<br /><br />")} />
              </details>
            ))}
            <p class="faq-empty" hidden data-faq-empty>{ja ? "このカテゴリの質問はまだありません。" : "No questions in this category yet."}</p>
          </div>
          <aside class="faq-side">
            <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons.mail} /></span>
            <h2>{ja ? "解決しない場合は" : "Still stuck?"}</h2>
            <p>{ja ? "お困りのことがあれば、お気軽にご連絡ください。通常3営業日以内にご返信いたします。" : "If something is still unclear, just get in touch. We usually reply within three business days."}</p>
            <a href={supportHref(lang)} target="_blank" rel="noopener noreferrer">{ja ? "お問い合わせ" : "Contact us"} →</a>
          </aside>
        </div>
      </>
    )}

    {(page === "privacy" || page === "terms") && (
      <article class="legal-copy">
        {legalSections.map(([heading, body]) => (
          <section>
            <h2>{heading}</h2>
            {body.split("\n\n").map((para) => (
              <p>{para.split("\n").map((line) => <>{line}<br /></>)}</p>
            ))}
          </section>
        ))}
      </article>
    )}

    {page === "updates" && (
      <ul class="news-list">
        <li class="news-row" id="site-launch">
          <time datetime="2026-08-01">2026.08.01</time>
          <span class="news-badge release">{ja ? "お知らせ" : "News"}</span>
          <div>
            <p>{ja ? "Remeet公式ブランドサイトを公開しました" : "The official Remeet brand site is now live"}</p>
            <div class="news-body">
              {ja ? (
                <>
                  <p>Remeetの公式ブランドサイトを公開しました。</p>
                  <p>アプリの機能や使い方、よくある質問、プライバシーポリシー、利用規約などをご確認いただけます。</p>
                  <p>Remeetは現在、App Storeでの公開に向けて準備を進めています。</p>
                </>
              ) : (
                <>
                  <p>The official Remeet brand site is now live.</p>
                  <p>You can now explore the app’s features, learn how it works, read frequently asked questions, and review the Privacy Policy and Terms of Service.</p>
                  <p>Remeet is currently being prepared for release on the App Store.</p>
                </>
              )}
            </div>
          </div>
        </li>
      </ul>
    )}
  </section>
</AppShell>

<script is:inline>
  (() => {
    const tabs = document.querySelector("[data-faq-tabs]");
    const list = document.querySelector("[data-faq-list]");
    if (!tabs || !list) return;
    const items = Array.from(list.querySelectorAll("details"));
    const empty = list.querySelector("[data-faq-empty]");

    tabs.addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-cat]");
      if (!btn) return;
      const cat = btn.getAttribute("data-cat");
      let shown = 0;
      items.forEach((item) => {
        const match = cat === "all" || item.getAttribute("data-cat") === cat;
        item.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
      tabs.querySelectorAll("button").forEach((b) => {
        b.setAttribute("aria-current", String(b.getAttribute("data-cat") === cat));
      });
    });
  })();
</script>
