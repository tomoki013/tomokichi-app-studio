---
import { supportHref } from "../lib/links";
import AppShell from "./AppShell.astro";

type Locale = "ja" | "en";
type Page = "features" | "how-to" | "screenshots" | "widgets" | "pricing" | "faq" | "privacy" | "terms" | "updates";
const { lang, page } = Astro.props as { lang: Locale; page: Page };
const ja = lang === "ja";

const titleMap: Record<Page, [string, string]> = {
  features: ["Remeetの機能", "Remeet features"],
  "how-to": ["使い方", "How to use"],
  screenshots: ["スクリーンショット", "Screenshots"],
  widgets: ["ウィジェットでも\nいつでも確認", "Stay close with widgets"],
  pricing: ["料金・プラン", "Pricing & plans"],
  faq: ["よくある質問", "Frequently asked questions"],
  privacy: ["プライバシーポリシー", "Privacy Policy"],
  terms: ["利用規約", "Terms of Service"],
  updates: ["お知らせ", "News"],
};
const subtitleMap: Partial<Record<Page, [string, string]>> = {
  features: ["必要な機能を、シンプルに。\n待つ時間を、そっと支えるために。", "The features you need, kept simple —\nquietly supporting the time you wait."],
  "how-to": ["かんたん4ステップで、\n再会までの記録をはじめられます。", "In four simple steps,\nstart keeping the days until you meet."],
  screenshots: ["美しく、シンプルで、使いやすいデザイン。", "Beautiful, simple, and easy to use."],
  widgets: ["ホーム画面やロック画面から、再会までの時間をすぐにチェック。", "Check your countdown from the Home Screen or Lock Screen."],
  pricing: ["いまのRemeetは、すべて無料です。\nアカウント登録も必要ありません。", "Everything in Remeet is free right now —\nand no account is needed."],
  faq: ["よくいただくご質問をまとめました。\n解決しないときは、お気軽にご連絡ください。", "Answers to the questions we hear most.\nIf something is still unclear, just reach out."],
  updates: ["Remeetからのお知らせと、\nこれから追加していく予定をお届けします。", "News from Remeet, and what we plan\nto add along the way."],
};

/* Thin line icons, drawn with currentColor inside soft tinted tiles. */
const icons: Record<string, string> = {
  countdown: `<circle cx="12" cy="13.5" r="7.5"/><path d="M12 9.5v4l2.4 1.9"/><path d="M9.2 2.8h5.6"/>`,
  album: `<rect x="3.2" y="5.2" width="17.6" height="13.6" rx="2.4"/><circle cx="8.6" cy="10.2" r="1.5"/><path d="M20.4 15.8l-4.9-4.9L10.2 16"/>`,
  wish: `<path d="M12 19.6s-6.9-4.3-6.9-8.8a3.9 3.9 0 016.9-2.5 3.9 3.9 0 016.9 2.5c0 4.5-6.9 8.8-6.9 8.8z"/>`,
  plans: `<path d="M12 3.4l8 4.4-8 4.4-8-4.4z"/><path d="M4 12.2l8 4.4 8-4.4"/><path d="M4 16.4l8 4.4 8-4.4"/>`,
  widget: `<rect x="3.4" y="3.4" width="7.2" height="7.2" rx="2.1"/><rect x="13.4" y="3.4" width="7.2" height="7.2" rx="2.1"/><rect x="3.4" y="13.4" width="7.2" height="7.2" rx="2.1"/><rect x="13.4" y="13.4" width="7.2" height="7.2" rx="2.1"/>`,
  globe: `<circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2"/><path d="M12 3.4c2.6 2.9 2.6 14.3 0 17.2-2.6-2.9-2.6-14.3 0-17.2z"/>`,
  calendar: `<rect x="3.4" y="5" width="17.2" height="15.6" rx="2.4"/><path d="M3.4 10h17.2"/><path d="M8.2 3.4v3.4M15.8 3.4v3.4"/><path d="M12 13.4v4M10 15.4h4"/>`,
  camera: `<path d="M4.2 8.2h2.9l1.5-2.1h6.8l1.5 2.1h2.9a1.2 1.2 0 011.2 1.2v8.5a1.2 1.2 0 01-1.2 1.2H4.2A1.2 1.2 0 013 17.9V9.4a1.2 1.2 0 011.2-1.2z"/><circle cx="12" cy="13.4" r="3.4"/>`,
  checklist: `<path d="M3.8 7.2l1.9 1.9 2.9-2.9"/><path d="M3.8 16.2l1.9 1.9 2.9-2.9"/><path d="M12.6 8h7.6"/><path d="M12.6 17h7.6"/>`,
  reunion: `<path d="M12 4.4l1.7 4.4 4.4 1.7-4.4 1.7L12 16.6l-1.7-4.4L5.9 10.5l4.4-1.7z"/><path d="M18.2 16.4l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/>`,
  mail: `<rect x="3.2" y="5.2" width="17.6" height="13.6" rx="2.4"/><path d="M3.8 6.6l8.2 5.8 8.2-5.8"/>`,
  bulb: `<path d="M9.6 17.2h4.8"/><path d="M10.2 20h3.6"/><path d="M12 3.2a5.9 5.9 0 00-3.4 10.7c.4.3.5.7.5 1.1h5.8c0-.4.1-.8.5-1.1A5.9 5.9 0 0012 3.2z"/>`,
export: `<path d="M12 3.8v10"/><path d="M8.4 10.2l3.6 3.6 3.6-3.6"/><path d="M4.4 15.8v3a1.6 1.6 0 001.6 1.6h12a1.6 1.6 0 001.6-1.6v-3"/>`,
bell: `<path d="M12 3.4a5.4 5.4 0 00-5.4 5.4c0 4.4-1.6 5.8-1.6 5.8h14s-1.6-1.4-1.6-5.8A5.4 5.4 0 0012 3.4z"/><path d="M10.3 18a1.9 1.9 0 003.4 0"/>`,
};

const features = ja
  ? [
      ["countdown", "再会までのカウントダウン", "再会の日までを、日数と進捗で見守ります。\n少しずつ近づいていく感覚が、待つ時間を支えます。"],
      ["album", "待っている間の記録", "写真や日記で、離れている日々を残せます。\n会えない時間も、ふたりの思い出になります。"],
      ["wish", "会ったらやりたいこと", "一緒にしたいことをリストにして共有。\n次に会える日が、もっと楽しみになります。"],
      ["plans", "複数の再会予定", "旅行や帰省など、いくつもの予定を並行して管理。\nそれぞれのカウントダウンを見守れます。"],
      ["widget", "ウィジェット対応", "ホーム画面とロック画面から、\nアプリを開かずに残りの日数を確認できます。"],
      ["globe", "6言語に対応", "日本語・英語・フランス語・韓国語・\nスペイン語・中国語でご利用いただけます。"],
    ]
  : [
      ["countdown", "Reunion countdown", "Watch the days and progress until you meet again.\nFeeling it draw closer is what carries the waiting."],
      ["album", "Memories while apart", "Keep photos and journals from the days in between,\nso time apart becomes part of your story too."],
      ["wish", "Things to do together", "Build a shared list of what you want to do,\nand look forward to the next day you meet."],
      ["plans", "Multiple reunion plans", "Trips, visits and more can run side by side,\neach with its own countdown to follow."],
      ["widget", "Widget support", "See the days remaining from your Home Screen\nand Lock Screen, without opening the app."],
      ["globe", "Six languages", "Available in Japanese, English, French,\nKorean, Spanish and Chinese."],
    ];

const steps = ja
  ? [
      ["calendar", "再会の予定をつくる", "再会の日付と、ふたりがいる場所を設定します。"],
      ["camera", "日々を記録する", "写真や日記を添えて、待っている時間を残します。"],
      ["checklist", "やりたいことを集める", "会ったらしたいことを、ひとつずつリストに。"],
      ["reunion", "再会の日を迎える", "カウントダウンがゼロになったら、その日を記録に。"],
    ]
  : [
      ["calendar", "Create a reunion", "Set the date, and where each of you will be."],
      ["camera", "Record each day", "Add photos and journals from the days of waiting."],
      ["checklist", "Collect things to do", "List what you want to do, one wish at a time."],
      ["reunion", "Meet again", "When the countdown reaches zero, keep that day too."],
    ];

const guides = ja
  ? [
      ["widget", "ウィジェットを追加する", ["ホーム画面の空いているところを長押しします。", "左上の「＋」をタップします。", "「Remeet」を選び、好きなサイズを置きます。"]],
      ["album", "写真や日記を残す", ["「アルバム」タブを開きます。", "「＋」から残したい写真を選びます。", "ひとことメモを添えて保存します。"]],
      ["calendar", "カレンダーに追加する", ["再会予定の詳細を開きます。", "「カレンダーに追加」をタップします。", "初回のみ、カレンダーへのアクセスを許可します。"]],
      ["bell", "通知を設定する", ["「設定」を開きます。", "通知のオン／オフを切り替えます。", "再会が近づくとお知らせが届きます。"]],
      ["export", "データを書き出す", ["「設定」を開きます。", "「データを書き出す」を選びます。", "JSONファイルとして保存・共有できます。"]],
      ["globe", "表示言語を変える", ["iOSの「設定」アプリを開きます。", "「Remeet」を選びます。", "「言語」から表示言語を変更します。"]],
    ]
  : [
      ["widget", "Add a widget", ["Touch and hold an empty area of the Home Screen.", "Tap the “+” in the top-left corner.", "Choose “Remeet” and place the size you like."]],
      ["album", "Keep photos and journals", ["Open the “Album” tab.", "Tap “+” and choose a photo to keep.", "Add a short note and save it."]],
      ["calendar", "Add it to your calendar", ["Open the details of a reunion plan.", "Tap “Add to calendar”.", "Allow calendar access the first time only."]],
      ["bell", "Set up notifications", ["Open “Settings”.", "Turn notifications on or off.", "You’ll be reminded as the day gets closer."]],
      ["export", "Export your data", ["Open “Settings”.", "Choose “Export data”.", "Save or share it as a JSON file."]],
      ["globe", "Change the language", ["Open the iOS “Settings” app.", "Select “Remeet”.", "Change the display language under “Language”."]],
    ];

const faqCategories = ja
  ? [["all", "すべて"], ["start", "はじめての方へ"], ["feature", "機能について"], ["data", "データについて"], ["other", "その他"]]
  : [["all", "All"], ["start", "Getting started"], ["feature", "Features"], ["data", "Your data"], ["other", "Other"]];

const faqs = ja
  ? [
      ["start", "Remeetはどんなアプリですか？", "大切な人と再会する日までをカウントダウンし、その間の思い出を残しておくためのアプリです。離れている時間を、ただ待つだけで終わらせないためにつくりました。"],
      ["start", "アカウント登録は必要ですか？", "必要ありません。アプリを開いてすぐに使い始められます。メールアドレスの入力やログインの手間はありません。"],
      ["start", "無料で使えますか？", "はい。現在のRemeetの機能は、すべて無料でご利用いただけます。"],
      ["feature", "相手と共有できますか？", "現在のバージョンでは、ユーザー間でデータを共有する機能はありません。それぞれの端末で、それぞれの記録として残す形になります。"],
      ["feature", "ウィジェットはどこで使えますか？", "ホーム画面とロック画面の両方に対応しています。アプリを開かなくても、再会までの残り日数を確認できます。"],
      ["data", "データはどこに保存されますか？", "入力・撮影した内容は、原則としてお使いの端末内にのみ保存されます。運営者が記録の内容を閲覧できるサーバーは持っていません。"],
      ["data", "機種変更のときはどうすればいいですか？", "設定画面から、保存されている情報をJSON形式で書き出せます。データは端末内にのみ保存されるため、機種変更の前に書き出しをおすすめします。"],
      ["other", "オフラインでも使えますか？", "天気の取得と地名の検索を除き、記録の閲覧や編集はオフラインでもご利用いただけます。"],
    ]
  : [
      ["start", "What is Remeet?", "An app that counts down to the day you meet someone important again, and keeps the memories made in between. It exists so that time apart is more than just waiting."],
      ["start", "Do I need an account?", "No. You can start using it the moment you open the app — no email address, no sign-in."],
      ["start", "Is it free?", "Yes. Every feature in Remeet today is free to use."],
      ["feature", "Can I share with my partner?", "Not in the current version. There is no data sharing between users; each device keeps its own record."],
      ["feature", "Where do widgets work?", "Both the Home Screen and the Lock Screen, so you can see the days remaining without opening the app."],
      ["data", "Where is my data stored?", "What you enter or capture is stored only on your device, in principle. There is no server where the operator can view your records."],
      ["data", "What if I change phones?", "You can export your stored information as a JSON file from Settings. Because data lives only on your device, exporting before you switch is recommended."],
      ["other", "Can I use it offline?", "Yes — aside from fetching weather and searching place names, viewing and editing your records works offline."],
    ];

const news = ja
  ? [{
      date: "2026.07.24",
      kind: "release",
      badge: "リリース",
      headline: "Remeet 1.0.0 を公開しました",
      points: [
        "再会までのカウントダウン",
        "待っている間の記録（写真・日記）",
        "会ったらやりたいことリスト",
        "ホーム画面・ロック画面のウィジェット",
        "6言語対応",
      ],
    }]
  : [{
      date: "2026.07.24",
      kind: "release",
      badge: "Release",
      headline: "Remeet 1.0.0 is now available",
      points: [
        "Countdown to the day you meet again",
        "Records from the days apart (photos and journals)",
        "A shared list of things to do together",
        "Home Screen and Lock Screen widgets",
        "Available in six languages",
      ],
    }];

const heroEyebrow: Partial<Record<Page, string>> = {
  features: "FEATURES",
  "how-to": "HOW TO USE",
  pricing: "PRICING",
  faq: "FAQ",
  updates: "NEWS",
};

const planIncludes = ja
  ? [
      "再会予定の作成（数の制限はありません）",
      "待っている間の記録（写真・日記）",
      "会ったらやりたいことリスト",
      "ホーム画面・ロック画面のウィジェット",
      "6言語対応",
      "広告表示はありません",
    ]
  : [
      "Create reunion plans (no limit on how many)",
      "Records from the days apart (photos and journals)",
      "A shared list of things to do together",
      "Home Screen and Lock Screen widgets",
      "Available in six languages",
      "No advertising",
    ];

const legal = {
  privacy: ja
    ? [
        ["1. はじめに", "本ポリシーは、運営者（Tomokichi）が提供するiOSアプリケーション「Remeet」および本ウェブサイト（以下あわせて「本サービス」）における、利用者情報の取扱いについて定めるものです。本ウェブサイトに掲載する内容を正本とし、本アプリ内からは本ウェブサイトを参照します。"],
        ["2. 運営者情報", "本サービスは、運営者（Tomokichi）が個人で開発・運営しています。お問い合わせ先は本ページ末尾に記載しています。"],
        ["3. 適用範囲", "本ポリシーは、本アプリの利用および本ウェブサイトの閲覧に関して適用されます。"],
        ["4. 基本方針", "本アプリはアカウント登録を必要とせず、利用者が入力・撮影した情報は、原則として利用者の端末内にのみ保存されます。運営者は、利用者の記録内容を収集・閲覧できるサーバーを保有しておらず、広告配信や行動解析のためのSDKは組み込んでいません。"],
        ["5. 端末内に保存する情報", "本アプリは、利用者が入力または選択した次の情報を、端末内のデータベースおよびApp Group領域に保存します。\n\n・再会予定の名称、離れ始めた日時、再会日時、メモ\n・自分・相手・待ち合わせ場所の地名、緯度経度、タイムゾーン\n・「会ったらやりたいこと」の項目と完了状態\n・待っている間の記録および再会記録の写真、日付、メモ、感想、5段階評価\n・通知のオン／オフなどのアプリ設定\n\nこれらはウィジェット表示のため同一開発者のApp Group内で共有されますが、端末外へは送信されません。"],
        ["6. 外部サーバーへ送信される情報", "本アプリが外部と通信を行うのは、次の場合に限られます。通常のアプリ利用では、再会予定、写真、アルバム、メモ、現在地、やりたいことリストなどの記録内容は原則として端末内に保存されます。\n\n(1) 天気の取得：登録された場所の緯度経度を、天気情報の取得のためOpen-Meteo（open-meteo.com）へ送信します。氏名や端末識別子は送信しません。\n\n(2) 地名の検索・現在地の地名変換：入力された検索語または取得した座標を、Appleのジオコーディング機能へ送信します。取扱いはAppleのプライバシーポリシーに従います。\n\n(3) 法的文書の表示：プライバシーポリシー・利用規約の最新版を表示するため、本ウェブサイトへ通信します。\n\n(4) お問い合わせ：利用者が共通お問い合わせフォームを明示的に送信した場合に限り、名前（入力した場合）、メールアドレス、問い合わせ内容、アプリバージョン、OSバージョン、表示言語、問い合わせ識別子、送信日時等を、回答、不具合調査、サービス改善、不正利用防止のため送信します。写真、再会予定の内容、現在地、アルバム、メモ、やりたいことリストは問い合わせ時にも送信しません。"],
        ["7. 端末の機能へのアクセス", "本アプリは次の機能を、利用者の許可を得たうえで、以下の目的にのみ使用します。許可はiOSの「設定」からいつでも変更・取消できます。\n\n・カメラ：再会の瞬間を写真として残すために使用します。\n・写真ライブラリ：再会までの思い出と再会の写真を残すために使用します。\n・位置情報：現在地を再会予定の場所として簡単に入力するために使用します。「現在地を使う」を押したときにのみ一度だけ取得し、継続的な追跡は行いません。\n・カレンダー：再会予定をカレンダーへ追加するために使用します。利用者が明示的に操作した場合にのみ書き込み、既存の予定を読み取ることはありません。"],
        ["8. 外部サービスと第三者提供", "運営者は、利用者の情報を販売または貸与しません。問い合わせ受付APIの実行基盤としてCloudflare Workersを、メール配送のためResendを利用し、問い合わせに必要な情報は各社の方針に従って処理されます。法令に基づく開示請求があった場合を除き、その他の第三者へ提供しません。"],
        ["9. 保存期間と削除", "端末内の情報は、利用者が削除するまで保存されます。個々の記録は各画面から、すべてのデータはアプリ内の設定画面から削除できます。本アプリをアンインストールした場合、端末内に保存された情報は削除され、運営者が復旧することはできません。お問い合わせは専用データベースへ保存せず、メールとして受信します。"],
        ["10. データの持ち出し", "アプリ内の設定画面から、保存されている情報をJSON形式で書き出すことができます。書き出したファイルの管理は利用者の責任において行ってください。"],
        ["11. 安全管理措置", "本アプリはアカウント登録を必要としないため、パスワードなどの認証情報を取り扱いません。端末内の情報は、iOSの標準的なセキュリティ機構のもとで保護されます。"],
        ["12. 未成年者の利用", "未成年の方が本アプリを利用する場合は、保護者の同意を得たうえでご利用ください。"],
        ["13. 本ポリシーの変更", "法令の改正または本アプリの機能変更に伴い、本ポリシーを変更する場合があります。重要な変更を行う場合は、本アプリ内または本ウェブサイトにて周知します。変更後の内容は、掲載された時点から適用されます。"],
        ["14. お問い合わせ", "本ポリシーおよび個人情報の取扱いに関するお問い合わせは、Tomokichi共通お問い合わせフォームからお送りください。フォームを送信しない限り、問い合わせ情報は送信されません。"],
      ]
    : [
        ["1. Introduction", "This policy sets out how the operator (Tomokichi) handles user information across the iOS application \"Remeet\" and this website (together, the \"Service\"). This website is the authoritative version; the App refers back to it."],
        ["2. About the operator", "The Service is developed and operated by an individual, the operator (Tomokichi). Contact details are listed at the end of this page."],
        ["3. Scope", "This policy applies to use of the app and browsing of this website."],
        ["4. Basic policy", "The app does not require account registration. Information you enter or capture is stored only on your device, in principle. The operator does not operate any server that can collect or view your records, and no advertising or analytics SDKs are included."],
        ["5. Information stored on your device", "The app stores the following information you enter or choose, in an on-device database and an App Group container.\n\n・Reunion plan names, the date you started being apart, the reunion date, and notes\n・Place names, coordinates and time zones for you, your partner, and the meeting place\n・Items on your shared wish list and their completed status\n・Photos, dates, notes, impressions and a 5-star rating for waiting-period and reunion records\n・App settings such as notification on/off\n\nThis data is shared within the developer's App Group so it can appear in widgets, but it is never sent off your device."],
        ["6. Information sent to external servers", "During normal app use, reunion plans, photos, albums, notes, your current location, and wish-list items remain stored on your device in principle. The app communicates externally only in these cases:\n\n(1) Weather: the coordinates of a saved place are sent to Open-Meteo (open-meteo.com) to fetch current weather. No name or device identifier is sent.\n\n(2) Place search and reverse geocoding: a search term you enter, or coordinates obtained from the device, are sent to Apple's geocoding service. Handling follows Apple's own privacy policy.\n\n(3) Legal documents: the app connects to this website to display the latest Privacy Policy and Terms of Service.\n\n(4) Support: only when you explicitly submit the shared support form, your name (if provided), email address, message, app version, OS version, display language, enquiry identifier, submission time, and related details are sent so we can respond, investigate issues, improve the service, and prevent abuse. Photos, reunion plan details, your current location, albums, notes, and wish-list items are not sent with a support enquiry."],
        ["7. Access to device features", "With your permission, the app uses the following features only for the stated purpose. You can change or revoke permission at any time from iOS Settings.\n\n・Camera: to capture photos of the reunion moment.\n・Photo library: to save memories and reunion photos.\n・Location: to make it easy to enter your current place as a reunion location. It is read once, only when you tap \"Use current location\", and is never tracked continuously.\n・Calendar: to add a reunion plan to your calendar. It only writes an entry when you explicitly choose to, and never reads existing events."],
        ["8. Service providers and disclosure", "The operator does not sell or lend your information. Cloudflare Workers provides the support API infrastructure, and Resend delivers support email; information needed for an enquiry is processed under each provider's policies. It is not otherwise disclosed to third parties except where required by law."],
        ["9. Retention and deletion", "Information stored on your device is kept until you delete it. Individual records can be deleted from their respective screens, and all data can be deleted from the app's settings screen. Uninstalling the app deletes the information stored on your device, and the operator cannot recover it. Support enquiries are received by email and are not stored in a dedicated support database."],
        ["10. Exporting your data", "From the app's settings screen, you can export your stored information as a JSON file. You are responsible for managing any file you export."],
        ["11. Security measures", "Because the app does not require an account, it does not handle authentication credentials such as passwords. Information on your device is protected by iOS's standard security mechanisms."],
        ["12. Use by minors", "If a minor uses the app, please do so with the consent of a parent or guardian."],
        ["13. Changes to this policy", "This policy may be revised in response to changes in law or to the app's functionality. Material changes will be announced within the app or on this website, and take effect once published."],
        ["14. Contact", "For questions about this policy or how your information is handled, use the shared Tomokichi support form. Support information is not sent unless you submit the form."],
      ],
  terms: ja
    ? [
        ["第1条（適用）", "本規約は、運営者（Tomokichi）が提供するiOSアプリケーション「Remeet」（以下「本アプリ」）および本ウェブサイト（あわせて「本サービス」）の利用条件を定めるものです。本ウェブサイトに掲載する内容を正本とし、本アプリ内からは本ウェブサイトを参照します。利用者は、本アプリをダウンロードまたは本サービスを利用した時点で、本規約に同意したものとみなされます。"],
