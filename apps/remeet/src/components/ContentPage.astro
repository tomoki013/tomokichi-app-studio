const title = titleMap[page][ja ? 0 : 1];
const subtitle = subtitleMap[page]?.[ja ? 0 : 1];
---

<AppShell lang={lang} title={title} page={page}>
  <section class:list={["subpage", `subpage-${page}`]}>
    {heroEyebrow[page] ? (
      <header class="page-hero">
        <div class="page-hero-copy">
          <p class="eyebrow">{heroEyebrow[page]}</p>
          <h1>{title}</h1>
          {subtitle && <p class="lead">{subtitle}</p>}
        </div>
        <figure class="hero-art" aria-hidden="true">
          <span class="blob blob-a"></span>
          <span class="blob blob-b"></span>
          {page === "features" && <img src="/assets/app-phone.png" alt="" />}
          {page === "how-to" && <img src="/assets/hero-phones.png" alt="" />}
          {page === "updates" && <img src="/assets/update-showcase.png" alt="" />}
          {page === "faq" && <span class="hero-marks"><b>?</b><i>?</i></span>}
        </figure>
      </header>
    ) : (
      <header class="page-intro">
        <h1>{title.split("\n").map((line) => <>{line}<br /></>)}</h1>
        {subtitle && <p>{subtitle}</p>}
        {(page === "privacy" || page === "terms") && <small>{ja ? "制定日：2026年7月24日／最終更新日：2026年7月26日" : "Effective: July 24, 2026 / Last updated: July 26, 2026"}</small>}
      </header>
    )}

    {page === "features" && <><div class="feature-page-grid">{features.map(([icon, heading, body]) => (
      <article>
        <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} /></span>
        <div><h2>{heading}</h2><p>{body}</p></div>
      </article>
    ))}</div><a class="orange-cta" href={ja ? "/ja/how-to" : "/how-to"}>{ja ? "使い方を見る" : "See how it works"} →</a></>}

    {page === "how-to" && <><ol class="step-row">{steps.map(([icon, heading, body], i) => (
      <li>
        <span class="step-no">{i + 1}</span>
        <article>
          <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon]} /></span>
          <h2>{heading}</h2>
          <p>{body}</p>
        </article>
      </li>
    ))}</ol>
    <aside class="how-note">
      <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons.bulb} /></span>
      <div>
        <h2>{ja ? "はじめての方へ" : "New to Remeet?"}</h2>
        <p>{ja ? "アカウント登録は必要ありません。アプリを開いたその日から、再会までの記録をはじめられます。" : "No account is needed. From the day you open the app, you can start keeping the days until you meet again."}</p>
      </div>
    </aside>
    <section class="guide-block">
      <h2 class="block-title">{ja ? "もっと詳しく" : "In more detail"}</h2>
      <div class="guide-grid">
        {guides.map(([icon, heading, list]) => (
          <article>
            <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon as string]} /></span>
            <h3>{heading}</h3>
            <ol>{(list as string[]).map((item) => <li>{item}</li>)}</ol>
          </article>
        ))}
      </div>
    </section>
    <aside class="how-help">
      <p>{ja ? "使い方でわからないことがあれば、よくある質問もご覧ください。" : "If anything is still unclear, the FAQ may help."}</p>
      <a href={ja ? "/ja/faq" : "/faq"}>{ja ? "よくある質問へ" : "Go to the FAQ"} →</a>
    </aside>
    <a class="orange-cta" href="#download">{ja ? "今すぐ始める" : "Get started"}</a></>}

    {page === "screenshots" && <div class="screens-stage"><div class="ghost-card left"></div><img src="/assets/app-phone.png" alt="Remeet app screen" /><div class="ghost-card right"></div><button type="button" aria-label="Previous">‹</button><button type="button" aria-label="Next">›</button><div class="carousel-dots">●　○ ○ ○ ○</div></div>}

    {page === "widgets" && <div class="single-showcase"><img src="/assets/widget-showcase.png" alt="Remeet Home Screen and Lock Screen widgets" /></div>}

    {page === "pricing" && <>
      <div class="plan-card">
        <p class="plan-label">{ja ? "すべての機能" : "Everything included"}</p>
        <strong class="plan-price">{ja ? "無料" : "Free"}</strong>
        <p class="plan-sub">{ja ? "アプリ内課金や、月額の費用はありません。" : "No in-app purchases, no monthly fee."}</p>
        <ul class="plan-list">{planIncludes.map((item) => <li>{item}</li>)}</ul>
        <a class="orange-cta" href="#download">{ja ? "App Storeで見る" : "View on App Store"}</a>
      </div>
      <aside class="how-note">
        <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons.bulb} /></span>
        <div>
          <h2>{ja ? "これから有料の機能を設ける場合" : "If a paid tier is ever added"}</h2>
          <p>{ja ? "追加の機能について有料プランを設ける場合は、本サイトとアプリ内で事前にお知らせします。すでに保存された記録が読めなくなることはありません。" : "If a paid plan is ever introduced for additional features, it will be announced here and in the app beforehand. Records you have already saved will never become unreadable."}</p>
        </div>
      </aside>
    </>}

    {page === "faq" && <>
      <nav class="faq-tabs" aria-label={ja ? "カテゴリで絞り込み" : "Filter by category"} data-faq-tabs>
        {faqCategories.map(([key, label], i) => <button type="button" data-cat={key} aria-current={i === 0 ? "true" : "false"}>{label}</button>)}
      </nav>
      <div class="faq-layout">
        <div class="faq-list" data-faq-list>
          {faqs.map(([cat, q, a], i) => (
            <details data-cat={cat} open={i === 0}>
              <summary><span class="q">Q.</span>{q}<span class="mark" aria-hidden="true"></span></summary>
              <p>{a}</p>
            </details>
          ))}
          <p class="faq-empty" hidden data-faq-empty>{ja ? "このカテゴリの質問はまだありません。" : "No questions in this category yet."}</p>
        </div>
        <aside class="faq-side">
          <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons.mail} /></span>
          <h2>{ja ? "解決しない場合は" : "Still stuck?"}</h2>
          <p>{ja ? "お困りのことがあれば、お気軽にご連絡ください。通常3営業日以内にご返信いたします。" : "If something is still unclear, just get in touch. We usually reply within three business days."}</p>
          <a href={supportHref(lang)} target="_blank" rel="noopener noreferrer">{ja ? "お問い合わせ" : "Contact us"} →</a>
        </aside>
      </div>
    </>}

    {(page === "privacy" || page === "terms") && <article class="legal-copy">{legal[page].map(([heading, body]) => <section><h2>{heading}</h2>{body.split("\n\n").map((para) => <p>{para.split("\n").map((line) => <>{line}<br /></>)}</p>)}</section>)}</article>}


    {page === "updates" && <ul class="news-list">{news.map((item) => (
      <li class="news-row">
        <time>{item.date}</time>
        <span class:list={["news-badge", item.kind]}>{item.badge}</span>
        <div>
          <p>{item.headline}</p>
          <ul class="news-points">{item.points.map((point) => <li>{point}</li>)}</ul>
        </div>
      </li>
    ))}</ul>}
  </section>
</AppShell>

<script is:inline>
  (() => {
    const tabs = document.querySelector("[data-faq-tabs]");
    const list = document.querySelector("[data-faq-list]");
    if (!tabs || !list) return;
    const items = Array.from(list.querySelectorAll("details"));
    const empty = list.querySelector("[data-faq-empty]");

    tabs.addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-cat]");
      if (!btn) return;
      const cat = btn.getAttribute("data-cat");
      let shown = 0;
      items.forEach((item) => {
        const match = cat === "all" || item.getAttribute("data-cat") === cat;
        item.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
      tabs.querySelectorAll("button").forEach((b) => {
        b.setAttribute("aria-current", String(b.getAttribute("data-cat") === cat));
      });
    });
  })();
</script>
