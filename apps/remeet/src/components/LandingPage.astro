---
import AppShell from "./AppShell.astro";

type Locale = "ja" | "en";
const { lang } = Astro.props as { lang: Locale };
const ja = lang === "ja";
const base = ja ? "" : "/en";
const c = ja
  ? {
      title: "再会までの時間を、特別な思い出に。",
      body: "離れている日々を、ふたりの絆がもっと深まる時間に。\n再会までを一緒にカウントダウンして、\n思い出を記録しよう。",
      store: "App Storeからダウンロード",
      notice: "Remeet 1.0.0をリリースしました！",
      features: "Remeetの特徴",
      featureSub: "距離を、やさしくつなぐ機能たち。",
      howTitle: "使い方はかんたん、3ステップ",
      widgetTitle: "ウィジェットで、もっと身近に",
      widgetBody: "ホーム画面やロック画面で、ふたりのつながりをいつでも感じられます。",
      storyTitle: "距離があるから、\nつながりは、もっとやさしくなる。",
      storyBody: "会えない時間は、さみしいだけじゃない。\n思い出を重ねる時間でもある。\nRemeetは、ふたりの心の距離を近づける\n小さなきっかけになりますように。",
      cta: "再会の日を、もっと楽しみに。",
      ctaSub: "Remeetをはじめて、ふたりだけの時間を育てていこう。",
      howLink: "使い方を見る",
    }
  : {
      title: "Make the wait part of your story.",
      body: "Turn days apart into time that brings you closer.\nCount down together and keep every memory\nuntil the day you meet again.",
      store: "Download on the App Store",
      notice: "Remeet 1.0.0 is now available!",
      features: "Remeet features",
      featureSub: "Thoughtful ways to stay close across the distance.",
      howTitle: "Simple to use, in 3 steps",
      widgetTitle: "Always close with widgets",
      widgetBody: "Feel your connection at a glance from your Home Screen or Lock Screen.",
      storyTitle: "Distance can make\nyour connection feel even gentler.",
      storyBody: "Time apart isn’t only about missing someone.\nIt can be time to gather memories, too.\nRemeet offers small moments that bring\ntwo hearts a little closer.",
      cta: "Make the reunion worth the wait.",
      ctaSub: "Start with Remeet and grow the time that belongs to just the two of you.",
      howLink: "See how it works",
    };

const features = ja
  ? [
      ["再会までをカウントダウン", "次に会える日を設定すると、日数と進捗を自動でカウント。楽しみが少しずつ近づきます。"],
      ["ルートでつながる地図", "ふたりの場所を地図でつなぎ、飛行機のルートがやさしく移動。距離を感じさせないデザイン。"],
      ["待っている時間を思い出に", "メモや写真、気持ちの記録を残せます。小さな日常も、大切な思い出になります。"],
      ["会ったらやりたいことリスト", "行きたい場所や、やりたいことを一緒にリスト化。再会の計画がもっと楽しくなります。"],
      ["ウィジェットでいつも一緒に", "ホーム画面やロック画面で、再会までの日数やカードをいつでも確認できます。"],
      ["再会をアルバムに保存", "再会の思い出を写真と一緒にアルバムに。未来のふたりの宝物になります。"],
    ]
  : [
      ["Countdown to reunion", "Set your next meeting date and follow the days and progress automatically as the moment draws closer."],
      ["A map that connects you", "See your places connected by a gentle flight path, making the distance feel a little smaller."],
      ["Turn waiting into memories", "Save notes, photos and feelings. Even ordinary days become part of your shared story."],
      ["Things to do together", "Collect places to go and things to try, so planning the reunion becomes part of the fun."],
      ["Together through widgets", "Keep the countdown and your shared cards close on the Home Screen and Lock Screen."],
      ["Save reunions in albums", "Keep reunion photos together in an album that grows into a treasure for your future."],
    ];
const featureImages = ["countdown", "map", "memory", "list", "widget", "album"];
const steps = ja
  ? [
      ["1", "再会を作る", "ふたりの場所と、次に会える日を設定します。"],
      ["2", "待つあいだに残す", "やりたいことやメモ、写真で日々を記録します。"],
      ["3", "再会を記録する", "会えた日を記録して、思い出をアルバムに残します。"],
      ["4", "思い出として残る", "ふたりだけのストーリーが、未来の宝物になります。"],
    ]
  : [
      ["1", "Create a reunion", "Set both locations and the next date you will meet."],
      ["2", "Save the waiting days", "Record plans, notes and photos while you wait."],
      ["3", "Capture the reunion", "Mark the day and save your memories to an album."],
      ["4", "Keep the story", "Your shared journey becomes something to treasure."],
    ];
---

<AppShell lang={lang} title={c.title}>
  <section class="new-home">
    <img class="home-sky" src="/assets/sky-vase.png" alt="" />
    <div class="home-copy">
      <h1>{c.title}</h1>
      <p>{c.body.split("\n").map((line) => <>{line}<br /></>)}</p>
      <a class="download-badge" href="#">● <span>{c.store}</span></a>
    </div>
    <img class="home-phone" src="/assets/app-phone.png" alt="Remeet countdown app screen" />
    <div class="home-route" aria-hidden="true"><i></i><b>✈</b><i></i></div>
    <a class="home-scroll" href="#notice"><em>Scroll</em><span class="scroll-track"><i></i></span></a>
    <aside class="home-notice" id="notice"><strong>{ja ? "お知らせ" : "News"}</strong><time>2026.07.24</time><span>{c.notice}</span><a href={`${base}/updates`}>→</a></aside>
  </section>

  <div class="landing-sections">
    <section class="features landing-pad" id="features">
      <div class="ornate-title"><span></span><div><h2>{c.features}</h2><p>{c.featureSub}</p></div><span></span></div>
      <div class="feature-grid">
        {features.map(([title, body], i) => <article><h3>{title}</h3><p>{body}</p><img src={`/assets/feature-${featureImages[i]}.png`} alt="" /></article>)}
      </div>
    </section>

    <section class="how landing-pad" id="how">
      <h2>{c.howTitle}</h2>
      <div class="step-grid">
        {steps.map(([n, title, body], i) => <article><div class="step-icon">{["⌖", "✎", "▣", "♡"][i]}</div><div><small>{n}</small><h3>{title}</h3><p>{body}</p></div>{i < steps.length - 1 && <b>›</b>}</article>)}
      </div>
    </section>

    <section class="widgets landing-pad" id="widgets"><div><h2>{c.widgetTitle}</h2><p>{c.widgetBody}</p></div><img src="/assets/widgets.png" alt="Remeet widgets" /></section>
    <section class="story landing-pad"><div><h2>{c.storyTitle.split("\n").map(line => <>{line}<br /></>)}</h2><p>{c.storyBody.split("\n").map(line => <>{line}<br /></>)}</p></div><img src="/assets/couple.png" alt="" /><div class="flight" aria-hidden="true">········· ♡ ········· ✈</div></section>
    <section class="download landing-pad" id="download"><div><h2>{c.cta}</h2><p>{c.ctaSub}</p></div><div class="buttons"><a class="store" href="#">●　App Store</a><a class="secondary" href={`${base}/how-to`}>▷　{c.howLink}</a></div></section>
  </div>
</AppShell>
