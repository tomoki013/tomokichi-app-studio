---
import ContentPage from "../../components/ContentPage.astro";
import "../../styles/global.css";
const pages = ["features","principles","screenshots","faq","privacy","terms","contact"] as const;
export function getStaticPaths() {
  return ["features","principles","screenshots","faq","privacy","terms","contact"].map(page => ({ params: { page } }));
}
const { page } = Astro.params as { page: (typeof pages)[number] };
---
<ContentPage lang="en" page={page} />
