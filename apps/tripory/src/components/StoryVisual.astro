---
/** One story beat's visual. Beats that are actually about using the app UI
    show a real captured screen in a device frame; beats that are genuinely
    about a travel photo/moment use a travel photograph instead. */
import AppScreen from "./AppScreen.astro";

type Screen = "home" | "world-globe" | "trips" | "trip-detail" | "trip-form";

const {
  lang,
  screen,
  image,
  index = 0,
} = Astro.props as {
  lang: "ja" | "en";
  /** Show this real captured screen in a device frame. */
  screen?: Screen | false;
  image?: string;
  index?: number;
};
---

{screen ? (
  <AppScreen lang={lang} screen={screen} size="xl" />
) : image ? (
  <figure class="story-photo">
    <img src={image} alt="" loading={index < 2 ? "eager" : "lazy"} decoding="async" />
  </figure>
) : null}
