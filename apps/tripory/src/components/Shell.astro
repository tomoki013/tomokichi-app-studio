---
import AppSiteShell from "@tomokichi/app-site/AppSiteShell.astro";
import { appSiteUrl, mainSiteUrl, supportUrl } from "@tomokichi/app-site/urls";

type Locale = "ja" | "en";
const { lang, title, page = "", description } = Astro.props as {
  lang: Locale;
  title: string;
  page?: string;
  description?: string;
};
const ja = lang === "ja";
const base = ja ? "/ja" : "";
const href = (slug: string) => `${base}/${slug}`.replaceAll("//", "/");
const jaPageHref = (`/ja/${page}`.replace(/\/$/, "")) || "/ja";
const enPageHref = `/${page}`.replace(/\/$/, "") || "/";
const nav = ja
  ? [
      { slug: "features", label: "機能紹介", href: href("features") },
      { slug: "principles", label: "こだわり", href: href("principles") },
      { slug: "screenshots", label: "スクリーンショット", href: href("screenshots") },
      { slug: "faq", label: "よくある質問", href: href("faq") },
      { slug: "updates", label: "お知らせ", href: href("updates") },
    ]
  : [
      { slug: "features", label: "Features", href: href("features") },
      { slug: "principles", label: "Principles", href: href("principles") },
      { slug: "screenshots", label: "Screenshots", href: href("screenshots") },
      { slug: "faq", label: "FAQ", href: href("faq") },
      { slug: "updates", label: "Updates", href: href("updates") },
    ];
const supportHref = supportUrl("tripory", lang);
const footerColumns = ja
  ? [
      { title: "プロダクト", links: [{ label: "機能紹介", href: href("features") }, { label: "こだわり", href: href("principles") }, { label: "スクリーンショット", href: href("screenshots") }] },
      { title: "サポート", links: [{ label: "よくある質問", href: href("faq") }, { label: "お知らせ", href: href("updates") }, { label: "お問い合わせ", href: supportHref, external: true }] },
      { title: "規約", links: [{ label: "プライバシーポリシー", href: href("privacy") }, { label: "利用規約", href: href("terms") }, { label: "特定商取引法に基づく表記", href: href("commercial-transactions") }] },
      { title: "運営者情報", links: [{ label: "運営サイト", href: mainSiteUrl("ja"), external: true }, { label: "ほかのアプリ", href: mainSiteUrl("ja", "/apps"), external: true }] },
    ]
  : [
      { title: "Product", links: [{ label: "Features", href: href("features") }, { label: "Principles", href: href("principles") }, { label: "Screenshots", href: href("screenshots") }] },
      { title: "Support", links: [{ label: "FAQ", href: href("faq") }, { label: "Updates", href: href("updates") }, { label: "Contact", href: supportHref, external: true }] },
      { title: "Legal", links: [{ label: "Privacy Policy", href: href("privacy") }, { label: "Terms of Service", href: href("terms") }, { label: "Commercial Transactions", href: href("commercial-transactions") }] },
      { title: "Operator", links: [{ label: "Operator site", href: mainSiteUrl("en"), external: true }, { label: "Other apps", href: mainSiteUrl("en", "/apps"), external: true }] },
    ];
const metaDescription = description ?? (ja
  ? "Triporyは、旅で訪れた場所と思い出を、自分だけの世界として残すアプリです。"
  : "Tripory keeps the places and memories from your travels in a world of your own.");
---

<AppSiteShell
  lang={lang}
  title={title}
  description={metaDescription}
  page={page}
  brand="TRIPORY"
  logoImage="/assets/tripory-icon.png"
  ogImage="/assets/cappadocia.png"
  tagline={ja ? "旅で集めた、わたしの世界。" : "The world, collected through travel."}
  siteUrl={appSiteUrl("tripory")}
  homeHref={ja ? "/ja" : "/"}
  jaPageHref={jaPageHref}
  enPageHref={enPageHref}
  nav={nav}
  footerColumns={footerColumns}
  appStoreLabel={ja ? "Appをダウンロード" : "Download the app"}
  menuLabel={ja ? "メニュー" : "Menu"}
  pageClass="tripory-page"
>
  <slot />
  <script is:inline>
    document.querySelectorAll("[data-reveal]").forEach((item, index) => {
      item.style.setProperty("--delay", `${(index % 5) * 55}ms`);
    });
  </script>
</AppSiteShell>
