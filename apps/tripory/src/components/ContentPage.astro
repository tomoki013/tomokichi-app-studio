---

<Shell lang={lang} title={title} page={page}>
  <section class:list={["subpage", `subpage-${page}`, isLegal && "subpage-legal"]}>
    {isLegal ? (
      /* Legal pages open inside the app as well as on the web, so they drop the
         marketing hero and read as a plain document on a small screen. */
      <header class="legal-intro">
        <p class="legal-eyebrow">TRIPORY / {page.toUpperCase()}</p>
        <h1>{title}</h1>
        <dl class="legal-dates">
          <div><dt>{ja ? "制定日" : "Effective"}</dt><dd><time datetime="2026-07-24">{ja ? "2026年7月24日" : "July 24, 2026"}</time></dd></div>
          <div><dt>{ja ? "最終更新日" : "Last updated"}</dt><dd><time datetime="2026-08-22">{ja ? "2026年8月22日" : "August 22, 2026"}</time></dd></div>
        </dl>
      </header>
    ) : (
      <header class="page-intro">
        <div class="page-intro-copy">
          <div class="page-intro-index"><span>{pageNumber[page]}</span><b>TRIPORY / {page.toUpperCase()}</b></div>
          <h1>{title}</h1>
          {subtitle && <p>{subtitle}</p>}
        </div>
        <figure class="page-intro-visual">
          <img src={pageVisual[page]} alt="" />
          <figcaption><span>↗</span>{pageCaption[page][ja ? 0 : 1]}</figcaption>
        </figure>
      </header>
    )}

    {page === "features" && (
      <>
        <AppStory class="app-story--page" steps={featureBeats} visual={StoryVisual} />
        <section class="feature-rest">
          <h2 class="block-title">{ja ? "そのほかにできること" : "Everything else it does"}</h2>
          <div class="feature-page-grid">
            {features.slice(4).map(([icon, heading, body, image], i) => (
              <article data-reveal>
                <div class="feature-page-image"><img src={image} alt="" /><span>{icon}</span></div>
                <div><b>0{i + 5}</b><h2>{heading}</h2><p>{body}</p></div>
              </article>
            ))}
          </div>
        </section>
        <a class="orange-cta" href={ja ? "/ja/screenshots" : "/screenshots"}>{ja ? "実際の画面で確かめる" : "See it in the real app"} →</a>
      </>
    )}

    {page === "how-to" && <AppSimpleSteps steps={howBeats} visual={StoryVisual} />}

    {page === "screenshots" && (
      <div class="capture-page">
        <div class="capture-detail" data-reveal>
          <AppScreen lang={lang} screen="home" size="xl" priority />
          <div>
            <p class="capture-kicker">IPHONE 17 PRO MAX · REAL CAPTURES</p>
            <h2>{ja ? "つくりものではなく、いまのTripory。" : "Not a mockup — the Tripory that exists today."}</h2>
            <p>{ja
              ? "アプリ本体をデモデータ付きで起動し、iPhone 17 Pro Maxのシミュレータからそのまま撮影しています。画面の文字、余白、色、操作の入口まで、実際のプロダクトです。"
              : "Captured directly from the running app with fictional demo data on an iPhone 17 Pro Max simulator. The type, spacing, colour, and controls are the real product."}</p>
            <dl>
              <div><dt>{ja ? "画面" : "Screens"}</dt><dd>{screenshots.length}</dd></div>
              <div><dt>{ja ? "保存" : "Storage"}</dt><dd>{ja ? "端末内" : "On device"}</dd></div>
              <div><dt>{ja ? "撮影" : "Capture"}</dt><dd>1320 × 2868</dd></div>
              <div><dt>{ja ? "データ" : "Data"}</dt><dd>{ja ? "架空のデモ" : "Fictional demo"}</dd></div>
            </dl>
          </div>
        </div>

        <ol class="capture-notes">
          {(ja
            ? [
                ["訪れた国が、地図に残る", "「訪問済み」にした国が3Dの地球儀の上に積み重なっていきます。塗り絵ではなく、旅の履歴です。"],
                ["旅は、時間の流れとして残る", "行き先だけでなく、日付・写真・メモをひとつの旅としてタイムラインに残せます。"],
                ["次の一歩も、同じ画面から", "旅の記録も、行きたい国の追加も、迷わずたどり着ける導線になっています。"],
              ]
            : [
                ["Visited countries stay on the globe", "Countries you mark as visited accumulate on the 3D globe — a history of travel, not a colouring book."],
                ["A trip is kept as a stretch of time", "Not just a destination — dates, photos and notes stay together as one trip on the timeline."],
                ["The next step is one tap away", "Recording a trip or adding a wishlist country both start from the same obvious place."],
              ]
          ).map(([heading, body], i) => (
            <li data-reveal style={`--reveal-i:${i}`}>
              <b>{String(i + 1).padStart(2, "0")}</b>
              <div><h3>{heading}</h3><p>{body}</p></div>
            </li>
          ))}
        </ol>

        <div class="capture-gallery">
          {screenshots.map(([screen, label]) => (
            <figure data-reveal>
              <AppScreen lang={lang} screen={screen} size="md" />
              <figcaption>{label}</figcaption>
            </figure>
          ))}
        </div>

        <aside class="capture-pending" data-reveal>
          <h2>{ja ? "実際の画面だけを載せています" : "Every screen here is a real capture"}</h2>
          <p>{ja
            ? "このページに載せているのは、すべて実機と同じ解像度でアプリ本体から直接撮影した画面です。加工やモックアップは使っていません。"
            : "Every screen on this page is captured directly from the running app at real device resolution — no retouching, no mockups."}</p>
          <a href={ja ? "/ja/how-to" : "/how-to"}>{ja ? "使い方を見る" : "See how it works"} <span aria-hidden="true">→</span></a>
        </aside>
      </div>
    )}

    {page === "faq" && (
      <>
        <nav class="faq-tabs" aria-label={ja ? "質問のカテゴリ" : "Question categories"} data-faq-tabs>
          {faqCategories.map(([key, label], i) => (
            <button type="button" data-cat={key} aria-pressed={i === 0 ? "true" : "false"}>
              <span>{label}</span><small>{faqCount(key)}</small>
            </button>
          ))}
        </nav>
        <div class="faq-list" data-faq-list>
          {faqs.map(([cat, q, a], i) => (
            <details data-cat={cat} open={i === 0}>
              <summary><b>Q</b><span>{q}</span><i aria-hidden="true">⌄</i></summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
        <div class="faq-contact"><span>✉</span><div><h2>{ja ? "その他のご質問はこちら" : "Still have questions?"}</h2><p>{ja ? "共通サポートフォームからお問い合わせください。" : "Send us a message through the shared support form."}</p></div><a href={supportUrl("tripory", lang)}>{ja ? "お問い合わせへ" : "Contact us"}</a></div>
      </>
    )}

    {(page === "privacy" || page === "terms") && <article class="legal-copy">{legal[page].map(([heading, body]) => <section><h2>{heading}</h2>{body.split("\n\n").map((para) => <p>{para.split("\n").map((line) => <>{line}<br /></>)}</p>)}</section>)}</article>}

    {page === "news" && <NewsFeed lang={lang} posts={newsPosts} basePath={ja ? "/ja/news" : "/news"} />}
    {page === "updates" && (
      <AppUpdatesPage
        lang={lang}
        appName="Tripory"
        newsHref={ja ? "/ja/news" : "/news"}
        releases={[]}
      />
    )}

    {!(page === "privacy" || page === "terms") && (
      <aside class="subpage-next" data-reveal>
        <p>{ja ? "旅の記録を、もう少し先へ。" : "Take the story a little further."}</p>
        <div>
          <a href={ja ? "/ja/features" : "/features"}>{ja ? "機能紹介" : "Features"} <span>→</span></a>
          <a href={ja ? "/ja/how-to" : "/how-to"}>{ja ? "使い方" : "How to"} <span>→</span></a>
          <a href={ja ? "/ja/faq" : "/faq"}>{ja ? "よくある質問" : "FAQ"} <span>→</span></a>
        </div>
      </aside>
    )}

  </section>
</Shell>

<script is:inline>
  (() => {
    const bindFaq = () => {
      const tabs = document.querySelector("[data-faq-tabs]");
      const list = document.querySelector("[data-faq-list]");
      if (!tabs || !list || tabs.dataset.bound === "1") return;
      tabs.dataset.bound = "1";
      const items = Array.from(list.querySelectorAll("details"));
      tabs.addEventListener("click", (event) => {
        const button = event.target.closest("button[data-cat]");
        if (!button) return;
        const cat = button.getAttribute("data-cat");
        items.forEach((item) => {
          const show = cat === "all" || item.getAttribute("data-cat") === cat;
          item.hidden = !show;
          if (!show) item.open = false;
        });
        tabs.querySelectorAll("button").forEach((b) => {
          b.setAttribute("aria-pressed", String(b.getAttribute("data-cat") === cat));
        });
        const first = items.find((item) => !item.hidden);
        if (first) first.open = true;
      });
    };
    document.addEventListener("astro:page-load", bindFaq);
    bindFaq();
  })();
</script>
