---

<Shell lang={lang} title={title} page={page}>
  <section class:list={["subpage", `subpage-${page}`]}>
    <header class="page-intro">
      <div class="page-intro-copy">
        <div class="page-intro-index"><span>{pageNumber[page]}</span><b>TRIPORY / {page.toUpperCase()}</b></div>
        <h1>{title}</h1>
        {subtitle && <p>{subtitle}</p>}
        {(page === "privacy" || page === "terms") && <small>{ja ? "制定日：2026年7月24日／最終更新日：2026年7月24日" : "Effective: July 24, 2026 / Last updated: July 24, 2026"}</small>}
      </div>
      <figure class="page-intro-visual">
        <img src={pageVisual[page]} alt="" />
        <figcaption><span>↗</span>{pageCaption[page][ja ? 0 : 1]}</figcaption>
      </figure>
    </header>

    {page === "features" && <><div class="feature-page-grid">{features.map(([icon, heading, body, image], i) => <article data-reveal><div class="feature-page-image"><img src={image} alt="" /><span>{icon}</span></div><div><b>0{i + 1}</b><h2>{heading}</h2><p>{body}</p></div></article>)}</div><a class="orange-cta" href={ja ? "/ja/screenshots" : "/screenshots"}>{ja ? "実際の画面で確かめる" : "See it in the real app"} →</a></>}

    {page === "principles" && <div class="how-page-list">{principles.map(([heading, body, image], i) => <article><b>0{i + 1}</b><div><h2>{heading}</h2><p>{body}</p></div><img src={image} alt="" /></article>)}</div>}

    {page === "screenshots" && (
      <div class="capture-detail">
        <AppScreen lang={lang} size="xl" />
        <div>
          <p class="capture-kicker">IPHONE 17 PRO MAX · REAL CAPTURE</p>
          <h2>{ja ? "つくりものではなく、いまのTripory。" : "Not a mockup—the Tripory that exists today."}</h2>
          <p>{ja ? "アプリ本体をデモデータ付きで起動し、iPhone 17 Pro Maxのシミュレータからそのまま撮影しています。画面の文字、余白、色、操作の入口まで、実際のプロダクトです。" : "Captured directly from the running app with fictional demo data on an iPhone 17 Pro Max simulator. The type, spacing, colour, and controls are the real product."}</p>
          <dl>
            <div><dt>{ja ? "画面" : "Screen"}</dt><dd>{ja ? "マイワールド" : "My World"}</dd></div>
            <div><dt>{ja ? "保存" : "Storage"}</dt><dd>{ja ? "端末内" : "On device"}</dd></div>
            <div><dt>{ja ? "撮影" : "Capture"}</dt><dd>1320 × 2868</dd></div>
          </dl>
        </div>
      </div>
    )}

    {page === "faq" && <><div class="faq-list">{faqs.map(([q, a], i) => <details open={i === 0}><summary>Q. {q}<span>⌄</span></summary><p>{a}</p></details>)}</div><div class="faq-contact"><span>✉</span><div><h2>{ja ? "その他のご質問はこちら" : "Still have questions?"}</h2><p>{ja ? "共通サポートフォームからお問い合わせください。" : "Send us a message through the shared support form."}</p></div><a href={supportUrl("tripory", lang)}>{ja ? "お問い合わせへ" : "Contact us"}</a></div></>}

    {(page === "privacy" || page === "terms") && <article class="legal-copy">{legal[page].map(([heading, body]) => <section><h2>{heading}</h2>{body.split("\n\n").map((para) => <p>{para.split("\n").map((line) => <>{line}<br /></>)}</p>)}</section>)}</article>}

    {page === "news" && <NewsFeed lang={lang} posts={newsPosts} />}
    {page === "updates" && (
      <AppUpdatesPage
        lang={lang}
        appName="Tripory"
        newsHref={ja ? "/ja/news" : "/news"}
        releases={[]}
      />
    )}

    {!(page === "privacy" || page === "terms") && (
      <aside class="subpage-next" data-reveal>
        <p>{ja ? "旅の記録を、もう少し先へ。" : "Take the story a little further."}</p>
        <div>
          <a href={ja ? "/ja/features" : "/features"}>{ja ? "機能紹介" : "Features"} <span>→</span></a>
          <a href={ja ? "/ja/principles" : "/principles"}>{ja ? "こだわり" : "Principles"} <span>→</span></a>
          <a href={ja ? "/ja/faq" : "/faq"}>{ja ? "よくある質問" : "FAQ"} <span>→</span></a>
        </div>
      </aside>
    )}

  </section>
</Shell>
