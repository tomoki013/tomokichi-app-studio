---
import AppSimpleSteps from "@tomokichi/app-site/AppSimpleSteps.astro";
import AppStory, { type StoryStep } from "@tomokichi/app-site/AppStory.astro";
import AppUpdatesPage from "@tomokichi/app-site/AppUpdatesPage.astro";
import NewsFeed from "@tomokichi/app-site/NewsFeed.astro";
import { supportUrl } from "@tomokichi/app-site/urls";
import { getNewsPosts } from "../lib/news";
import AppScreen from "./AppScreen.astro";
import Shell from "./Shell.astro";
import StoryVisual from "./StoryVisual.astro";

type Locale = "ja" | "en";
type Page = "features" | "how-to" | "screenshots" | "faq" | "privacy" | "terms" | "news" | "updates";
const { lang, page } = Astro.props as { lang: Locale; page: Page };
const ja = lang === "ja";
const titleMap: Record<Page, [string, string]> = {
  features: ["機能紹介", "Features"],
  "how-to": ["使い方", "How to"],
  screenshots: ["スクリーンショット", "Screenshots"],
  faq: ["よくある質問", "Frequently asked questions"],
  privacy: ["プライバシーポリシー", "Privacy Policy"],
  terms: ["利用規約", "Terms of Service"],
  news: ["ニュース", "News"],
  updates: ["アップデート情報", "App updates"],
};
const subtitleMap: Partial<Record<Page, [string, string]>> = {
  features: ["旅のすべてを、ひとつのアプリに。", "Everything about your travels, in one app."],
  "how-to": ["旅を残す、三つのステップ。", "Three quiet steps to keep a journey."],
  screenshots: ["美しい旅の記録体験を。", "A beautiful way to remember every journey."],
  faq: ["よくいただくご質問をまとめました。", "Everything you may want to know."],
  news: ["Triporyからのお知らせと旅のコラム。", "News from Tripory and stories about keeping journeys."],
  updates: ["新機能や改善内容をバージョンごとに記録します。", "Version-by-version features, improvements, and fixes."],
};
const title = titleMap[page][ja ? 0 : 1];
const subtitle = subtitleMap[page]?.[ja ? 0 : 1];
const pageNumber: Record<Page, string> = {
  features: "01", "how-to": "02", screenshots: "03", faq: "04",
  news: "05", updates: "06", privacy: "07", terms: "08",
};
const pageVisual: Record<Page, string> = {
  features: "/assets/world-globe.png",
  "how-to": "/assets/mountain-lake.png",
  screenshots: "/assets/iceland.png",
  faq: "/assets/venice.png",
  news: "/assets/santorini.png",
  updates: "/assets/mountain-lake.png",
  privacy: "/assets/cappadocia.png",
  terms: "/assets/cappadocia.png",
};
const pageCaption: Record<Page, [string, string]> = {
  features: ["旅を、点ではなく流れで残す。", "Keep the journey, not just the pins."],
  "how-to": ["残す、添える、見返す。", "Keep, add, look back."],
  screenshots: ["いま動いているTripory。", "The Tripory that exists today."],
  faq: ["旅立つ前の、小さな確認。", "A few things before departure."],
  news: ["Triporyから届く便り。", "Dispatches from Tripory."],
  updates: ["旅の道具が育った記録。", "A record of the product growing."],
  privacy: ["あなたの記録は、あなたのもの。", "Your records remain yours."],
  terms: ["安心して旅を残すために。", "Terms for keeping journeys with confidence."],
};

const features = ja
  ? [
      ["◎", "世界地図", "訪れた国と行きたい国を、3D地球儀・平面地図・コレクションで見返せます。記録の単位は国です。", "/assets/world-globe.png"],
      ["▣", "旅の記録", "行き先の国、期間、写真、メモをタイムラインで残し、いつでも振り返れます。", "/assets/mountain-lake.png"],
      ["♡", "写真とメモ", "選んだ写真と、その旅の一言を添えます。写真は端末内で圧縮して保存します。", "/assets/venice.png"],
      ["◷", "統計", "訪れた国の数、訪問回数、日数をホームと各国の詳細で確認できます。", "/assets/iceland.png"],
      ["☆", "行きたい国", "まだ行っていない国をスターで残し、地図上でも見分けられます。", "/assets/santorini.png"],
    ]
  : [
      ["◎", "World map", "Look back at visited and want-to-go countries on a 3D globe, a flat map, or a collection. Records are country-level.", "/assets/world-globe.png"],
      ["▣", "Travel timeline", "Keep destination countries, dates, photos and notes, then revisit any trip.", "/assets/mountain-lake.png"],
      ["♡", "Photos and notes", "Attach chosen photos and a short note. Photos are compressed on your device before they are stored.", "/assets/venice.png"],
      ["◷", "Statistics", "See country counts, visit counts and days on Home and on each country page.", "/assets/iceland.png"],
      ["☆", "Want to go", "Star countries you have not visited yet. They stay distinct on the map.", "/assets/santorini.png"],
    ];
/* Features leads with the shared scroll story for the four beats a real
   screen can carry; wishlist lives in the compact grid below. */
const featureBeats: StoryStep[] = (
  ja
    ? [
        ["世界地図", "訪れた国と行きたい国を、3D地球儀・平面地図・コレクションで見返せます。都市単位の記録ではありません。", "world-globe"],
        ["旅の記録", "行き先の国、期間、写真、メモをタイムラインで残し、いつでも振り返れます。", "trips"],
        ["写真とメモ", "選んだ写真と、その旅の一言を添えます。写真は端末内で圧縮して保存します。", "trip-detail"],
        ["統計", "訪れた国の数、訪問回数、日数をホームと各国の詳細で確認できます。", "home"],
      ]
    : [
        ["World map", "Look back at visited and want-to-go countries on a 3D globe, a flat map, or a collection. Records are country-level, not cities.", "world-globe"],
        ["Travel timeline", "Keep destination countries, dates, photos and notes, then revisit any trip.", "trips"],
        ["Photos and notes", "Attach chosen photos and a short note. Photos are compressed on your device before they are stored.", "trip-detail"],
        ["Statistics", "See country counts, visit counts and days on Home and on each country page.", "home"],
      ]
).map(([title, body, screen], i) => ({
  kicker: String(i + 1).padStart(2, "0"),
  title,
  body,
  visual: { lang, screen },
}));
/* How-to uses the shared scroll story. Beats that are about using the app UI
   show a real captured screen; the "add a photo" beat is genuinely about a
   travel moment, not an app screen, so it keeps a travel photograph. */
const howBeats: StoryStep[] = (
  (ja
    ? [
        ["住んでいる国を決める", "最初に住んでいる国を設定します。ここが基準になり、その国は自動的に「訪問済み」として扱われ、旅の行き先の候補からは外れます。あとから設定画面で変更できます。", "はじめの一度だけです。変更履歴は旅の記録ページから確認できます。", "home", ""],
        ["旅をはじめる", "行き先と日付を残します。国を塗るためではなく、その旅の時間をひとつの流れにするための一歩です。", "旅は何件でも並行して持てます。過去の旅からでもかまいません。", "trip-form", ""],
        ["写真と一言を添える", "選んだ写真と、そのときの短い言葉を添えます。iOSの標準的な写真選択画面を使うため、写真ライブラリ全体へは触れません。", "写真は保存容量を抑えるため、端末内でリサイズしてから保存されます。", false, "/assets/venice.png"],
        ["地図とタイムラインで見返す", "残した旅を地図と時系列でたどり、いつ、どの国へ行ったかを思い出します。訪れた国の数や日数は統計としても確認できます。", "記録は端末内にだけ保存されます。書き出し機能はないので、機種変更やアプリ削除の前にご注意ください。", "world-globe", ""],
      ]
    : [
        ["Set your home country", "Start by choosing where you live. It becomes the baseline: that country counts as visited and drops out of destination suggestions. You can change it later in Settings.", "Only once, at the start. The change history stays on the trip records page.", "home", ""],
        ["Start a trip", "Keep a destination and dates. Not to colour a country, but to hold that stretch of time as one journey.", "Trips can run side by side, and a past trip is just as welcome.", "trip-form", ""],
        ["Add a photo and a note", "Attach a chosen photograph and a few words from that moment. It uses the standard iOS picker, so the app never sees your full library.", "Photos are resized on your device before they are stored.", false, "/assets/venice.png"],
        ["Look back on the map", "Revisit trips on the map and timeline — when you were there, and which countries you passed through. Country counts and days add up as quiet statistics.", "Records live only on your device. There is no export, so changing phones or deleting the app will lose them.", "world-globe", ""],
      ]) as [string, string, string, "home" | "trip-form" | "world-globe" | false, string][]
).map(([title, body, note, screen, image], i) => ({
  kicker: String(i + 1).padStart(2, "0"),
  title,
  body,
  note,
  visual: { lang, screen, image },
}));
/** `[category, question, answer]`. Categories drive the filter tabs. */
const faqs: [string, string, string][] = ja
  ? [
      ["base", "Triporyは何をするアプリですか？", "訪れた国と、その旅そのものを記録するアプリです。国を塗りつぶすだけでなく、旅の期間・写真・メモをひとつの流れとして残し、地図とタイムラインで振り返れます。"],
      ["base", "旅行の計画を立てるアプリですか？", "いいえ。予約や行程を管理するためのアプリではありません。すでに行った旅、これから行きたい国を、自分の記録として残すためのものです。"],
      ["base", "無料で使えますか？", "はい。基本機能はすべて無料です。無料版ではバナー広告が表示され、新しい国を初めて記録したあとにインタースティシャル広告が出ることがあります。買い切りの「広告を削除」で非表示にできます。サブスクリプションではありません。"],
      ["base", "アカウント登録は必要ですか？", "いいえ。登録やログインは不要です。メールアドレスの入力も求めません。"],
      ["base", "対応環境は？", "iPhone・iOS 26以降向けです。iPad専用の最適化レイアウトはありません。"],
      ["base", "Android版はありますか？", "現在、Android版は提供していません。"],
      ["trip", "「住んでいる国」はなぜ設定するのですか？", "記録を海外旅行に絞り込むための基準として使います。設定した国は自動的に「訪問済み」として扱われ、旅の行き先の候補からは除外されます。"],
      ["trip", "住んでいる国は変更できますか？", "はい。設定画面からいつでも変更できます。変更履歴は旅の記録ページから確認・調整できます。"],
      ["trip", "旅は何件まで記録できますか？", "件数の上限は設けていません。複数の旅を並行して持てます。"],
      ["trip", "過去の旅も記録できますか？", "はい。日付を選んで、以前の旅をあとから記録できます。"],
      ["trip", "旅の記録はあとから編集できますか？", "はい。タイトル・訪問先・日付・メモを後から変更できます。"],
      ["trip", "1つの旅に写真は何枚添えられますか？", "旅の記録に写真を添付できます。枚数の扱いはアプリ内の表示に従います。"],
      ["map", "地図の国境はどこまで正確ですか？", "Natural Earth（パブリックドメインの簡易データ）とApple MapKitに基づく簡易的な表示です。政治的な立場や見解を示すものではありません。"],
      ["map", "統計では何が見られますか？", "訪れた国の数、各国の訪問回数、滞在日数を確認できます。都市数や地域シェアの円グラフはありません。記録の単位は国です。"],
      ["map", "地図の表示に通信は必要ですか？", "地図タイル（衛星写真・地形・道路などの背景画像）の表示にはインターネット通信が必要です。AppleのMapKitを利用しています。"],
      ["data", "データはどこに保存されますか？", "端末内のデータベースにのみ保存されます。運営者を含む第三者がアクセスすることはありません。"],
      ["data", "写真はどのように扱われますか？", "iOS標準の写真選択画面（PhotosPicker）を使用するため、選んだ写真だけが本アプリに渡され、写真ライブラリ全体へアクセスすることはありません。選択された写真は、保存容量を抑えるため端末内でリサイズ・圧縮して保存します。"],
      ["data", "オフラインでも使えますか？", "地図タイルの表示を除き、記録の閲覧・編集など主要な機能はオフラインでもご利用いただけます。"],
      ["data", "他の端末と同期できますか？", "現在、端末間の同期機能はありません。データは各端末に個別に保存されるため、機種変更の際はご注意ください。"],
      ["data", "データを書き出せますか？", "現在、データの書き出しや読み込みには対応していません。"],
      ["data", "データを削除するには？", "設定画面の「すべてのデータを削除」からいつでも削除できます。アプリをアンインストールした場合も、端末内のデータは削除されます。"],
      ["data", "記録が消えた場合、復旧できますか？", "端末内にのみ保存されているため、運営者が復旧することはできません。書き出し機能もないので、機種変更やアプリ削除の前にご注意ください。"],
      ["data", "広告は表示されますか？", "はい。Google Mobile Adsによるバナーが、設定以外のタブに表示される場合があります。新しい国を初めて記録したあと、ときどき全画面広告が出ることがあります。App Tracking Transparencyの許可を求めます。許可しなくても基本機能は使えます。"],
      ["data", "広告を削除できますか？", "はい。設定の買い切り「広告を削除」で、バナーとインタースティシャルを非表示にできます。同じApple Accountなら復元できます。"],
    ]
  : [
      ["base", "What does Tripory do?", "It records the countries you visited and the journeys themselves. Rather than only filling in a map, it keeps each trip's dates, photos and notes as one thread you can revisit on a map and a timeline."],
      ["base", "Is it a trip-planning app?", "No. It does not manage bookings or itineraries. It is for keeping the trips you took, and the countries you still want to see."],
      ["base", "Is it free?", "Yes. Every core feature is free. The free version may show banner ads, and occasionally an interstitial after you first log a new country. A one-time Remove Ads purchase hides them. There is no subscription."],
      ["base", "Do I need an account?", "No. There is no sign-up or login, and we never ask for an email address."],
      ["base", "What devices are supported?", "iPhone on iOS 26 or later. There is no iPad-optimized layout."],
      ["base", "Is there an Android version?", "Not currently."],
      ["trip", "Why does it ask for a home country?", "It is the baseline for narrowing records to international travel. Your home country counts as visited and is left out of destination suggestions."],
      ["trip", "Can I change my home country?", "Yes, at any time from Settings. The change history stays available on the trip records page."],
      ["trip", "How many trips can I keep?", "There is no limit, and trips can run side by side."],
      ["trip", "Can I add trips from the past?", "Yes. Choose the dates and record an earlier journey whenever you like."],
      ["trip", "Can I edit a trip later?", "Yes — title, destination, dates and notes can all be changed afterwards."],
      ["trip", "How many photos can a trip hold?", "You can attach photos to a trip record; the app's own screens show how many apply."],
      ["map", "How accurate are the borders?", "They are a simplified representation based on the public-domain Natural Earth dataset and Apple MapKit, and do not represent any political position."],
      ["map", "What do the statistics show?", "Country counts, how many times you visited each country, and days. There are no city counts or region-share charts. Records are country-level."],
      ["map", "Does the map need a network?", "Yes, for map tiles — the satellite, terrain and road imagery behind your records. That uses Apple's MapKit."],
      ["data", "Where is my data stored?", "Data is stored only in an on-device database. No one, including the operator, can access it."],
      ["data", "How are photos handled?", "The app uses iOS's standard photo picker, so only the photos you choose are passed to the app — it never accesses your full photo library. Chosen photos are resized and compressed on your device to save storage."],
      ["data", "Can I use Tripory offline?", "Aside from loading map tiles, core features such as viewing and editing records work offline."],
      ["data", "Can I sync across devices?", "There is currently no sync between devices. Each device keeps its own data, so please back up before switching phones."],
      ["data", "Can I export my data?", "Not currently — there is no export or import."],
      ["data", "How do I delete my data?", "Use \"Delete all data\" in Settings at any time. Uninstalling the app also removes the data stored on your device."],
      ["data", "Can lost records be recovered?", "No. Because everything lives on your device and there is no export, the operator cannot restore it if you change phones or delete the app."],
      ["data", "Are there ads?", "Yes. A Google Mobile Ads banner may appear on tabs other than Me. An interstitial may appear after you first log a new country. The app asks for App Tracking Transparency; declining does not lock features."],
      ["data", "Can I remove ads?", "Yes. The one-time Remove Ads purchase in Settings hides banners and interstitials. Restore it on the same Apple Account."],
    ];

const faqCategories = ja
  ? [["all", "すべて"], ["base", "基本"], ["trip", "旅の記録"], ["map", "地図と統計"], ["data", "データ"]]
  : [["all", "All"], ["base", "Basics"], ["trip", "Trips"], ["map", "Map & stats"], ["data", "Your data"]];
const faqCount = (key: string) =>
  key === "all" ? faqs.length : faqs.filter(([cat]) => cat === key).length;

const screenshots = (
  ja
    ? [
        ["home", "マイワールド"],
        ["world-globe", "3Dの地球儀"],
        ["trips", "旅の記録"],
        ["trip-detail", "旅の詳細"],
        ["trip-form", "旅を記録する"],
      ]
    : [
        ["home", "My World"],
        ["world-globe", "3D globe"],
        ["trips", "Trip timeline"],
        ["trip-detail", "Trip detail"],
        ["trip-form", "Record a trip"],
      ]
) as ["home" | "world-globe" | "trips" | "trip-detail" | "trip-form", string][];

const isLegal = page === "privacy" || page === "terms";

const newsPosts = getNewsPosts(lang);

const legal = {
  privacy: ja
    ? [
        ["1. はじめに", "本ポリシーは、運営者（Tomokichi）が提供するiOSアプリケーション「Tripory」および本ウェブサイト（以下あわせて「本サービス」）における、利用者情報の取扱いについて定めるものです。本ウェブサイトに掲載する内容を正本とし、本アプリ内からは本ウェブサイトを参照します。"],
        ["2. 運営者情報", "本サービスは、運営者（Tomokichi）が個人で開発・運営しています。お問い合わせ先は本ページ末尾に記載しています。"],
        ["3. 適用範囲", "本ポリシーは、本アプリの利用および本ウェブサイトの閲覧に関して適用されます。"],
        ["4. 基本方針", "本アプリはアカウント登録を必要とせず、利用者の旅の記録は端末内のデータベースにのみ保存されます。運営者は、通常のアプリ利用だけではこれらの記録内容を閲覧できるサーバーを運用していません。本アプリは広告表示のためGoogle Mobile Ads SDKを使用しますが、旅の記録を広告配信事業者へ送信しません。"],
        ["5. 端末内に保存する情報", "本アプリが扱う情報は、すべて利用者自身が入力したものです。\n\n・国ごとのステータス（訪問済み／行きたい）とそのメモ\n・旅の記録（タイトル・訪問先・日付・メモ）\n・住んでいる国とその設定履歴\n・旅の記録に添付した写真\n\nこれらはすべて端末内のデータベースにのみ保存されます。アカウント登録やログイン、メールアドレスの入力は一切不要です。"],
        ["6. 写真の取り扱い", "旅の記録に写真を添付する際は、iOSの標準的な写真選択画面（PhotosPicker）を使用します。この仕組みでは、利用者が選んだ写真そのものだけが本アプリに渡され、本アプリが写真ライブラリ全体を閲覧したり、選んでいない写真にアクセスしたりすることはありません。選択された写真は、保存容量を抑えるため端末内でリサイズ・圧縮したうえで保存します。"],
        ["7. 外部サーバーへ送信される情報", "本アプリが外部と通信を行うのは、次の場合です。\n\n(1) 地図：AppleのMapKitによる地図タイル（衛星写真・地形・道路などの背景画像）の表示。国境データにはNatural Earth（パブリックドメイン）を使用します。これらの通信に、利用者が記録した国や旅の情報が含まれることはありません。\n\n(2) 広告と同意管理：Google Mobile Ads SDKおよびUser Messaging Platformが、IPアドレス、端末・広告識別子、技術情報、同意状況等を送信する場合があります。旅の記録は送信しません。\n\n(3) アプリ内課金：広告削除の購入、検証および復元のためAppleのStoreKitと通信します。\n\n(4) 法務文書：最新版を表示するため本ウェブサイトへ通信します。\n\n(5) 問い合わせ：フォームを明示的に送信した場合に限り、入力内容とアプリ・OS情報等をサポートAPIおよびメール配信事業者へ送信します。旅の記録は自動送信しません。"],
        ["8. 広告配信", "本アプリは広告表示のためGoogle Mobile Ads SDKおよび同意管理のためのUser Messaging Platform（UMP）を使用します。バナー広告が設定以外のタブに表示される場合があり、新しい国を初めて記録したあとにインタースティシャル広告が表示されることがあります。App Tracking Transparency（ATT）の許可を求めます。許可しなくても基本機能は利用できます。広告識別子の利用は、利用者の許可および地域の同意状況に従います。「広告を削除」を購入済みの場合は広告配信の対象外となります。"],
        ["9. アプリ内課金", "非消耗型の一回払い商品「広告を削除」は、AppleのStoreKitを通じて処理されます。Appleが決済を処理し、運営者はクレジットカード情報を取得しません。購入履歴、返金、Apple Account情報はAppleが管理します。購入復元に対応しています。サブスクリプションではありません。税込価格はApp Storeおよびアプリ内の購入画面の表示を正とします。"],
        ["10. 第三者提供", "運営者は、利用者の情報を第三者へ販売、貸与または提供しません。ただし、法令に基づく開示請求があった場合を除きます。本ポリシーに記載した範囲で、Apple（MapKit、StoreKit）、Google（広告配信・同意管理）、Cloudflare Workers（問い合わせAPI）、Resend（問い合わせメール配送）を利用します。"],
        ["11. 保存期間と削除", "設定画面の「すべてのデータを削除」から、いつでも記録したデータをすべて削除できます（住んでいる国の設定を除く）。データの書き出し・読み込み機能はありません。本アプリをアンインストールした場合、端末内のデータは削除され、運営者が復旧することはできません。"],
        ["12. 未成年者の利用", "本アプリは特定の年齢層を対象とした情報の収集を行っていません。未成年の方は保護者の同意を得たうえでご利用ください。"],
        ["13. 本ポリシーの変更", "本アプリの機能追加に伴い、本ポリシーの内容を変更する場合があります。変更後の内容は、本アプリ内または本ウェブサイトに掲載された時点から適用されます。"],
        ["14. お問い合わせ", "本ポリシーおよび個人情報の取扱いに関するお問い合わせは、共通サポートフォームまたは support@tmkch.io までご連絡ください。"],
      ]
    : [
        ["1. Introduction", "This policy sets out how the operator (Tomokichi) handles user information across the iOS application \"Tripory\" and this website (together, the \"Service\"). This website is the authoritative version; the App refers back to it."],
        ["2. About the operator", "The Service is developed and operated by an individual, the operator (Tomokichi). Contact details are listed at the end of this page."],
        ["3. Scope", "This policy applies to use of the app and browsing of this website."],
        ["4. Basic policy", "The app does not require account registration. Your travel records are stored only in an on-device database. The operator does not run a server that can view those records from ordinary use alone. Google Mobile Ads is used for advertising, but trip records are not sent to advertising partners."],
        ["5. Information stored on your device", "Everything the app handles is information you entered yourself.\n\n・Status (visited / want to visit) and notes for each country\n・Trip records (title, destination, dates, notes)\n・Your home country and its change history\n・Photos attached to trip records\n\nAll of this is stored only in an on-device database. No account, login or email address is required."],
        ["6. How photos are handled", "When you attach a photo to a trip, the app uses iOS's standard photo picker (PhotosPicker). Only the photo you choose is passed to the app — it never browses your full photo library or accesses photos you did not select. Selected photos are resized and compressed on-device to save storage."],
        ["7. Information sent to external servers", "The app communicates externally in these cases:\n\n(1) Maps: Apple MapKit tiles (satellite, terrain and roads). Border data uses the public-domain Natural Earth dataset. None of this includes the countries or trips you recorded.\n\n(2) Ads and consent: Google Mobile Ads and User Messaging Platform may send IP address, device or advertising identifiers, technical information, and consent status. Trip records are not sent.\n\n(3) In-app purchase: Apple StoreKit is used to buy, verify and restore Remove Ads.\n\n(4) Legal documents: the latest copy is loaded from this website.\n\n(5) Support: only when you submit the form, your entries and related app/OS details are sent to the support API and email provider. Trip records are not attached automatically."],
        ["8. Advertising", "The app uses the Google Mobile Ads SDK and the User Messaging Platform (UMP) for consent. A banner may appear on tabs other than Me, and an interstitial may appear after you first log a new country. The app requests App Tracking Transparency (ATT). Declining ATT does not lock core features. Use of advertising identifiers follows your permission and regional consent. After purchasing Remove Ads, you are not ad-supported."],
        ["9. In-app purchases", "The non-consumable one-time product “Remove Ads” is processed through Apple’s StoreKit. Apple handles payment; the operator never receives card details. Purchase history, refunds and Apple Account data are managed by Apple. Restore purchases is supported. This is not a subscription. The tax-inclusive price shown on the App Store and the in-app purchase screen is authoritative."],
        ["10. Disclosure to third parties", "The operator does not sell, lend or otherwise disclose your information to third parties, except where required by law. The Service uses Apple (MapKit, StoreKit), Google (ads and consent), Cloudflare Workers (support API), and Resend (support email)."],
        ["11. Retention and deletion", "You can delete all recorded data at any time from \"Delete all data\" in Settings (except your home-country setting). There is no export or import. Uninstalling the app deletes the information stored on your device, and the operator cannot recover it."],
        ["12. Use by minors", "The app does not target or collect information from any specific age group. Minors should use it with a parent or guardian's consent."],
        ["13. Changes to this policy", "This policy may be revised as the app's functionality changes. Changes take effect once published within the app or on this website."],
        ["14. Contact", "For questions about this policy or how your information is handled, please use the shared support form or contact support@tmkch.io."],
      ],
  terms: ja
    ? [
        ["第1条（適用）", "本規約は、運営者（Tomokichi）が提供するiOSアプリケーション「Tripory」（以下「本アプリ」）および本ウェブサイト（あわせて「本サービス」）の利用条件を定めるものです。本ウェブサイトに掲載する内容を正本とし、本アプリ内からは本ウェブサイトを参照します。利用者は、本アプリをダウンロードまたは本サービスを利用した時点で、本規約に同意したものとみなされます。"],
        ["第2条（本サービスの内容）", "本アプリは、利用者自身が訪れた国や旅の記録を個人的に管理するための機能を、利用者の端末上で提供します。アカウント登録は不要です。"],
        ["第3条（「住んでいる国」の扱い）", "本アプリでは、記録を海外旅行に絞り込むための基準として「住んでいる国」を設定していただきます。設定した国は自動的に「訪問済み」として扱われ、旅の行き先の候補からは除外されます。住んでいる国は設定画面からいつでも変更でき、変更履歴は旅の記録ページから確認・調整できます。"],
        ["第3条の2（利用料金および広告）", "本アプリの基本機能は無料です。無料版では一部の画面にバナー広告が表示され、新しい国を初めて記録したあとにインタースティシャル広告が表示されることがあります。非消耗型の一回払い商品「広告を削除」を購入すると広告は表示されません。サブスクリプションではありません。購入処理、価格表示、返金その他の取扱いにはAppleの条件が適用されます。通信費は利用者の負担とします。"],
        ["第4条（地図・国境データについて）", "本アプリで表示される国境線や地名は、Natural Earth（パブリックドメインの簡易データ）およびApple MapKitに基づく簡易的な表示であり、いかなる政治的な立場・見解を示すものでもありません。"],
        ["第5条（利用者の責任）", "利用者は、自己の責任において本サービスを利用するものとし、入力する情報について必要な権利を有していることを保証します。"],
        ["第6条（禁止事項）", "利用者は、本サービスを法令に違反する目的、または他者の権利を侵害する目的で利用してはなりません。"],
        ["第7条（知的財産権）", "本サービスおよびこれに含まれるプログラム、デザイン、文章、画像等に関する著作権その他の知的財産権は、運営者または正当な権利者に帰属します。利用者が本アプリ内で作成・保存した記録の権利は、利用者に帰属します。"],
        ["第8条（データの管理とバックアップ）", "本アプリのデータは利用者の端末内にのみ保存されます。書き出し・読み込み機能はなく、機種変更やアプリの削除・再インストールによりデータが失われる場合があります。運営者は失われた記録を復旧できません。"],
        ["第9条（免責事項）", "本サービスは現状有姿で提供され、記録の正確性・完全性・可用性についていかなる保証も行いません。本サービスの利用によって利用者に生じた損害について、運営者の故意または重過失による場合を除き、運営者は責任を負いません。"],
        ["第10条（本サービスの変更・中断・終了）", "運営者は、事前の通知なく本サービスの内容を変更し、または提供を中断・終了することがあります。"],
        ["第11条（本規約の変更）", "本規約は、本アプリの機能追加などに応じて変更されることがあります。変更後の規約は、本アプリ内または本ウェブサイトに掲載された時点から効力を生じます。"],
        ["第12条（準拠法および管轄裁判所）", "本規約の解釈および適用は日本法に準拠します。本サービスに関して運営者と利用者との間で紛争が生じた場合は、東京地方裁判所を第一審の専属的合意管轄裁判所とします。"],
        ["第13条（お問い合わせ）", "本規約に関するお問い合わせは、support@tmkch.io までご連絡ください。"],
      ]
    : [
        ["Article 1 — Application", "These Terms set out the conditions for using the iOS application \"Tripory\" (the \"App\") and this website (together, the \"Service\"), provided by the operator (Tomokichi). This website is the authoritative version; the App refers back to it. You are deemed to have agreed to these Terms once you download the App or otherwise use the Service."],
        ["Article 2 — The Service", "The App provides features, on your own device, for personally managing the countries you have visited and your trip records. No account is required."],
        ["Article 3 — Your home country", "The App asks you to set a \"home country\" as the baseline for narrowing records to international travel. Your home country is automatically treated as \"visited\" and excluded from destination suggestions. You can change it at any time from Settings, and review the change history from the trip records page."],
        ["Article 3-2 — Fees and advertising", "Core features are free. The free version may show banner ads on some screens, and an interstitial after you first log a new country. Buying the non-consumable one-time product “Remove Ads” hides ads. There is no subscription. Apple’s terms govern purchase, price and refunds. You are responsible for data charges."],
        ["Article 4 — Map and border data", "Borders and place names shown in the App are a simplified representation based on the public-domain Natural Earth dataset and Apple MapKit, and do not represent any political position or view."],
        ["Article 5 — User responsibility", "You are responsible for your own use of the Service and warrant that you hold any rights necessary for the information you enter."],
        ["Article 6 — Prohibited conduct", "You must not use the Service for any purpose that violates the law or infringes the rights of others."],
        ["Article 7 — Intellectual property", "Copyright and other intellectual property rights in the Service and the programs, design, text and images it contains belong to the operator or the relevant rights holders. Rights to records you create and store within the App belong to you."],
        ["Article 8 — Data management and backup", "App data is stored only on your device. There is no export or import. Data may be lost when you change phones or delete and reinstall the App; the operator cannot restore it."],
        ["Article 9 — Disclaimer", "The Service is provided \"as is\", without any warranty as to the accuracy, completeness or availability of your records. Except where caused by the operator's willful misconduct or gross negligence, the operator is not liable for damages arising from your use of the Service."],
