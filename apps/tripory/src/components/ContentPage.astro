---
import Shell from "./Shell.astro";
type Locale = "ja" | "en";
type Page = "features" | "principles" | "screenshots" | "faq" | "privacy" | "terms" | "contact";
const { lang, page } = Astro.props as { lang: Locale; page: Page };
const ja = lang === "ja";
const titles: Record<Page, [string, string, string, string]> = {
  features: ["機能紹介", "旅のすべてを、ひとつのアプリに。", "Features", "Everything about your travels, in one app."],
  principles: ["こだわり", "デザインも、体験も、美しく。", "Principles", "Beautiful in both design and experience."],
  screenshots: ["スクリーンショット", "美しい旅の記録体験を。", "Screenshots", "A beautiful way to remember every journey."],
  faq: ["よくある質問", "よくいただくご質問をまとめました。", "Frequently asked questions", "Everything you may want to know."],
  privacy: ["プライバシーポリシー", "最終更新日：2026年7月23日", "Privacy Policy", "Last updated: July 23, 2026"],
  terms: ["利用規約", "最終更新日：2026年7月23日", "Terms of Service", "Last updated: July 23, 2026"],
  contact: ["お問い合わせ", "ご質問やご要望をお聞かせください。", "Contact", "Questions or feedback? We would love to hear from you."],
};
const info = titles[page];
const heading = info[ja ? 0 : 2];
const sub = info[ja ? 1 : 3];
const features = ja
  ? [
      ["◎", "世界地図", "訪れた国や都市を、美しい3Dマップで可視化。あなただけの世界地図が育ちます。", "/assets/world-globe.png"],
      ["▣", "旅の記録", "旅の期間・写真・メモをタイムラインで整理し、いつでも振り返れます。", "/assets/mountain-lake.png"],
      ["♡", "思い出コレクション", "写真やメモで、旅の瞬間を美しいカードとして残します。", "/assets/venice.png"],
      ["◷", "統計", "訪れた国、都市、日数、地域ごとの割合をわかりやすく表示します。", "/assets/iceland.png"],
      ["⌕", "検索と整理", "国名、旅の名前、場所から思い出をすばやく見つけられます。", "/assets/santorini.png"],
    ]
  : [
      ["◎", "World map", "Visualise every country and city on a beautiful 3D map that grows with you.", "/assets/world-globe.png"],
      ["▣", "Travel timeline", "Organise dates, photos and notes chronologically and revisit any trip.", "/assets/mountain-lake.png"],
      ["♡", "Memory collection", "Preserve moments as elegant cards made from photos and notes.", "/assets/venice.png"],
      ["◷", "Statistics", "See countries, cities, days and regions through clear visual insights.", "/assets/iceland.png"],
      ["⌕", "Search and organise", "Find memories quickly by country, trip or location.", "/assets/santorini.png"],
    ];
const principles = ja
  ? [
      ["美しいデザイン", "旅の記録を引き立てる、洗練されたビジュアル。", "/assets/world-globe.png"],
      ["使いやすさ", "直感的な操作で、旅の記録がもっと楽しく。", "/assets/mountain-lake.png"],
      ["プライバシーを大切に", "あなたのデータはあなたのもの。安心して使えます。", "/assets/morocco.png"],
    ]
  : [
      ["Beautiful design", "A refined visual language that lets your memories shine.", "/assets/world-globe.png"],
      ["Effortless to use", "Intuitive interactions make recording every trip a pleasure.", "/assets/mountain-lake.png"],
      ["Privacy first", "Your travel data belongs to you and remains protected.", "/assets/morocco.png"],
    ];
const screens = [["home","Home"],["timeline",ja?"旅の記録":"Timeline"],["country",ja?"国の詳細":"Country"],["memory",ja?"旅の思い出":"Memories"]];
const faqs = ja
  ? [["データはどこに保存されますか？","データは安全に保存され、同期を有効にすると複数端末から利用できます。"],["他のデバイスと同期できますか？","iPhone、iPadなど、お使いの端末間で同期できます。"],["オフラインでも使えますか？","記録の閲覧や編集など、主要な機能はオフラインでも利用できます。"],["写真やメモのバックアップは？","クラウド同期を有効にすることで自動的にバックアップされます。"],["サブスクリプションについて","無料プランに加え、より多くの機能を利用できるプレミアムプランを予定しています。"]]
  : [["Where is my data stored?","Your data is stored securely and can be synchronised across devices."],["Can I sync with other devices?","Yes, you can keep Tripory in sync across your iPhone and iPad."],["Can I use Tripory offline?","Core features including viewing and editing records work offline."],["How are photos and notes backed up?","Enable cloud sync to back up your memories automatically."],["What about subscriptions?","A free plan is available, with a premium plan for additional features."]];
const legal = ja
  ? [["1. はじめに","Triporyは、ユーザーのプライバシーを尊重し、旅の記録や個人情報を適切に保護します。"],["2. 収集する情報","アカウント情報、旅の記録、写真、メモ、利用状況など、サービス提供に必要な情報を取り扱います。"],["3. 利用目的","アプリの提供、同期、改善、お問い合わせ対応、安全性の確保に利用します。"],["4. 禁止事項","法令に違反する行為、サービスの運営を妨害する行為、他者の権利を侵害する行為を禁止します。"]]
  : [["1. Introduction","Tripory respects your privacy and protects your travel records and personal information."],["2. Information we collect","We process account information, travel records, photos, notes and usage information required to provide the service."],["3. How information is used","Information is used to operate, sync and improve Tripory, provide support and keep it secure."],["4. Prohibited conduct","You may not violate laws, interfere with the service or infringe the rights of others."]];
---

<Shell lang={lang} title={heading} page={page}>
  <section class:list={["content-hero", `content-${page}`]}>
    <div><p>TRIPORY</p><h1>{heading}</h1><h2>{sub}</h2></div>
  </section>
  <section class="content-body">
    {page === "features" && <><div class="feature-list">{features.map(([icon,title,body,image]) => <article data-reveal><span>{icon}</span><div><h3>{title}</h3><p>{body}</p></div><img src={image} alt="" /></article>)}</div><a class="dark-cta" href="#download">{ja ? "すべての機能を見る" : "Explore all features"} →</a></>}
    {page === "principles" && <div class="principle-list">{principles.map(([title,body,image],i) => <article data-reveal><div><small>0{i+1}</small><h3>{title}</h3><p>{body}</p></div><img src={image} alt="" /></article>)}</div>}
    {page === "screenshots" && <><div class="screenshot-gallery">{screens.map(([slug,label]) => <figure data-reveal><img src={`/assets/screen-${slug}.png`} alt="" /><figcaption>{label}</figcaption></figure>)}</div><a class="dark-cta" href="#download">{ja ? "すべてのスクリーンショットを見る" : "View all screenshots"} →</a></>}
    {page === "faq" && <div class="faq-list">{faqs.map(([q,a]) => <details data-reveal><summary>{q}<span>＋</span></summary><p>{a}</p></details>)}</div>}
    {(page === "privacy" || page === "terms") && <article class="legal">{legal.map(([title,body]) => <section data-reveal><h3>{title}</h3><p>{body}</p></section>)}</article>}
    {page === "contact" && <form class="contact-form" data-reveal><label>{ja?"お名前":"Name"}<input /></label><label>{ja?"メールアドレス":"Email"}<input type="email" /></label><label>{ja?"お問い合わせ内容":"Message"}<textarea rows="8"></textarea></label><button type="button">{ja?"送信する":"Send message"}</button></form>}
  </section>
</Shell>
