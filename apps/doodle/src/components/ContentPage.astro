---
import { supportUrl } from "@tomokichi/app-site/urls";
import {
  descriptions,
  type Locale,
  type Page,
  pick,
  privacySections,
  suiteApps,
  termsSections,
  titles,
} from "../lib/content";
import AppShell from "./AppShell.astro";
import DoodleBlogPage from "./DoodleBlogPage.astro";
import DoodleUpdatesPage from "./DoodleUpdatesPage.astro";

const { lang, page } = Astro.props as { lang: Locale; page: Page };
const ja = lang === "ja";
const supportHref = supportUrl("doodle", lang);
const title = pick(ja, titles[page]);
const description = pick(ja, descriptions[page]);
const storeLabel = ja ? "App Storeで近日公開" : "Coming soon on the App Store";
const legal = page === "privacy" ? privacySections(ja) : page === "terms" ? termsSections(ja) : [];
const base = ja ? "/ja" : "";

const featureBlocks = ja
  ? [
      {
        mark: "✎",
        title: "手描きの数字と記号",
        body: "ラフな線で数字や演算子、ラベルを描きます。完璧な線は必要ありません。走り書きこそが、Doodleの見た目です。",
      },
      {
        mark: "⌘",
        title: "独立アプリ × 共有キット",
        body: "Timer や Calculator などはそれぞれ独立したアプリです。共通の DoodleKit で描画体験を揃え、App Group でアセットを共有できます。",
      },
      {
        mark: "⏱",
        title: "日常のユーティリティ",
        body: "タイマー、電卓、カウンター、ストップウォッチ、ルーレット、サイコロ、あみだくじ、ビンゴ、時計、コンパス、メトロノーム、歩数計、じゃんけん、スコアボード。",
      },
      {
        mark: "◇",
        title: "ローカルファースト",
        body: "アカウント不要。作業データはアプリごとに端末内へ。手描きアセットもクラウド前提ではなく、同一端末上の共有が基本です。",
      },
      {
        mark: "✦",
        title: "クレヨンのようなアクセント",
        body: "インクの黒線をベースに、コーラル・イエロー・ブルーのアクセントで遊び心を残します。スケッチブックの上に置いた道具のようなUIです。",
      },
      {
        mark: "◎",
        title: "サポートはフォームから",
        body: "お問い合わせは共通サポートフォーム（対象アプリ Doodle）から。メールは support@tmkch.io でも受け付けます。",
      },
    ]
  : [
      {
        mark: "✎",
        title: "Hand-drawn digits & symbols",
        body: "Sketch rough numbers, operators, and labels. Perfect strokes are optional—the scribble is the look.",
      },
      {
        mark: "⌘",
        title: "Independent apps, shared kit",
        body: "Timer, Calculator, and friends ship as separate apps. DoodleKit keeps the drawing experience consistent; an App Group can share assets.",
      },
      {
        mark: "⏱",
        title: "Everyday utilities",
        body: "Timer, Calculator, Counter, Stopwatch, Roulette, Dice, Amidakuji, Bingo, Clock, Compass, Metronome, Pedometer, Rock Paper Scissors, Scoreboard.",
      },
      {
        mark: "◇",
        title: "Local-first",
        body: "No account. Working data stays on-device per app. Shared doodles stay on the same device—no cloud baseline.",
      },
      {
        mark: "✦",
        title: "Crayon accents",
        body: "Ink-black lines on sketchbook paper, with coral, yellow, and blue accents. UI that feels like tools on a notebook page.",
      },
      {
        mark: "◎",
        title: "Support via form",
        body: "Contact through the shared support form (app: Doodle). Email support@tmkch.io is also available.",
      },
    ];

const howSteps = ja
  ? [
      {
        n: "1",
        title: "数字や記号を描く",
        body: "紙に書くように、数字・演算子・ラベルをラフにスケッチします。線が少し曲がっていても問題ありません。",
        note: "シリーズ内で共有できるアセットとして保存される場合があります。",
      },
      {
        n: "2",
        title: "使いたいアプリを開く",
        body: "Timer でカウントダウン、Calculator で計算、Dice でサイコロ——目的に合わせて独立アプリを起動します。",
        note: "各アプリは単体でも動きます。全部入れる必要はありません。",
      },
      {
        n: "3",
        title: "手描きUIで操作する",
        body: "描いた線が画面上の数字や記号になります。見た目だけでなく、読む・押す・回す対象そのものです。",
        note: "アセットは同一端末上の App Group 経由で他アプリから参照できる場合があります。",
      },
      {
        n: "4",
        title: "端末内に残す",
        body: "作業データは各アプリがローカルに保持します。アカウント登録やクラウド同期は前提にしません。",
        note: "機種変更時は、各アプリの案内と端末バックアップの方針に従ってください。",
      },
    ]
  : [
      {
        n: "1",
        title: "Draw digits and symbols",
        body: "Sketch numbers, operators, and labels as you would on paper. Wobbly lines are welcome.",
        note: "Assets may be stored so other apps in the series can reuse them.",
      },
      {
        n: "2",
        title: "Open the utility you need",
        body: "Countdown in Timer, compute in Calculator, roll in Dice—launch the independent app that fits the moment.",
        note: "Each app works on its own. You do not need every title installed.",
      },
      {
        n: "3",
        title: "Work with the ink",
        body: "Your strokes become the on-screen digits and symbols you read, tap, and spin.",
        note: "Assets may be available to other series apps on the same device via the App Group.",
      },
      {
        n: "4",
        title: "Keep it on-device",
        body: "Working data stays local per app. No account or cloud sync is assumed.",
        note: "When changing phones, follow each app’s guidance and your device backup habits.",
      },
    ];

const conceptShots = ja
  ? [
      { id: "timer", label: "Timer", caption: "手書き数字のカウントダウン" },
      { id: "calc", label: "Calculator", caption: "落書きの演算子" },
      { id: "dice", label: "Dice", caption: "インクの目" },
      { id: "roulette", label: "Roulette", caption: "ラベルも手描き" },
      { id: "bingo", label: "Bingo", caption: "スケッチのマス" },
      { id: "score", label: "Scoreboard", caption: "走り書きの得点" },
    ]
  : [
      { id: "timer", label: "Timer", caption: "Countdown in drawn digits" },
      { id: "calc", label: "Calculator", caption: "Operators as doodles" },
      { id: "dice", label: "Dice", caption: "Ink-dotted faces" },
      { id: "roulette", label: "Roulette", caption: "Hand-labelled wedges" },
      { id: "bingo", label: "Bingo", caption: "Sketched grid" },
      { id: "score", label: "Scoreboard", caption: "Rough score marks" },
    ];

const faqs = ja
  ? [
      ["base", "Doodleとは何ですか？", "手書きの数字と記号をユーティリティに使う、独立したiOSアプリのシリーズです。共通の描画基盤 DoodleKit と、同一端末上の App Group 共有を使います。"],
      ["base", "ひとつのアプリですか？", "いいえ。Timer や Calculator など、用途ごとの独立アプリがシリーズとして並びます。"],
      ["base", "無料ですか？", "はい。ダウンロードと基本機能の利用は無料を基本とします。現時点で広告表示は主張していません。"],
      ["base", "アカウントは必要ですか？", "いいえ。"],
      ["base", "対応環境は？", "iPhone・iOS 26以降向けです。"],
      ["base", "App Storeで公開されていますか？", "現在公開準備中です。配信が始まったら、このサイトからもご案内します。"],
      ["draw", "何を描きますか？", "数字、演算子、ラベル、サイコロの目など、各アプリが使う記号を手描きします。"],
      ["draw", "きれいな字でなくても大丈夫ですか？", "はい。ラフな線がシリーズの世界観です。"],
      ["draw", "描いたものは他のアプリでも使えますか？", "同一端末上では、App Group「group.io.tmkch.doodle」を通じてシリーズアプリ間で共有できる場合があります。"],
      ["data", "データはどこに保存されますか？", "作業データは各アプリが端末内に保存します（local-first）。"],
      ["data", "クラウド同期はありますか？", "Doodle 独自のクラウド同期を前提にしていません。"],
      ["data", "運営者は落書きを見ますか？", "通常利用では手描きアセットや作業データを運営者のサーバーへ送りません。お問い合わせ時も自動添付されません。"],
      ["data", "アプリを削除するとどうなりますか？", "そのアプリの端末内データは削除されます。App Group の共有アセットは、他のシリーズアプリが残っている場合に残ることがあります。"],
      ["support", "問い合わせ先は？", "共通サポートフォームで対象アプリに Doodle を選び送信するか、support@tmkch.io へご連絡ください。"],
    ]
  : [
      ["base", "What is Doodle?", "A series of independent iOS utilities that use hand-drawn digits and symbols, sharing drawing foundations via DoodleKit and on-device App Group assets."],
      ["base", "Is it a single app?", "No. Titles like Timer and Calculator ship as separate apps in one series."],
      ["base", "Is it free?", "Yes. Download and core use are free as a baseline. This site does not claim advertising at present."],
      ["base", "Do I need an account?", "No."],
      ["base", "What devices are supported?", "iPhone on iOS 26 or later."],
      ["base", "Is it on the App Store?", "Not yet—we are preparing for release. We will announce availability here when shipping begins."],
      ["draw", "What do I draw?", "Digits, operators, labels, dice pips, and other symbols each app uses."],
      ["draw", "Do the drawings need to look perfect?", "No. Rough lines are the point of the series."],
      ["draw", "Can other apps use what I drew?", "On the same device, series apps may share assets through App Group “group.io.tmkch.doodle”."],
      ["data", "Where is data stored?", "Working data stays on-device, local-first per app."],
      ["data", "Is there cloud sync?", "Doodle does not assume its own cloud sync."],
      ["data", "Can the operator see my doodles?", "Ordinary use does not send doodle assets or working data to the Operator’s servers. Support messages never attach them automatically."],
      ["data", "What if I delete an app?", "That app’s on-device data is removed. Shared App Group assets may remain if other series apps still use the group."],
      ["support", "How do I contact you?", "Use the shared support form with Doodle selected, or email support@tmkch.io."],
    ];

const faqCats = ja
  ? [
      ["all", "すべて"],
      ["base", "基本"],
      ["draw", "描画・共有"],
      ["data", "データ"],
      ["support", "サポート"],
    ]
  : [
      ["all", "All"],
      ["base", "Basics"],
      ["draw", "Drawing & sharing"],
      ["data", "Data"],
      ["support", "Support"],
    ];

const newsPosts = ja
  ? [
      {
        id: "site-launch",
        date: "2026.08.08",
        datetime: "2026-08-08",
        badge: "お知らせ",
        title: "Doodle公式ブランドサイトを公開しました",
        summary: "手描きユーティリティのシリーズ構想、機能、使い方、FAQ、プライバシーを掲載しています。",
        body: [
          "Doodleシリーズの公式ブランドサイトを公開しました。手書きの数字と記号をユーティリティに使うという世界観と、Timer や Calculator をはじめとするアプリ群の位置づけを、App Store公開準備中の段階からお伝えします。",
          "現時点ではApp Storeへのリンクはありません。配信の準備が整い次第、サイトからもご案内します。",
          "データはアプリごとに端末内へ保存し、手描きアセットは App Group「group.io.tmkch.doodle」で同一端末上のシリーズ間共有を想定しています。詳細はプライバシーポリシーと利用規約をご確認ください。",
        ],
      },
      {
        id: "column-sketch",
        date: "2026.08.08",
        datetime: "2026-08-08",
        badge: "コラム",
        badgeTone: "column" as const,
        title: "完璧な線より、走り書きの数字",
        summary: "ラフな線が、そのまま道具の見た目と操作感になる。",
        body: [
          "Doodleは、きれいなフォントに置き換えるためのアプリではありません。紙に書いたような数字と記号が、タイマーや電卓のUIそのものになります。",
          "シリーズは独立アプリの集合ですが、DoodleKit と App Group で「書いたもの」を共有できるので、一度描いた線を複数の道具で楽しめます。",
        ],
      },
      {
        id: "prep-note",
        date: "2026.08.08",
        datetime: "2026-08-08",
        badge: "準備中",
        badgeTone: "note" as const,
        title: "App Store公開に向けて",
        summary: "iPhone・iOS 26以降向け。現在公開準備中です。",
        body: [
          "Doodleシリーズは現在App Store公開準備中です。対応環境や価格の最終表示は、公開時のApp Store上の記載が正しいものとします。",
        ],
      },
    ]
  : [
      {
        id: "site-launch",
        date: "2026.08.08",
        datetime: "2026-08-08",
        badge: "Update",
        title: "The official Doodle brand site is now live",
        summary: "Series concept, features, how-to, FAQ, and privacy—while we prepare for the App Store.",
        body: [
          "The official Doodle Series brand site is live. It explains the idea of hand-drawn digits and symbols as everyday utilities, and where apps like Timer and Calculator fit—while release is still in preparation.",
          "There is no App Store link yet. When distribution is ready, we will share it here as well.",
          "Working data stays on-device per app; doodle assets are intended for on-device sharing via App Group “group.io.tmkch.doodle”. See the Privacy Policy and Terms for details.",
        ],
      },
      {
        id: "column-sketch",
        date: "2026.08.08",
        datetime: "2026-08-08",
        badge: "Column",
        badgeTone: "column" as const,
        title: "Rough digits over perfect fonts",
        summary: "Wobbly lines become both the look and the controls.",
        body: [
          "Doodle is not about swapping in a pretty typeface. Numbers and symbols that feel paper-drawn are the UI of timers, calculators, and more.",
          "Apps stay independent, but DoodleKit and an App Group let one set of strokes travel across tools on the same device.",
        ],
      },
      {
        id: "prep-note",
        date: "2026.08.08",
        datetime: "2026-08-08",
        badge: "Coming soon",
        badgeTone: "note" as const,
        title: "Preparing for the App Store",
        summary: "Designed for iPhone on iOS 26+.",
        body: [
          "The Doodle Series is being prepared for the App Store. The listing will be the source of truth for requirements and pricing when it ships.",
        ],
      },
    ];
---

<AppShell lang={lang} title={title} page={page} description={description}>
  <section class:list={["content-page", `content-${page}`]}>
    {page !== "news" && page !== "updates" && (
      <header class="content-hero">
        <p class="content-eyebrow">{page.toUpperCase()}</p>
        <h1>{title}</h1>
        {(page === "privacy" || page === "terms") && (
          <div class="legal-dates">
            <p>{ja ? "制定日：2026年8月8日" : "Effective date: August 8, 2026"}</p>
            <p>{ja ? "最終更新日：2026年8月8日" : "Last updated: August 8, 2026"}</p>
          </div>
        )}
      </header>
    )}

    {page === "features" && (
      <div class="feature-page">
        <p class="page-lead">
          {ja
            ? "手描きの線を、日常の道具に。Doodleシリーズでできることをまとめました。"
            : "Turn hand-drawn strokes into everyday tools. Here is what the Doodle Series is built for."}
        </p>
        <div class="feature-grid">
          {featureBlocks.map((block) => (
            <article>
              <span class="feature-mark" aria-hidden="true">{block.mark}</span>
              <h2>{block.title}</h2>
              <p>{block.body}</p>
            </article>
          ))}
        </div>
        <div class="suite-inline">
          <h2>{ja ? "シリーズのアプリ" : "Apps in the series"}</h2>
          <ul>
            {suiteApps.map((app) => (
              <li>
                <span aria-hidden="true">{app.mark}</span>
                <strong>{ja ? app.nameJa : app.nameEn}</strong>
                <span>{ja ? app.blurbJa : app.blurbEn}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

    {page === "how-to" && (
      <div class="how-page">
        <p class="page-lead">
          {ja
            ? "描いて、開いて、使う。はじめての流れを4ステップで。"
            : "Draw, open, use. A four-step first run through the series."}
        </p>
        <ol class="how-list">
          {howSteps.map((step) => (
            <li>
              <span class="how-n" aria-hidden="true">{step.n}</span>
              <div>
                <h2>{step.title}</h2>
                <p>{step.body}</p>
                <aside>{step.note}</aside>
              </div>
            </li>
          ))}
        </ol>
        <p class="section-more">
          <a href={`${base}/faq`}>{ja ? "よくある質問を見る" : "Read the FAQ"} →</a>
        </p>
      </div>
    )}

    {page === "screenshots" && (
      <div class="concept-page">
        <p class="page-lead">
          {ja
            ? "実機キャプチャ公開前のコンセプトビジュアルです。スケッチブック上の手描きUIの雰囲気を、イラストで伝えています。"
            : "Concept doodle visuals before real product captures ship. They sketch the hand-drawn UI on notebook paper."}
        </p>
        <div class="concept-grid">
          {conceptShots.map((shot) => (
            <figure class:list={["concept-card", `concept-${shot.id}`]}>
              <div class="concept-frame" aria-hidden="true">
                <div class="concept-screen">
                  <span class="concept-glyph">{shot.label.slice(0, 1)}</span>
                  <span class="concept-lines"></span>
                  <span class="concept-lines short"></span>
                </div>
              </div>
              <figcaption>
                <strong>{shot.label}</strong>
                <span>{shot.caption}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="concept-disclaimer">
          {ja
            ? "※ これらは雰囲気を伝えるためのコンセプト表現であり、App Store提出用の実機スクリーンショットではありません。"
            : "These are concept illustrations for mood and layout—not App Store product screenshots."}
        </p>
      </div>
    )}

    {page === "faq" && (
      <div class="faq-page">
        <p class="page-lead">
          {ja
            ? "カテゴリを選び、質問をタップしてください。見つからない場合はお問い合わせください。"
            : "Pick a topic, then tap a question. If it is not here, contact us."}
        </p>
        <nav class="faq-tabs" data-faq-tabs aria-label={ja ? "カテゴリ" : "Categories"}>
          {faqCats.map(([key, label], i) => (
            <button type="button" data-cat={key} aria-current={i === 0 ? "true" : "false"}>{label}</button>
          ))}
        </nav>
        <div class="faq-list" data-faq-list>
          {faqs.map(([cat, q, a], i) => (
            <details data-cat={cat} open={i === 0}>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
        <aside class="faq-contact">
          <h2>{ja ? "解決しない場合" : "Still need help?"}</h2>
          <p>{ja ? "共通サポートフォームからご連絡ください。" : "Reach us through the shared support form."}</p>
          <a href={supportHref} target="_blank" rel="noopener noreferrer">{ja ? "お問い合わせ" : "Contact"} →</a>
        </aside>
      </div>
    )}

    {page === "news" && <DoodleBlogPage lang={lang} />}
    {page === "updates" && <DoodleUpdatesPage lang={lang} />}

    {(page === "privacy" || page === "terms") && (
      <article class="legal-copy">
        {legal.map(([heading, body]) => (
          <section>
            <h2>{heading}</h2>
            {body.split("\n\n").map((para) => (
              <p>{para.split("\n").map((line) => <>{line}<br /></>)}</p>
            ))}
          </section>
        ))}
      </article>
    )}

    {(page === "features" || page === "how-to" || page === "screenshots") && (
      <div class="content-cta">
        <span class="store-button store-soon" aria-disabled="true">
          <span class="store-dot" aria-hidden="true"></span>
          {storeLabel}
        </span>
      </div>
    )}
  </section>
</AppShell>

<script is:inline>
  (() => {
    const bindFaq = () => {
      const tabs = document.querySelector("[data-faq-tabs]");
      const list = document.querySelector("[data-faq-list]");
      if (!tabs || !list || tabs.dataset.bound === "1") return;
      tabs.dataset.bound = "1";
      const items = Array.from(list.querySelectorAll("details"));
      tabs.addEventListener("click", (e) => {
        const btn = e.target.closest("button[data-cat]");
        if (!btn) return;
        const cat = btn.getAttribute("data-cat");
        items.forEach((item) => {
          item.hidden = !(cat === "all" || item.getAttribute("data-cat") === cat);
        });
        tabs.querySelectorAll("button").forEach((b) => {
          b.setAttribute("aria-current", String(b.getAttribute("data-cat") === cat));
        });
      });
    };
    document.addEventListener("astro:page-load", bindFaq);
    bindFaq();
  })();
</script>
