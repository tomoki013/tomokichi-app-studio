---
import ContentPage from "../components/ContentPage.astro";
import "../styles/global.css";

export function getStaticPaths() {
  return ["features", "how-to", "concept", "faq", "privacy", "terms", "news", "updates"].map((page) => ({
    params: { page },
  }));
}
const { page } = Astro.params as {
  page: "features" | "how-to" | "concept" | "faq" | "privacy" | "terms" | "news" | "updates";
};
---
<ContentPage lang="en" page={page} />
