---
interface Props {
  youtubeId: string;
  title: string;
}

const { youtubeId, title } = Astro.props;
const embedUrl = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeId)}?rel=0`;
const watchUrl = `https://youtu.be/${encodeURIComponent(youtubeId)}`;
---

<section class="section" aria-labelledby="screen-recording-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Screen recording</p>
      <h2 id="screen-recording-heading">Review walkthrough</h2>
    </div>
    <a class="text-link" href={watchUrl} target="_blank" rel="noreferrer">Open on YouTube ↗</a>
  </div>

  <div class="video-frame">
    <iframe
      src={embedUrl}
      title={title}
      loading="eager"
      referrerpolicy="strict-origin-when-cross-origin"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
</section>
