---
import "./app-site-shell.css";

const { lang, date, news, newsHref } = Astro.props as {
  lang: "ja" | "en";
  date: string;
  news: string;
  newsHref: string;
};
const displayDate = date.replaceAll("-", ".");
---

<a class="app-hero-scroll" href="#notice"><em>Scroll</em><span class="app-hero-scroll-track"><i></i></span></a>
<aside class="app-hero-notice" id="notice">
  <strong>{lang === "ja" ? "お知らせ" : "Updates"}</strong>
  <time datetime={date}>{displayDate}</time>
  <span>{news}</span>
  <a href={newsHref} aria-label={lang === "ja" ? "お知らせを見る" : "View news"}>→</a>
</aside>
