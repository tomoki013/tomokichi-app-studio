---
/**
 * The shared news-article detail page — what `NewsFeed`'s "読む / Read on"
 * link points to. Content-only, like `NewsFeed`: each app wraps this in its
 * own `<AppShell>` from a `/news/[slug]` route, the same way it embeds
 * `NewsFeed` for the listing.
 */
import "./news-feed.css";
import "./news-article.css";
import type { NewsPost } from "./NewsFeed.astro";

const { post, lang = "en", backHref } = Astro.props as {
  post: NewsPost;
  lang?: "ja" | "en";
  backHref: string;
};

const ja = lang === "ja";
---

<article class="app-news-article">
  <a class="app-news-article-back" href={backHref}>
    <span aria-hidden="true">←</span>{ja ? "ニュース一覧へ" : "Back to news"}
  </a>
  <header class="app-news-article-header">
    <span class="app-news-article-meta">
      <span class:list={["app-news-badge", post.badgeTone && `is-${post.badgeTone}`]}>{post.badge}</span>
      <time datetime={post.datetime}>{post.date}</time>
    </span>
    <h1>{post.title}</h1>
    <p>{post.summary}</p>
  </header>
  <div class="app-news-article-body">
    {post.body.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</article>
