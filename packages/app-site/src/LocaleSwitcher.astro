---
import type { AppSiteLocaleLink } from "./i18n";
import "./locale-switcher.css";

const {
  lang,
  locales,
  label = "Language",
  placement = "header",
} = Astro.props as {
  lang: string;
  locales: AppSiteLocaleLink[];
  label?: string;
  placement?: "header" | "mobile" | "footer";
};

const current = locales.find((locale) => locale.code === lang) ?? locales[0];
const menuId = `app-site-language-${placement}-${lang.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
---

<details class:list={["app-site-language-switcher", `is-${placement}`]} data-language-switcher>
  <summary aria-label={label} aria-controls={menuId}>
    <span class="app-site-language-current">{current?.shortLabel ?? lang.toUpperCase()}</span>
    <svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true"><path d="m1 1.25 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg>
  </summary>
  <nav id={menuId} aria-label={label}>
    {locales.map((locale) => (
      <a
        class:list={{ active: locale.code === lang }}
        href={locale.href}
        hreflang={locale.code}
        lang={locale.code}
        aria-current={locale.code === lang ? "page" : undefined}
        data-astro-prefetch
      >
        <span>{locale.label}</span>
        <small>{locale.shortLabel}</small>
      </a>
    ))}
  </nav>
</details>
