---
import AppHeroChrome from "@tomokichi/app-site/AppHeroChrome.astro";
import { i18n, type Locale } from "../i18n";
import AppShell from "./AppShell.astro";

const { lang } = Astro.props as { lang: Locale };
const c = i18n.t(lang);
---

<AppShell lang={lang} title={c.landing.title}>
  <section class="app-landing-hero">
    <div>
      <p class="eyebrow">__APP_BRAND__</p>
      <h1>{c.landing.value}</h1>
      <p>{c.landing.body}</p>
      <a class="store-button" href="#download">{c.landing.download}</a>
    </div>
    <div class="product-visual" role="img" aria-label={c.landing.screenAlt}></div>
    <AppHeroChrome
      lang={lang}
      date="__APP_DATE__"
      news={c.landing.news}
      newsHref={i18n.href(lang, "updates")}
    />
  </section>
  <section class="app-landing-content" id="download" data-reveal>
    <h2>{c.landing.about}</h2>
    <p>{c.landing.aboutBody}</p>
  </section>
</AppShell>
