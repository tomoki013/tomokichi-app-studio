---
import AppHeroChrome from "@tomokichi/app-site/AppHeroChrome.astro";
import AppShell from "./AppShell.astro";

const { lang } = Astro.props as { lang: "ja" | "en" };
const ja = lang === "ja";
const base = ja ? "/ja" : "";
---

<AppShell lang={lang} title={ja ? "__APP_BRAND__へようこそ" : "Welcome to __APP_BRAND__"}>
  <section class="app-landing-hero">
    <div>
      <p class="eyebrow">__APP_BRAND__</p>
      <h1>{ja ? "アプリの価値を一文で伝えます。" : "Describe the app’s value in one sentence."}</h1>
      <p>{ja ? "ここにプロダクト固有の説明を入力してください。" : "Add the product-specific supporting copy here."}</p>
      <a class="store-button" href="#download">{ja ? "App Storeからダウンロード" : "Download on the App Store"}</a>
    </div>
    <div class="product-visual" role="img" aria-label={ja ? "アプリ画面のプレースホルダー" : "App screen placeholder"}></div>
    <AppHeroChrome
      lang={lang}
      date="__APP_DATE__"
      news={ja ? "__APP_BRAND__サイトを公開しました。" : "The __APP_BRAND__ website is now available."}
      newsHref={`${base}/updates`}
    />
  </section>
  <section class="app-landing-content" id="download" data-reveal>
    <h2>{ja ? "__APP_BRAND__について" : "About __APP_BRAND__"}</h2>
    <p>{ja ? "機能や使い方など、アプリ固有のランディングページをここから構築してください。" : "Build the product-specific landing page from this shared foundation."}</p>
  </section>
</AppShell>
