---
import { i18n, type Locale } from "../i18n";
import AppShell from "./AppShell.astro";

const { lang, page } = Astro.props as { lang: Locale; page: string };
const c = i18n.t(lang);
const title = c.content.titles[page] ?? page;
---

<AppShell lang={lang} title={title} page={page}>
  <article class="content-page">
    <p class="eyebrow">__APP_BRAND__</p>
    <h1>{title}</h1>
    <p>{c.content.placeholder}</p>
  </article>
</AppShell>
