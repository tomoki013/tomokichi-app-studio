---
import AppSiteShell from "@tomokichi/app-site/AppSiteShell.astro";
import { appSiteUrl, mainSiteUrl, supportUrl } from "@tomokichi/app-site/urls";
import { i18n, type Locale } from "../i18n";

const { lang, title, page = "", description } = Astro.props as {
  lang: Locale;
  title: string;
  page?: string;
  description?: string;
};
const c = i18n.t(lang);
const href = (slug: string) => i18n.href(lang, slug);
const supportHref = supportUrl("__APP_SLUG__", lang);
const nav = [
  { slug: "features", label: c.nav.features, href: href("features") },
  { slug: "how-to", label: c.nav.howTo, href: href("how-to") },
  { slug: "faq", label: c.nav.faq, href: href("faq") },
  { slug: "updates", label: c.nav.updates, href: href("updates") },
];
const footerColumns = [
  {
    title: c.footer.product,
    links: [
      { label: c.nav.features, href: href("features") },
      { label: c.nav.howTo, href: href("how-to") },
      { label: c.footer.screenshots, href: href("screenshots") },
    ],
  },
  {
    title: c.footer.support,
    links: [
      { label: c.nav.faq, href: href("faq") },
      { label: c.nav.updates, href: href("updates") },
      { label: c.footer.contact, href: supportHref, external: true },
    ],
  },
  {
    title: c.footer.legal,
    links: [
      { label: c.footer.privacy, href: href("privacy") },
      { label: c.footer.terms, href: href("terms") },
      { label: c.footer.commercialTransactions, href: href("commercial-transactions") },
    ],
  },
  {
    title: "Tomokichi",
    links: [
      { label: "Tomokichi", href: mainSiteUrl(lang), external: true },
      { label: c.footer.otherApps, href: mainSiteUrl(lang, "/apps"), external: true },
    ],
  },
];
---

<AppSiteShell
  lang={lang}
  title={title}
  description={description ?? c.meta.description}
  page={page}
  brand="__APP_BRAND__"
  tagline={c.meta.tagline}
  siteUrl={appSiteUrl("__APP_SLUG__")}
  homeHref={i18n.href(lang)}
  localeLinks={i18n.localeLinks(page)}
  defaultLocale={i18n.defaultLocale}
  shellLabels={c.shell}
  nav={nav}
  footerColumns={footerColumns}
  appStoreLabel={c.meta.appStore}
  menuLabel={c.shell.menu}
  menuCloseLabel={c.shell.menuClose}
  pageClass="__APP_SLUG__-page"
>
  <slot />
</AppSiteShell>
